{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electronic-structure-learning.invalid/schemas/derived-dft-data.schema.json",
  "title": "Electronic Structure Learning Derived DFT Dataset",
  "type": "object",
  "required": [
    "schemaVersion",
    "datasetId",
    "observable",
    "provenance",
    "parameters",
    "units",
    "data",
    "boundaries"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "datasetId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "observable": {
      "type": "string",
      "enum": [
        "structure",
        "bands",
        "dos",
        "phonon",
        "convergence",
        "charge-density",
        "other"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "code",
        "codeVersion",
        "sourceLocation",
        "sourceCommit",
        "generatedAt",
        "transformation"
      ],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "codeVersion": { "type": "string", "minLength": 1 },
        "sourceLocation": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": ["string", "null"] },
        "generatedAt": { "type": "string", "format": "date-time" },
        "transformation": { "type": "string", "minLength": 1 },
        "license": { "type": ["string", "null"] },
        "checksums": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]+$"
          }
        }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "description": "Only parameters required to interpret this derived observable.",
      "additionalProperties": true
    },
    "units": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "references": {
      "type": "object",
      "properties": {
        "energyZero": { "type": ["string", "null"] },
        "normalization": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
