{
  "name": "electronic-structure-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive electronic-structure and DFT learning website",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "validate": "npm run validate:content && npm run validate:data",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.4",
    "@astrojs/starlight": "0.41.4",
    "astro": "7.1.4",
    "katex": "0.18.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  }
}
