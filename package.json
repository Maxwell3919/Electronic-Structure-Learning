{
  "name": "electronic-structure-atlas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A minimal, static atlas for electronic-structure theory, methods, tools, and references.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/write-deployment-manifest.mjs",
    "preview": "astro preview",
    "serve:literature": "node services/literature-runtime-server.mjs",
    "audit:literature-preprocessing": "node scripts/audit-literature-preprocessing.mjs",
    "audit:literature-preprocessing:records": "node scripts/audit-literature-preprocessing.mjs --require-records",
    "audit:source-visuals": "node scripts/audit-source-visuals.mjs",
    "validate:clean-slate": "node scripts/validate-clean-slate.mjs --source",
    "validate:build-budget": "node scripts/validate-build-budget.mjs",
    "check": "astro check && npm run audit:literature-preprocessing && npm run validate:clean-slate && astro build && npm run validate:build-budget && node scripts/validate-clean-slate.mjs --built && npm run audit:source-visuals"
  },
  "dependencies": {
    "@embedpdf/snippet": "2.15.0",
    "astro": "7.1.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
