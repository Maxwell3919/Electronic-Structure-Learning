{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electronic-structure-atlas.local/schemas/research-path.schema.json",
  "title": "Electronic Structure Atlas research paths",
  "type": "object",
  "required": ["schema_version", "paths"],
  "properties": {
    "schema_version": { "const": 1 },
    "paths": {
      "type": "array",
      "minItems": 10,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["id", "question", "establishes", "concept_ids", "synthesis_ids", "gates", "claim_boundary"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "question": { "type": "string", "minLength": 12 },
          "establishes": { "type": "string", "minLength": 20 },
          "concept_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "synthesis_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "gates": { "type": "array", "minItems": 3 },
          "claim_boundary": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
