---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { normalizedReferenceCount, normalizedReferenceGroups } from '../../reference/normalized-works';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const href = (route: string) => `${base}${route.replace(/^\//, '')}`;

const ecosystemGroups = [
  {
    title: 'Pseudopotential and verification resources',
    entries: [
      { title: 'SSSP', url: 'https://sssp.materialscloud.org/', whyUse: 'Use a named release for documented pseudopotential precision and efficiency tests.', boundary: 'Covered benchmarks do not replace system- and observable-specific validation.' },
      { title: 'PseudoDojo', url: 'https://www.pseudo-dojo.org/', whyUse: 'Use a named table for generated and tested norm-conserving pseudopotentials.', boundary: 'Functional, relativistic treatment, transferability, and target observable remain separate choices.' },
    ],
  },
  {
    title: 'Courses and learning resources',
    entries: [
      { title: 'Materials Cloud Learn', url: 'https://www.materialscloud.org/learn', whyUse: 'Use a dated school for a coherent computational-materials learning route.', boundary: 'Software version, exercise files, access terms, and licence are school-specific.' },
      { title: 'MolSSI Education', url: 'https://education.molssi.org/', whyUse: 'Use its open lessons for molecular-science programming and modelling foundations.', boundary: 'Each lesson has its own repository, licence, date, and scientific scope.' },
    ],
  },
  {
    title: 'Reproducibility and stewardship',
    entries: [
      { title: 'FAIR Principles', url: 'https://www.go-fair.org/fair-principles/', whyUse: 'Use them to design findable, accessible, interoperable, and reusable digital objects.', boundary: 'FAIR metadata and access do not establish that data or conclusions are correct.' },
      { title: 'Materials Cloud Archive', url: 'https://archive.materialscloud.org/', whyUse: 'Use a specific DOI-addressable record for dated files, metadata, and licence information.', boundary: 'Repository presence does not establish completeness or suitability for a later claim.' },
    ],
  },
];
---

<BaseLayout title="Reference" description="Normalized sources, verification resources, and stewardship guidance for the Atlas." current="reference">
  <h1>Reference</h1>
  <p class="lede">This page materializes the current normalized source classification. A published/preprint family appears once, supplementary information stays attached to its parent work, and deferred or excluded material is not presented as an active source.</p>
  <p class="paper-meta">{normalizedReferenceCount} normalized works are listed: 66 current <em>reference-only</em> works plus the eight sources with published Guided Reading. Each entry states a use and a boundary rather than becoming a miniature Guide.</p>

  {normalizedReferenceGroups.map((group) => (
    <section aria-labelledby={group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
      <h2 id={group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>{group.title} <span class="secondary">· {group.entries.length}</span></h2>
      <dl class="reference-list">
        {group.entries.map((entry) => (
          <>
            <dt><a href={entry.url}>{entry.title}</a> <span>· {entry.authors}, {entry.year}</span></dt>
            <dd>{entry.whyUse} <strong>Boundary.</strong> {entry.boundary} {entry.guideHref && <a href={href(entry.guideHref)}>Read the Guide →</a>}</dd>
          </>
        ))}
      </dl>
    </section>
  ))}

  {ecosystemGroups.map((group) => (
    <section aria-labelledby={group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
      <h2 id={group.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>{group.title} <span class="secondary">· {group.entries.length}</span></h2>
      <dl class="reference-list">
        {group.entries.map((entry) => (
          <><dt><a href={entry.url}>{entry.title}</a></dt><dd>{entry.whyUse} <strong>Boundary.</strong> {entry.boundary}</dd></>
        ))}
      </dl>
    </section>
  ))}
</BaseLayout>
