---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const href = (route: string) => `${base}${route.replace(/^\//, '')}`;
---

<BaseLayout title="Home" description="A concise map of the physical and conceptual structure of electronic-structure research." current="home">
  <section class="cow-cat-stage" aria-hidden="true">
    <svg class="cow-cat-art" viewBox="0 0 1200 800" focusable="false">
      <g class="cow-cat-tail">
        <path d="M820 586 C1050 620 1080 390 937 383 C860 380 852 460 917 474" fill="none" stroke="#171717" stroke-width="74" stroke-linecap="round" />
        <path d="M1018 538 C1084 470 1055 399 974 389" fill="none" stroke="#fff" stroke-width="28" stroke-linecap="round" />
      </g>
      <ellipse cx="600" cy="735" rx="350" ry="27" fill="#ecebea" />
      <path d="M352 705 C330 576 353 468 430 406 C481 365 531 349 600 349 C704 349 788 392 833 476 C866 538 865 624 844 705 Z" fill="#fff" stroke="#171717" stroke-width="8" />
