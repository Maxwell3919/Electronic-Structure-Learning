        <path d="M752 221 L797 178 C805 207 809 237 808 266 C792 246 773 231 752 221 Z" fill="#d9b1ac" />
      </g>
      <path d="M455 312 C475 246 524 211 589 207 C578 279 541 326 482 349 Z" fill="#171717" />
      <path d="M656 211 C733 214 791 257 807 331 C760 348 717 334 685 300 C666 279 656 250 656 211 Z" fill="#171717" />
