---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const href = (route: string) => `${base}${route.replace(/^\//, '')}`;
---

<BaseLayout title="Home" description="A concise map of the physical and conceptual structure of electronic-structure research." current="home">
  <h1>Electronic Structure Atlas</h1>
  <p class="lede">Understand the physical and conceptual structure of electronic-structure research.</p>
  <p><strong>Research path.</strong> Scientific question → target observable → physical model → electronic-structure theory → computational method → numerical representation → calculation → validated observable → scientific interpretation.</p>
  <ul class="section-list">
    <li><a href={href('/theory/')}>Foundations</a> — repair or connect concepts.</li>
    <li><a href={href('/reading/')}>Guided Reading</a> — follow a continuous source.</li>
    <li><a href={href('/methods/')}>Methods</a> — understand solution strategies and their limits.</li>
    <li><a href={href('/computational-tools/')}>Computational Tools</a> — identify implementations of those strategies.</li>
    <li><a href={href('/reference/')}>Reference</a> — find authoritative sources for a specific question.</li>
    <li><a href="https://maxwell3919.github.io/DFT-Research-Workflow/">DFT Research Workflow</a> — execute, converge, validate, interpret, and preserve a calculation.</li>
  </ul>
</BaseLayout>
