---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BookCover from '../../../reading/BookCover.astro';
import { bookProfiles } from '../../../reading/book-profiles';
import { bookCovers } from '../../../reading/book-covers';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const href = (route: string) => `${base}${route.replace(/^\//, '')}`;
const featuredBooks = Object.values(bookProfiles);
---

<BaseLayout
  title="Books · Guided Reading"
  description="Source-aligned reading guides for important electronic-structure books."
  current="reading"
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={href('/reading/')}>Guided Reading</a>
    <span aria-hidden="true">/</span>
    <span>Books</span>
  </nav>

  <h1>Books</h1>
  <p class="lede">
    Book guides preserve a source’s reasoning order while shortening secondary detail, clarifying decisive equations, and connecting the material to present electronic-structure research.
  </p>
  <p>
    Each route remains tied to its own source. The Atlas does not combine several books into one artificial chapter sequence, and a book guide does not replace the prerequisite map in <a href={href('/theory/')}>Foundations</a>.
  </p>

  {featuredBooks.map((profile) => (
    <section aria-labelledby={profile.id}>
      <h2 id={profile.id}>{profile.authors} · <cite>{profile.title}</cite></h2>
      <BookCover cover={bookCovers[profile.id]} />
      <p class="paper-meta">{profile.edition}. {profile.publisher}. <a href={profile.sourceUrl}>Official source</a>.</p>
      <p><strong>Role.</strong> {profile.role}</p>
      <p><strong>Best use.</strong> {profile.bestUse}</p>
      <p><strong>Atlas connection.</strong> {profile.atlasRole}</p>
      <p><strong>Recommended path.</strong> {profile.readingPath}</p>
      {profile.guideHref ? <p><a href={href(profile.guideHref)}>Open the source-aligned book guide →</a></p> : <p class="paper-meta">This is a chapter-level reference, not yet a source-aligned Atlas guide; use the official source for its contents.</p>}
    </section>
  ))}
</BaseLayout>
