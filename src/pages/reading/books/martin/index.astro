---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { martinParts, martinReadingUnits } from '../../../../reading/books/martin';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const href = (route: string) => `${base}${route.replace(/^\//, '')}`;
---

<BaseLayout
  title="Martin · Electronic Structure"
  description="A guided route through Richard M. Martin's Electronic Structure, second edition."
  current="reading"
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={href('/reading/')}>Guided Reading</a>
    <span aria-hidden="true">/</span>
    <a href={href('/reading/books/')}>Books</a>
    <span aria-hidden="true">/</span>
    <span>Martin</span>
  </nav>

  <h1>Martin · Electronic Structure</h1>
  <p class="lede">
    A continuous guide to Richard M. Martin’s <cite>Electronic Structure: Basic Theory and Practical Methods</cite>, second edition. The route preserves the book’s sequence while using original explanations, careful historical compression, and modern additions directly connected to present research.
  </p>
  <p>
    The book is a research-level bridge across the many-electron problem, density-functional theory, numerical representations, material properties, Berry phases, and topology. It is one reading path rather than the sole taxonomy of the Atlas, and it does not replace prerequisite courses collected in <a href={href('/theory/')}>Foundations</a>.
  </p>

  <section aria-labelledby="writing-approach">
    <h2 id="writing-approach">How this guide is written</h2>
    <p>
      Each completed chapter uses the original chapter title, begins with a one-sentence Core Idea, and follows the source’s natural reasoning order. The body retains the central concepts, necessary contributors, physical meaning, assumptions, and decisive formulas needed to reconstruct the argument.
    </p>
    <p>
      Historical detail is compressed when it mainly records chronology. More space is given to theories and methods that remain foundational, active in present research, directly inherited by modern approaches, or frequently misunderstood. Later developments are kept distinguishable from Martin’s own account.
    </p>
    <p>
      No textbook pages, figures, or extracted full text are published here. The current overview exposes the complete source spine—{martinReadingUnits.length} stable units—without publishing empty chapter pages.
    </p>
  </section>

  <section aria-labelledby="source-spine">
    <h2 id="source-spine">Source spine</h2>
    {martinParts.map((part) => (
      <section aria-labelledby={part.id}>
        <h3 id={part.id}>Part {part.numeral} · {part.title}</h3>
        <ol start={part.units[0]?.kind === 'chapter' ? Number(part.units[0].number) : undefined}>
          {part.units.map((unit) => (
            <li>
              <span>{unit.kind === 'appendix' ? `Appendix ${unit.number}` : `Chapter ${unit.number}`}: {unit.title}</span>
              {unit.route && <> — <a href={href(unit.route)}>Read</a></>}
            </li>
          ))}
        </ol>
      </section>
    ))}
  </section>

  <section aria-labelledby="reading-order">
    <h2 id="reading-order">Reading order</h2>
    <p>
      Guide content begins with Chapter 1 and proceeds through Chapter 28 in source order. Appendices are added when the main sequence first needs them. The chapters are not forced to the same length: historical transitions are compressed, while central DFT, numerical, response, Berry-phase, and topology topics receive the depth required by present research use.
    </p>
  </section>
</BaseLayout>
