---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { martinParts, martinReadingUnits } from '../../../../reading/books/martin';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const href = (route: string) => `${base}${route.replace(/^\//, '')}`;
---

<BaseLayout
  title="Martin · Electronic Structure"
  description="A guided route through Richard M. Martin's Electronic Structure, second edition."
  current="reading"
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={href('/reading/')}>Guided Reading</a>
    <span aria-hidden="true">/</span>
    <a href={href('/reading/books/')}>Books</a>
    <span aria-hidden="true">/</span>
    <span>Martin</span>
  </nav>

  <h1>Martin · Electronic Structure</h1>
  <p class="lede">
    A continuous guide to Richard M. Martin’s <cite>Electronic Structure: Basic Theory and Practical Methods</cite>, second edition. The route follows the book from the origins of electronic-structure theory through density-functional methods, practical representations, material properties, Berry phases, and topology.
  </p>
  <p>
    This guide preserves Martin’s sequence while using original explanations and a layered reading structure. The book page shows what each Part contributes; Part pages explain how their chapters build the argument; Chapter and Appendix pages provide a source-aligned overview and the internal outline that later close reading will follow.
  </p>
  <p>
    Prerequisite courses and broader concept maps remain in <a href={href('/theory/')}>Foundations</a>. The Martin route contains {martinParts.length} Parts and {martinReadingUnits.length} Chapter or Appendix pages.
  </p>

  <section aria-labelledby="source-spine">
    <h2 id="source-spine">Source spine</h2>
    {martinParts.map((part) => (
      <section aria-labelledby={part.id}>
        <h3 id={part.id}>Part {part.numeral} · {part.title}</h3>
        <p>{part.summary}</p>
        <p>{part.progression}</p>
        <ul>
          {part.units.map((unit) => (
            <li>{unit.kind === 'appendix' ? `Appendix ${unit.number}` : `Chapter ${unit.number}`}: {unit.title}</li>
          ))}
        </ul>
        <p><a href={href(part.route)}>Read Part {part.numeral} →</a></p>
      </section>
    ))}
  </section>

  <section aria-labelledby="reading-order">
    <h2 id="reading-order">Reading order</h2>
    <p>
      The main route proceeds from Chapter 1 through Chapter 28 in source order. Appendix pages are available as a parallel reference layer and can be entered when a chapter first requires their derivations, formulas, or numerical background. Section-level close reading remains inside each Chapter or Appendix page rather than becoming another route layer.
    </p>
  </section>
</BaseLayout>
