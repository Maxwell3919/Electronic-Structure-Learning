---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { literatureConceptById } from '../../../../reading/literature-concepts';
import { literatureLibraryPaperById } from '../../../../reading/literature-library';
import { literatureSyntheses, type LiteratureSynthesis } from '../../../../reading/literature-syntheses';
import { researchPathsForSynthesis } from '../../../../research/research-paths';

export function getStaticPaths() {
  return literatureSyntheses.map((synthesis) => ({ params: { slug: synthesis.id }, props: { synthesis } }));
}

const { synthesis } = Astro.props as { synthesis: LiteratureSynthesis };
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const href = (route: string) => route.startsWith('http') ? route : `${base}${route.replace(/^\//, '')}`;
const concepts = synthesis.conceptIds.map((id) => literatureConceptById[id]);
const papers = synthesis.paperIds.map((id) => literatureLibraryPaperById[id]);
const researchPaths = researchPathsForSynthesis(synthesis.id);
---

<BaseLayout title={synthesis.title} description={synthesis.question} current="reading">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={href('/reading/literature/')}>Literature</a><span aria-hidden="true">/</span><a href={href('/reading/literature/synthesis/')}>Synthesis</a><span aria-hidden="true">/</span><span aria-current="page">{synthesis.title}</span></nav>
  <h1>{synthesis.title}</h1>

  <section aria-labelledby="question">
    <h2 id="question">Question</h2>
    <p class="lede">{synthesis.question}</p>
  </section>

  <section aria-labelledby="mechanism">
    <h2 id="mechanism">Core mechanism</h2>
    <p>{synthesis.mechanism}</p>
  </section>

  <section aria-labelledby="agreement">
    <h2 id="agreement">What the literature agrees on</h2>
    <ul>{synthesis.agreements.map((item) => <li>{item}</li>)}</ul>
  </section>

  <section aria-labelledby="differences">
    <h2 id="differences">Where the papers differ</h2>
    <ul>{synthesis.differences.map((item) => <li>{item}</li>)}</ul>
  </section>

  <section aria-labelledby="limits">
    <h2 id="limits">What the evidence does not establish</h2>
    <ul>{synthesis.limits.map((item) => <li>{item}</li>)}</ul>
  </section>

  <section aria-labelledby="concepts">
    <h2 id="concepts">Atlas concepts</h2>
    <ul class="compact-link-list">{concepts.map((concept) => <li><a href={href(concept.canonical_route)}>{concept.title}</a></li>)}</ul>
  </section>

  <section aria-labelledby="papers">
    <h2 id="papers">Key papers</h2>
    <ul>{papers.map((paper) => <li><a href={href(paper.atlas_route!)}>{paper.title}</a> <span class="secondary">({paper.year})</span></li>)}</ul>
  </section>

  <section aria-labelledby="research-paths">
    <h2 id="research-paths">From evidence to a research decision</h2>
    <ul>{researchPaths.map((path) => <li><a href={href(`/research-paths/${path.id}/`)}>{path.question}</a></li>)}</ul>
  </section>
</BaseLayout>
