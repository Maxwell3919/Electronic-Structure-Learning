---
import LiteratureReaderPage from '../../../../layouts/LiteratureReaderPage.astro';
import { literaturePaperById, type LiteraturePaper } from '../../../../reading/literature-papers';
import { publishedLiteraturePapers, type LiteratureLibraryPaper } from '../../../../reading/literature-library';
import { researchTopicById } from '../../../../reading/research-topics';

export function getStaticPaths() {
  return publishedLiteraturePapers
    .map((entry) => ({
      params: { topic: entry.primary_category, paper: entry.paper_id },
      props: { entry, paper: literaturePaperById[entry.paper_id] },
    }));
}

const { entry, paper } = Astro.props as { entry: LiteratureLibraryPaper; paper: LiteraturePaper };
const topic = researchTopicById[entry.primary_category];
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const readingAnalysisUrl = entry.reading_analysis_path
  ? `${base}papers/${paper.id}/reading-analysis.json`
  : null;
---

<LiteratureReaderPage {entry} {paper} {topic} {readingAnalysisUrl} />
