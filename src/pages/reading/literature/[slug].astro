---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { researchTopics, type ResearchTopic } from '../../../reading/research-topics';
import { papersByTopic } from '../../../reading/literature-papers';

export function getStaticPaths() {
  return [
    ...researchTopics.map((topic) => ({ params: { slug: topic.id }, props: { topic, legacy: false } })),
  ];
}

const { topic } = Astro.props as { topic: ResearchTopic };
const currentTopic = topic as ResearchTopic;
const papers = papersByTopic[currentTopic.id] ?? [];
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const href = (route: string) => route.startsWith('http') ? route : `${base}${route.replace(/^\//, '')}`;
---

<BaseLayout title={`${currentTopic.title} · Literature`} description={currentTopic.centralQuestion} current="reading">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={href('/reading/')}>Guided Reading</a><span aria-hidden="true">/</span><a href={href('/reading/literature/')}>Literature</a><span aria-hidden="true">/</span><span aria-current="page">{currentTopic.title}</span>
  </nav>

  <h1>{currentTopic.title}</h1>
  {papers.length > 0 ? (
    <ol class="literature-list">
      {papers.map((paper) => (
        <li>
          <article class="literature-entry" tabindex="0">
            <h2>{paper.href ? <a href={href(paper.href)}>{paper.title}</a> : paper.title}</h2>
            <p class="paper-meta">
              {paper.authors.join(', ')} · {paper.journal} · {paper.year}
            </p>
            <p class="paper-doi"><a href={`https://doi.org/${paper.doi}`}>DOI: {paper.doi}</a></p>
            {paper.readerState === 'complete_reader' ? (
              <details class="paper-abstract-details">
                <summary>Abstract</summary>
                <p class="paper-abstract">{paper.abstract}</p>
              </details>
            ) : paper.href ? (
              <p class="pre-reading-state">Pre-reading PDF available · reading analysis pending.</p>
            ) : (
              <p class="pre-reading-state">Source preparation pending.</p>
            )}
          </article>
        </li>
      ))}
    </ol>
  ) : <p class="empty-literature">No papers are listed in this topic.</p>}
  <nav class="sequence-nav" aria-label="Literature navigation"><a href={href('/reading/literature/')}>← Literature</a><a href={href('/reading/')}>Guided Reading</a></nav>
</BaseLayout>
