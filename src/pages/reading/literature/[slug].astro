---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { researchTopics, type ResearchTopic } from '../../../reading/research-topics';

export function getStaticPaths() {
  return [
    ...researchTopics.map((topic) => ({ params: { slug: topic.id }, props: { topic, legacy: false } })),
  ];
}

const { topic } = Astro.props as { topic: ResearchTopic };
const currentTopic = topic as ResearchTopic;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const href = (route: string) => route.startsWith('http') ? route : `${base}${route.replace(/^\//, '')}`;
---

<BaseLayout title={`${currentTopic.title} · Literature`} description={currentTopic.centralQuestion} current="reading">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={href('/reading/')}>Guided Reading</a><span aria-hidden="true">/</span><a href={href('/reading/literature/')}>Literature</a><span aria-hidden="true">/</span><span aria-current="page">{currentTopic.title}</span>
  </nav>

  <>
      <h1>{currentTopic.title}</h1>
      <section aria-labelledby="central-question"><h2 id="central-question">Central Question</h2><p class="lede">{currentTopic.centralQuestion}</p></section>
      <section aria-labelledby="researcher-questions"><h2 id="researcher-questions">What researchers ask</h2><ul>{currentTopic.questions.map((question) => <li>{question}</li>)}</ul></section>
      <section aria-labelledby="evidence"><h2 id="evidence">Evidence</h2><p>{currentTopic.evidence}</p></section>
      <section aria-labelledby="literature-routes"><h2 id="literature-routes">Literature Routes</h2><p>Routes will be developed individually from verified primary literature.</p></section>
      <section aria-labelledby="connections"><h2 id="connections">Connections</h2><ul>{currentTopic.connections.map((connection) => <li><a href={href(connection.href)}>{connection.label}</a></li>)}</ul></section>
      <nav class="sequence-nav" aria-label="Literature navigation"><a href={href('/reading/literature/')}>← Research Topic Map</a><a href={href('/reading/')}>Guided Reading</a></nav>
  </>
</BaseLayout>
