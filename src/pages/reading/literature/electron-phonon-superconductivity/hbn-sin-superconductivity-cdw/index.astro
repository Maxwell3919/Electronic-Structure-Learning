---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import { literaturePaperById } from '../../../../../reading/literature-papers';
import { literatureLibraryPaperById } from '../../../../../reading/literature-library';

const paper = literaturePaperById['hbn-sin-superconductivity-cdw'];
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const href = (route: string) => `${base}${route.replace(/^\//, '')}`;
const sourceSha256 = literatureLibraryPaperById[paper.id].document_sha256!;
const pdfUrl = href(`/papers/${paper.id}.pdf`);
const annotationsUrl = href(`/papers/${paper.id}/annotations.json`);
const sharedAnnotationsUrl = href(`/papers/api/annotations/${sourceSha256}`);
---

<BaseLayout title={paper.title} description={`Read the original ${paper.journal} paper with source-aligned annotations.`} current="reading" wide>
  <div class="reader-heading">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={href('/reading/literature/')}>Literature</a><span aria-hidden="true">/</span>
      <a href={href('/reading/literature/electron-phonon-superconductivity/')}>Electron–phonon interaction and conventional superconductivity</a><span aria-hidden="true">/</span>
      <span aria-current="page">Paper Reader</span>
    </nav>
    <h1>{paper.title}</h1>
    <p class="reader-meta">{paper.authors.join(', ')} · {paper.journal} · {paper.year} · <a href={`https://doi.org/${paper.doi}`}>DOI {paper.doi}</a></p>
    <p><a class="pdf-download" href={pdfUrl} download>Download PDF</a></p>
    <p class="reader-meta" data-shared-annotation-status>Loading the global anonymous annotation layer…</p>
  </div>

  <section class="paper-reader" aria-label="Annotated paper reader" data-paper-id={paper.id} data-source-sha256={sourceSha256} data-pdf-url={pdfUrl} data-annotations-url={annotationsUrl} data-shared-annotations-url={sharedAnnotationsUrl}>
    <aside class="annotation-rail annotation-left" aria-label="What does this mean?">
      <h2>What does this mean?</h2>
      <ol></ol>
    </aside>
    <div class="pdf-column">
      <p class="reader-status" role="status">Loading annotations and original PDF…</p>
      <div id="pdf-viewer" aria-label="Original PDF"></div>
    </div>
    <aside class="annotation-rail annotation-right" aria-label="Why does this matter?">
      <h2>Why does this matter?</h2>
      <ol></ol>
    </aside>
  </section>

  <p class="annotation-coverage" data-annotation-coverage>Loading annotation coverage…</p>
  <script src="../../../../../scripts/paper-reader.ts"></script>
</BaseLayout>
