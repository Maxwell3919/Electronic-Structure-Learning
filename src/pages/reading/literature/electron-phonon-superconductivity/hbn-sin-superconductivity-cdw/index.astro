---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import { literaturePaperById } from '../../../../../reading/literature-papers';
import { pilotAnnotations, pilotAnnotationCounts } from '../../../../../reading/pilot-annotations';

const paper = literaturePaperById['hbn-sin-superconductivity-cdw'];
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const href = (route: string) => `${base}${route.replace(/^\//, '')}`;
const pdfUrl = import.meta.env.ATLAS_PILOT_PDF_URL ?? '';
const readerEnabled = pdfUrl.length > 0;
---

<BaseLayout title={paper.title} description={`Read the original ${paper.journal} paper with source-aligned annotations.`} current="reading" wide>
  <div class="reader-heading">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={href('/reading/literature/')}>Literature</a><span aria-hidden="true">/</span>
      <a href={href('/reading/literature/electron-phonon-superconductivity/')}>Electron–phonon interaction and conventional superconductivity</a><span aria-hidden="true">/</span>
      <span aria-current="page">Paper Reader</span>
    </nav>
    <h1>{paper.title}</h1>
    <p class="reader-meta">{paper.authors.join(', ')} · {paper.journal} · {paper.year} · <a href={`https://doi.org/${paper.doi}`}>DOI {paper.doi}</a></p>
    {readerEnabled ? <p><a class="pdf-download" href={pdfUrl} download>Download PDF</a></p> : (
      <p class="rights-gate"><strong>Original PDF unavailable here.</strong> The located version of record is subscription content and no lawful open-access copy has been verified. <a href={`https://doi.org/${paper.doi}`}>Open the publisher record.</a></p>
    )}
  </div>

  {readerEnabled && (
    <section class="paper-reader" aria-label="Annotated paper reader" data-pdf-url={pdfUrl}>
      <aside class="annotation-rail annotation-left" aria-label="What does this mean?">
        <h2>What does this mean?</h2>
        <ol>
          {pilotAnnotations.map((anchor) => <li><button type="button" data-anchor={anchor.id}><span>{anchor.figureId ?? `${anchor.type} · p. ${anchor.page}`}</span>{anchor.left}</button></li>)}
        </ol>
      </aside>
      <div class="pdf-column">
        <p class="reader-status" role="status">Loading original PDF…</p>
        <div id="pdf-viewer" aria-label="Original PDF"></div>
      </div>
      <aside class="annotation-rail annotation-right" aria-label="Why does this matter?">
        <h2>Why does this matter?</h2>
        <ol>
          {pilotAnnotations.map((anchor) => <li><button type="button" data-anchor={anchor.id}><span>{anchor.figureId ?? `${anchor.type} · p. ${anchor.page}`}</span>{anchor.right}</button></li>)}
        </ol>
      </aside>
      <script id="pilot-annotations" type="application/json" set:html={JSON.stringify(pilotAnnotations)} is:inline></script>
    </section>
  )}

  <p class="annotation-coverage">Reader annotation set: {pilotAnnotationCounts.paragraph} paragraphs, {pilotAnnotationCounts.figure} figures, {pilotAnnotationCounts.table} tables, and {pilotAnnotationCounts.equation} equations.</p>
  <script src="../../../../../scripts/paper-reader.ts"></script>
</BaseLayout>
