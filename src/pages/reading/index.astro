---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const href = (route: string) => `${base}${route.replace(/^\//, '')}`;
---

<BaseLayout
  title="Guided Reading"
  description="Continuous, source-aligned routes through electronic-structure books and lectures."
  current="reading"
>
  <h1>Guided Reading</h1>
  <p class="lede">
    Follow a coherent source sequence when a knowledge map is not enough. Guided Reading explains why ideas appear in a particular order, connects decisive equations to their physical meaning, and points back to the Atlas whenever a prerequisite needs repair.
  </p>
  <p>
    These routes are original guides rather than reproductions. They preserve the sequence of a reviewed source while distinguishing its enduring argument from later developments, current use, and known limitations.
  </p>

  <section aria-labelledby="books">
    <h2 id="books">Books</h2>
    <p>
      Book guides follow the chapter order and reasoning structure of a major source while compressing secondary detail and expanding the ideas that matter most for present electronic-structure research.
    </p>
    <p>
      <a href={href('/reading/books/')}>Browse book guides</a>
    </p>
  </section>

  <section aria-labelledby="lectures">
    <h2 id="lectures">Lectures</h2>
    <p>
      Lecture guides will be added when a complete sequence has been reviewed for authorship, access, scope, and continuity. No empty lecture section is published in advance.
    </p>
  </section>

  <section aria-labelledby="reading-boundary">
    <h2 id="reading-boundary">How this differs from Foundations</h2>
    <p>
      <a href={href('/theory/')}>Foundations</a> answers what knowledge is needed, how subjects depend on one another, and where to study them. Guided Reading supplies continuity: motivation, argument, formalism, chapter synthesis, and connections to modern research.
    </p>
  </section>
</BaseLayout>
