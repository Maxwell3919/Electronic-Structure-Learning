---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const href = (route: string) => `${base}${route.replace(/^\//, '')}`;
---

<BaseLayout
  title="Guided Reading"
  description="Continuous, source-aligned routes through electronic-structure theory and methods."
  current="reading"
>
  <h1>Guided Reading</h1>
  <p class="lede">
    Follow a coherent source sequence when a knowledge map is not enough. Guided Reading explains why ideas appear in a particular order, connects decisive equations to their physical meaning, and points back to the Atlas whenever a prerequisite needs repair.
  </p>
  <p>
    These routes are original guides rather than textbook reproductions. They preserve the sequence of a reviewed source while separating enduring theory from later developments, current use, and known limitations.
  </p>

  <section aria-labelledby="martin-route">
    <h2 id="martin-route">Martin · Electronic Structure</h2>
    <p>
      Richard M. Martin’s <cite>Electronic Structure: Basic Theory and Practical Methods</cite>, second edition, supplies the first continuous route: twenty-eight chapters and eighteen appendices, from the many-electron problem and density-functional theory to practical representations, material properties, Berry phases, and topology.
    </p>
    <p>
      <a href={href('/reading/martin/')}>Open the Martin reading route</a>
    </p>
  </section>

  <section aria-labelledby="reading-boundary">
    <h2 id="reading-boundary">How this differs from Foundations</h2>
    <p>
      <a href={href('/theory/')}>Foundations</a> answers what knowledge is needed, how subjects depend on one another, and where to study them. Guided Reading supplies continuity: motivation, argument, formalism, chapter synthesis, and connections to modern research.
    </p>
  </section>
</BaseLayout>
