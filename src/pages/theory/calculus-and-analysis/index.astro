<BaseLayout title="Calculus and Analysis" description="Change, integration, limits, and convergence for electronic-structure theory." current="theory">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={href('/theory/')}>Theory</a><span aria-hidden="true">/</span><span aria-current="page">Calculus and Analysis</span>
