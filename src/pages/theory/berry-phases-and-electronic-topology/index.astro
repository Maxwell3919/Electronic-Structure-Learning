<BaseLayout title="Berry Phases and Electronic Topology" description="Gauge structure, Berry connection and curvature, polarization, Chern numbers, Wilson loops, Wannier centers, and topology evidence boundaries." current="theory">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
