<BaseLayout title="Relativistic Electronic Structure, Spin, and Magnetism" description="Scalar relativity, spinors, spin–orbit coupling, collinear and noncollinear magnetism, symmetry, and convergence boundaries." current="theory">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={href('/theory/')}>Theory</a><span aria-hidden="true">/</span><span aria-current="page">Relativistic Electronic Structure, Spin, and Magnetism</span>
