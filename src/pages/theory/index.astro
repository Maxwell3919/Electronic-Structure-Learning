      <li id="calculus-and-analysis">Calculus and Analysis</li>
      <li id="differential-equations">Differential Equations</li>
      <li id="fourier-analysis">Fourier Analysis</li>
      <li id="functional-analysis-and-variational-methods">Functional Analysis and Variational Methods</li>
      <li id="numerical-analysis">Numerical Analysis</li>
      <li id="probability-and-statistics">Probability and Statistics</li>
      <li id="group-theory-and-symmetry">Group Theory and Symmetry</li>
    </ul>
  </section>

