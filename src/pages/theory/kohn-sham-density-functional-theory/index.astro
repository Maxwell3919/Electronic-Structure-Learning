<BaseLayout title="Kohn–Sham Density Functional Theory" description="The auxiliary noninteracting system, Kohn–Sham equations, density reconstruction, and interpretation boundaries." current="theory">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={href('/theory/')}>Theory</a><span aria-hidden="true">/</span><span aria-current="page">Kohn–Sham Density Functional Theory</span>
