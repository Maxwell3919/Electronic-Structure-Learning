<BaseLayout title="Localized-Orbital Methods" description="Atom-centred basis functions, Bloch sums, nonorthogonality, basis convergence, and localized electronic-structure formulations." current="theory">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={href('/theory/')}>Theory</a><span aria-hidden="true">/</span><span aria-current="page">Localized-Orbital Methods</span>
