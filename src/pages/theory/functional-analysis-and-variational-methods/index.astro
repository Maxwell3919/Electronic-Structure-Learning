<BaseLayout title="Functional Analysis and Variational Methods" description="Hilbert spaces, operators, spectra, weak formulations, and variational principles for electronic structure." current="theory">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={href('/theory/')}>Theory</a><span aria-hidden="true">/</span><span aria-current="page">Functional Analysis and Variational Methods</span>
