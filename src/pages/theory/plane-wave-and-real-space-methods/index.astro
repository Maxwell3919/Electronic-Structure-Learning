<BaseLayout title="Plane-Wave and Real-Space Methods" description="Plane-wave spectral bases, real-space discretizations, grids, boundary conditions, and representation-specific errors." current="theory">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
