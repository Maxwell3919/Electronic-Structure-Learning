---
import { sourceVisuals, type SourceVisualId } from './source-media';

interface Props {
  kind: SourceVisualId;
}

const { kind } = Astro.props;
const visual = sourceVisuals[kind];
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<figure class="source-visual" data-source-media-id={visual.id} aria-labelledby={`source-visual-${visual.id}-caption`}>
  <a class="source-visual-source" href={visual.source_url}>
    <img
      class="source-visual-image"
      src={`${base}${visual.local_asset}`}
      alt={visual.alt}
      loading="lazy"
      decoding="async"
    />
  </a>
  <figcaption id={`source-visual-${visual.id}-caption`}>
    {visual.caption} <a href={visual.source_url}>Source: {visual.authors.join(' and ')}, <cite>{visual.source_title}</cite>, {visual.figure_or_table_id}{visual.page_if_applicable ? `, p. ${visual.page_if_applicable}` : ''}.</a>
  </figcaption>
</figure>
