---
import type { BookCover as BookCoverRecord } from './source-media';

interface Props {
  cover: BookCoverRecord;
}

const { cover } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<figure class="book-cover">
  <img src={`${base}${cover.local_asset}`} alt={cover.alt} loading="lazy" />
  <figcaption>
    {cover.caption} <a href={cover.source_url}>{cover.publication_or_publisher}</a>; catalog record retrieved {cover.retrieved_at}.
  </figcaption>
</figure>
