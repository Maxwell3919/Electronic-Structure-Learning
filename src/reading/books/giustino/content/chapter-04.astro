const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const href = (route: string) => `${base}${route.replace(/^\//, '')}`;

export const sectionLinks = [
  { id: 'adiabatic-surface', label: 'From a joint problem to an energy surface' },
  { id: 'force', label: 'Why a fixed-nuclei calculation yields a force' },
  { id: 'force-theorem', label: 'Hellmann–Feynman and its conditions' },
