const href = (route: string) => `${base}${route.replace(/^\//, '')}`;
export const sectionLinks = [
  { id: 'three-limits', label: 'Three limits, three kinds of insight' },
  { id: 'band-formation', label: 'How repeated local states become a band' },
  { id: 'motion-curvature', label: 'Slope, velocity, and curvature' },
