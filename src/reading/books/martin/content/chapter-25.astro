const href = (route: string) => `${base}${route.startsWith('/') ? route.slice(1) : route}`;

export const sectionLinks = [
  { id: 'section-25-1-introduction', label: '25.1 Introduction' },
  { id: 'section-25-2-topology-of-what', label: '25.2 Topology of What?' },
  { id: 'section-25-3-bulk-boundary', label: '25.3 Bulk-Boundary Correspondence' },
  { id: 'section-25-4-berry-phase', label: '25.4 Berry Phase and Topology for Bloch States in the Brillouin Zone' },
  { id: 'section-25-5-chern', label: '25.5 Berry Flux and Chern Numbers: Winding of the Berry Phase' },
  { id: 'section-25-6-time-reversal', label: '25.6 Time-Reversal Symmetry and Topology of the Electronic System' },
  { id: 'section-25-7-surface-qhe', label: '25.7 Surface States and the Relation to the Quantum Hall Effect' },
  { id: 'section-25-8-wannier', label: '25.8 Wannier Functions and Topology' },
