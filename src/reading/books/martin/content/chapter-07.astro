export const modernPerspective = [
  'Self-consistency is a nonlinear fixed-point problem inside a chosen Hamiltonian, exchange–correlation approximation, basis, pseudopotential or all-electron treatment, k-point sampling, and occupation model. A small SCF residual therefore establishes consistency of that numerical problem; it does not by itself establish basis convergence, Brillouin-zone convergence, structural accuracy, or validity of the exchange–correlation approximation.',
