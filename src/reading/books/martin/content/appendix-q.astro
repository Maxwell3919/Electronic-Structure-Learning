export const sectionLinks = [
  { id: 'section-q-1-quantum-hall-topology', label: 'Q.1 Quantum Hall Effect and Topology' },
  { id: 'section-q-2-surface-states', label: 'Q.2 Nature of the Surface States in the QHE' },
];

export const modernPerspective = [
  'The integer quantum Hall effect and a Chern insulator share the same chiral bulk–boundary structure, but their symmetry settings differ: the ordinary QHE uses an external magnetic field, while a Chern insulator realizes a nonzero Chern number without that Landau-level construction. A time-reversal-invariant Z₂ topological insulator is different again because its boundary channels are helical rather than a single set of co-propagating chiral modes.',
  'Topological protection fixes the net chiral channel count as long as the relevant bulk topological phase is maintained. It does not make every microscopic feature of an edge dispersion universal: termination, electrostatics, reconstruction, and additional trivial edge states can reshape the spectrum while leaving the invariant channel imbalance unchanged.',
