---
import type { PaperProfile as PaperProfileRecord } from './paper-profiles';

interface Props {
  profile: PaperProfileRecord;
}

const { profile } = Astro.props;
---

<section class="paper-profile" aria-labelledby={`${profile.id}-reading-note`}>
  <h2 id={`${profile.id}-reading-note`}>Why read this paper</h2>
  <p><strong>Citation.</strong> {profile.citation} <a href={profile.sourceUrl}>Original source</a>.</p>
  <p><strong>Why it matters.</strong> {profile.whyItMatters}</p>
  <p><strong>What to look for.</strong> {profile.lookFor}</p>
  <p><strong>Connection.</strong> {profile.connection}</p>
  <p class="paper-meta"><strong>Visual source note.</strong> {profile.visualNote}</p>
</section>
