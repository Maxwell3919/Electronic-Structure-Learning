---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  current?: 'home' | 'theory' | 'reading' | 'methods' | 'computational-tools' | 'reference';
  noIndex?: boolean;
}

const { title, description, current, noIndex = false } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const href = (route: string) => `${base}${route.replace(/^\//, '')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const navigation = [
  { id: 'theory', label: 'Foundations', route: '/theory/' },
  { id: 'reading', label: 'Guided Reading', route: '/reading/' },
  { id: 'methods', label: 'Methods', route: '/methods/' },
  { id: 'computational-tools', label: 'Computational Tools', route: '/computational-tools/' },
  { id: 'reference', label: 'Reference', route: '/reference/' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <title>{title} · Electronic Structure Atlas</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <a class="site-name" href={href('/')} aria-current={current === 'home' ? 'page' : undefined}>
        Electronic Structure Atlas
      </a>
      <nav aria-label="Primary navigation">
        {navigation.map((item) => (
          <a href={href(item.route)} aria-current={current === item.id ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer>
      <p>Independent, static, and built for careful scientific reading.</p>
    </footer>
  </body>
</html>
