---
import BaseLayout from './BaseLayout.astro';
import type { LiteratureLibraryPaper } from '../reading/literature-library';
import type { LiteraturePaper } from '../reading/literature-papers';
import type { ResearchTopic } from '../reading/research-topics';

type Props = {
  entry: LiteratureLibraryPaper;
  paper: LiteraturePaper;
  topic: ResearchTopic;
  readingAnalysisUrl: string | null;
};

const { entry, paper, topic, readingAnalysisUrl } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const href = (route: string) => route.startsWith('http') ? route : `${base}${route.replace(/^\//, '')}`;
const canDeliverPdf = entry.public_pdf_delivery === 'allowed';
const pdfUrl = canDeliverPdf ? href(`/papers/${paper.id}.pdf`) : null;
const curatedAnnotationsUrl = href(`/papers/api/annotations/${entry.document_sha256}`);
const hasReadingAnalysis = readingAnalysisUrl !== null;
const officialSourceUrl = paper.doi ? `https://doi.org/${paper.doi}` : paper.arxiv ? `https://arxiv.org/abs/${paper.arxiv}` : null;
---

<BaseLayout title={paper.title} description={`Read ${paper.title} with curated and personal annotation layers.`} current="reading" wide>
  <div class="reader-heading">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={href('/reading/literature/')}>Literature</a><span aria-hidden="true">/</span>
      <a href={href(`/reading/literature/${topic.id}/`)}>{topic.title}</a><span aria-hidden="true">/</span>
      <span aria-current="page">Paper Reader</span>
    </nav>
    <h1>{paper.title}</h1>
    <p class="reader-meta">{paper.authors.join(', ')} · {paper.journal} · {paper.year}{paper.doi && <> · <a href={`https://doi.org/${paper.doi}`}>DOI {paper.doi}</a></>}</p>
    {paper.companionCorrections?.map((correction) => (
      <p class="reader-meta">Companion correction: <a href={`https://doi.org/${correction.doi}`}>{correction.label} · DOI {correction.doi}</a></p>
    ))}
    {paper.sourceVersion && <p class="reader-meta">Source version: {paper.sourceVersion}</p>}
    {canDeliverPdf && pdfUrl
      ? <p><a class="pdf-download" href={pdfUrl}>Open PDF</a></p>
      : <div class="pdf-delivery-notice" role="note">
          <p><strong>PDF delivery withheld.</strong> The canonical research copy has no reviewed public-delivery permission for these exact bytes.</p>
          {officialSourceUrl && <p><a class="pdf-download" href={officialSourceUrl}>Open official source</a></p>}
        </div>}
    <p class="pre-reading-notice" data-reading-analysis-state>
      {hasReadingAnalysis
        ? 'Curated reading analysis is available in the source-aligned side rails.'
        : 'Reading analysis pending.'}
    </p>
    <p class="reader-meta" data-curated-annotation-status>Loading curated annotations…</p>
    <p class="reader-meta" data-personal-annotation-status>Loading personal annotations from this browser…</p>
    <details class="reader-diagnostics" data-reader-debug hidden>
      <summary>Reader diagnostics</summary>
      <pre data-reader-debug-output>Loading diagnostics…</pre>
    </details>
  </div>

  <section
    class="paper-reader"
    aria-label="Literature PDF Reader"
    data-paper-id={paper.id}
    data-source-sha256={entry.document_sha256}
    data-pdf-url={pdfUrl ?? undefined}
    data-public-pdf-delivery={entry.public_pdf_delivery}
    data-reading-analysis-url={readingAnalysisUrl ?? undefined}
    data-curated-annotations-url={curatedAnnotationsUrl}
  >
    <aside class="annotation-rail annotation-left" aria-label="What does this mean?" aria-hidden={!hasReadingAnalysis}>
      {hasReadingAnalysis && <><h2>What does this mean?</h2><ol></ol></>}
    </aside>
    {canDeliverPdf
      ? <div class="pdf-column">
          <div class="reader-status" role="status">Loading PDF…</div>
          <div id="pdf-viewer" aria-label={`PDF · ${paper.title}`}></div>
        </div>
      : <div class="pdf-column pdf-withheld" aria-label="Curated annotations without public PDF delivery">
          <h2>Curated annotations</h2>
          <p>The PDF remains in the private Records authority. Original curated notes can still be read here; page numbers refer to that canonical copy.</p>
          <ol data-curated-note-list><li>Loading curated annotations…</li></ol>
        </div>}
    <aside class="annotation-rail annotation-right" aria-label="Why does this matter?" aria-hidden={!hasReadingAnalysis}>
      {hasReadingAnalysis && <><h2>Why does this matter?</h2><ol></ol></>}
    </aside>
  </section>
  {hasReadingAnalysis && <p class="annotation-coverage" data-annotation-coverage>Loading reading-analysis coverage…</p>}
  <script src="../scripts/literature-reader.ts"></script>
</BaseLayout>
