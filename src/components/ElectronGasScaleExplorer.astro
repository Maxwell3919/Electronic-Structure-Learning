<figure class="chapter-visual ch05-scales" data-ch05-scales>
  <figcaption>
    <strong>原创交互模型：electron-gas density 与 energy scales</strong>
    <span lang="en">Original interactive model: electron-gas density and energy scales</span>
  </figcaption>

  <div class="chapter-visual__controls">
    <label>
      <span>density radius rₛ (a₀)</span>
      <input type="range" min="1" max="8" step="0.1" value="3.0" data-ch05-rs />
      <output data-ch05-rs-output>3.0</output>
    </label>
    <label>
      <span>spin polarization ζ</span>
      <input type="range" min="0" max="1" step="0.02" value="0.0" data-ch05-zeta />
      <output data-ch05-zeta-output>0.00</output>
    </label>
  </div>

  <svg viewBox="0 0 860 420" role="img" aria-labelledby="ch05-scale-title ch05-scale-desc">
    <title id="ch05-scale-title">Electron-gas characteristic scales</title>
    <desc id="ch05-scale-desc">Bars show normalized density, Fermi wavevector, kinetic energy magnitude, exchange energy magnitude and plasma frequency as the density radius and spin polarization change.</desc>
    <line x1="175" y1="365" x2="800" y2="365" class="plot-axis" />
    <text x="160" y="85" text-anchor="end">n</text>
    <text x="160" y="145" text-anchor="end">kF</text>
    <text x="160" y="205" text-anchor="end">tₛ</text>
    <text x="160" y="265" text-anchor="end">|εx|</text>
    <text x="160" y="325" text-anchor="end">ωp</text>
    <rect x="175" y="58" width="240" height="34" rx="5" data-ch05-scale-bar="density" />
    <rect x="175" y="118" width="345" height="34" rx="5" data-ch05-scale-bar="kf" />
    <rect x="175" y="178" width="220" height="34" rx="5" data-ch05-scale-bar="kinetic" />
    <rect x="175" y="238" width="180" height="34" rx="5" data-ch05-scale-bar="exchange" />
    <rect x="175" y="298" width="260" height="34" rx="5" data-ch05-scale-bar="plasma" />
    <text x="425" y="82" data-ch05-scale-label="density">n = 0.00884</text>
    <text x="530" y="142" data-ch05-scale-label="kf">kF = 0.640</text>
    <text x="405" y="202" data-ch05-scale-label="kinetic">tₛ = 0.123</text>
    <text x="365" y="262" data-ch05-scale-label="exchange">εx = −0.153</text>
    <text x="445" y="322" data-ch05-scale-label="plasma">ωp = 0.333</text>
  </svg>

  <div class="chapter-visual__readout" aria-live="polite">
    <strong data-ch05-scale-density>n = 0.008842 a₀⁻³; kF = 0.6397 a₀⁻¹</strong>
    <span data-ch05-scale-spin>kF↑ = 0.6397; kF↓ = 0.6397</span>
    <span data-ch05-scale-energies>EF = 0.2046 Ha; tₛ = 0.1228 Ha; εx = −0.1527 Ha</span>
    <span data-ch05-scale-response>kTF = 0.9024 a₀⁻¹; ωp = 0.3333 Ha/ℏ</span>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong><code>n=3/(4πrₛ³)</code>、<code>kFσ=(6π²nσ)^(1/3)</code>、<code>tₛ∝rₛ⁻²</code>、<code>εx∝−rₛ⁻¹</code>、<code>ωp∝rₛ⁻³ᐟ²</code>。</p>
    <p lang="en"><strong>Model:</strong> the bars use analytic three-dimensional electron-gas scaling in Hartree atomic units.</p>
    <p><strong>验收：</strong>rₛ 加倍时 n 降低 8 倍、kF 降低 2 倍、tₛ 降低 4 倍、|εx| 降低 2 倍；full polarization 的 kinetic/exchange factors 分别为 2²ᐟ³ 与 2¹ᐟ³。</p>
    <p lang="en"><strong>Acceptance:</strong> doubling $r_s$ changes density, wavevector, kinetic, and exchange scales by their exact powers; full polarization has the declared spin factors.</p>
    <p><strong>边界：</strong>无 lattice、ionic potential、correlation parameterization、temperature、effective mass 或 material units。</p>
    <p lang="en"><strong>Boundary:</strong> there is no lattice, ionic potential, correlation fit, temperature, effective mass, or material-specific input.</p>
  </div>
</figure>

<script>
  import { electronGasScales } from '../lib/chapter05Models.mjs';

  document.querySelectorAll('[data-ch05-scales]').forEach((root) => {
    const rsInput = root.querySelector('[data-ch05-rs]');
    const zetaInput = root.querySelector('[data-ch05-zeta]');
    const rsOutput = root.querySelector('[data-ch05-rs-output]');
    const zetaOutput = root.querySelector('[data-ch05-zeta-output]');
    const densityReadout = root.querySelector('[data-ch05-scale-density]');
    const spinReadout = root.querySelector('[data-ch05-scale-spin]');
    const energyReadout = root.querySelector('[data-ch05-scale-energies]');
    const responseReadout = root.querySelector('[data-ch05-scale-response]');
    const bars = Array.from(root.querySelectorAll('[data-ch05-scale-bar]'));
    const labels = Array.from(root.querySelectorAll('[data-ch05-scale-label]'));
    if (!(rsInput instanceof HTMLInputElement) || !(zetaInput instanceof HTMLInputElement)) return;

    const update = () => {
      const rs = Number(rsInput.value);
      const zeta = Number(zetaInput.value);
      const result = electronGasScales({ rs, zeta });
      const values = {
        density: result.density,
        kf: result.kF,
        kinetic: result.kineticPerElectron,
        exchange: Math.abs(result.exchangePerElectron),
        plasma: result.plasmaFrequency,
      };
      const maxima = { density: 0.24, kf: 1.92, kinetic: 1.85, exchange: 0.58, plasma: 1.74 };
      const texts = {
        density: `n = ${result.density.toFixed(5)}`,
        kf: `kF = ${result.kF.toFixed(3)}`,
        kinetic: `tₛ = ${result.kineticPerElectron.toFixed(3)}`,
        exchange: `εx = ${result.exchangePerElectron.toFixed(3)}`,
        plasma: `ωp = ${result.plasmaFrequency.toFixed(3)}`,
      };
      bars.forEach((bar) => {
        if (!(bar instanceof SVGRectElement)) return;
        const key = bar.getAttribute('data-ch05-scale-bar');
        const width = 560 * Math.min(1, values[key] / maxima[key]);
        bar.setAttribute('width', String(width));
      });
      labels.forEach((label) => {
        if (!(label instanceof SVGTextElement)) return;
        const key = label.getAttribute('data-ch05-scale-label');
        const width = 560 * Math.min(1, values[key] / maxima[key]);
        label.setAttribute('x', String(Math.min(740, 185 + width)));
        label.textContent = texts[key];
      });
      if (rsOutput instanceof HTMLOutputElement) rsOutput.value = rs.toFixed(1);
      if (zetaOutput instanceof HTMLOutputElement) zetaOutput.value = zeta.toFixed(2);
      if (densityReadout instanceof HTMLElement) densityReadout.textContent = `n = ${result.density.toFixed(6)} a₀⁻³; kF = ${result.kF.toFixed(4)} a₀⁻¹`;
      if (spinReadout instanceof HTMLElement) spinReadout.textContent = `kF↑ = ${result.kFUp.toFixed(4)}; kF↓ = ${result.kFDown.toFixed(4)}`;
      if (energyReadout instanceof HTMLElement) energyReadout.textContent = `EF = ${result.fermiEnergy.toFixed(4)} Ha; tₛ = ${result.kineticPerElectron.toFixed(4)} Ha; εx = ${result.exchangePerElectron.toFixed(4)} Ha`;
      if (responseReadout instanceof HTMLElement) responseReadout.textContent = `kTF = ${result.thomasFermiWavevector.toFixed(4)} a₀⁻¹; ωp = ${result.plasmaFrequency.toFixed(4)} Ha/ℏ`;
    };

    rsInput.addEventListener('input', update);
    zetaInput.addEventListener('input', update);
    update();
  });
</script>
