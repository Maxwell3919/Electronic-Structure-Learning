---
import { squareWellSPhaseShift } from '../../../data/part04/ch16TeachingModels.mjs';
const initial = squareWellSPhaseShift({ energy: 2, depth: 4, radius: 1 });
const energies = Array.from({ length: 220 }, (_, i) => 0.2 + 7.8 * i / 219);
const values = energies.map((energy) => squareWellSPhaseShift({ energy, depth: 4, radius: 1 }).sin2);
const points = values.map((v, i) => `${58 + i * 638 / 219},${24 + (1 - v) * 248}`).join(' ');
---
<figure class="chapter-visual phase-shift-kkr" id="ch16-phase-shift-kkr">
  <figcaption><strong>原创交互模型：single-site s-wave phase shift</strong><span lang="en">Original interactive model: single-site s-wave phase shift</span></figcaption>
  <div class="chapter-visual__controls"><label>well depth V₀<input data-phase-depth type="range" min="0" max="10" step="0.2" value="4" /><output data-phase-depth-output>4.0</output></label></div>
  <svg viewBox="0 0 720 320" role="img" aria-label="Single-site scattering strength sin squared delta versus energy">
    <line class="axis" x1="58" y1="272" x2="696" y2="272" /><line class="axis" x1="58" y1="24" x2="58" y2="272" /><polyline class="phase-curve" data-phase-curve points={points} />
    <text x="377" y="310" text-anchor="middle">energy E</text><text transform="translate(18 148) rotate(-90)" text-anchor="middle">sin² δ₀</text>
  </svg>
  <div class="chapter-visual__readout" aria-live="polite"><span>δ₀(E=2)=<output data-phase-delta>{initial.phaseShift.toFixed(6)}</output> rad</span><span>sin²δ₀=<output data-phase-sin2>{initial.sin2.toFixed(6)}</output></span></div>
  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>spherical square-well surrogate 的 l=0 phase shift。</p><p lang="en"><strong>Model:</strong> the l=0 phase shift of a spherical square-well surrogate.</p>
    <p><strong>验收：</strong>V₀=0 时 δ₀=0；所有控制值满足 0≤sin²δ₀≤1。</p><p lang="en"><strong>Acceptance:</strong> δ₀=0 at V₀=0 and 0≤sin²δ₀≤1 throughout the control range.</p>
    <p><strong>边界：</strong>single-site resonance 不等价于 periodic KKR band、material DOS 或 many-body excitation。</p><p lang="en"><strong>Boundary:</strong> a single-site resonance is not a periodic KKR band, material DOS, or many-body excitation.</p>
  </div>
  <noscript><p>无 JavaScript fallback：静态图使用 V₀=4、R=1。</p></noscript>
</figure>
<script>
  import { squareWellSPhaseShift } from '../../../data/part04/ch16TeachingModels.mjs';
  const root=document.getElementById('ch16-phase-shift-kkr');if(root){const control=root.querySelector('[data-phase-depth]'),path=root.querySelector('[data-phase-curve]'),dout=root.querySelector('[data-phase-depth-output]'),delta=root.querySelector('[data-phase-delta]'),sin2=root.querySelector('[data-phase-sin2]');if(control instanceof HTMLInputElement&&path instanceof SVGPolylineElement){const energies=Array.from({length:220},(_,i)=>.2+7.8*i/219);const update=()=>{const depth=Number(control.value),values=energies.map((energy)=>squareWellSPhaseShift({energy,depth,radius:1}).sin2);path.setAttribute('points',values.map((v,i)=>`${58+i*638/219},${24+(1-v)*248}`).join(' '));const probe=squareWellSPhaseShift({energy:2,depth,radius:1});if(dout instanceof HTMLOutputElement)dout.value=depth.toFixed(1);if(delta instanceof HTMLOutputElement)delta.value=probe.phaseShift.toFixed(6);if(sin2 instanceof HTMLOutputElement)sin2.value=probe.sin2.toFixed(6)};control.addEventListener('input',update);update()}}
</script>
<style>.phase-shift-kkr input,.phase-shift-kkr svg{width:100%}.phase-shift-kkr label{display:grid;gap:.35rem}.axis{stroke:currentColor;stroke-width:1.4}.phase-curve{fill:none;stroke:var(--sl-color-accent-high);stroke-width:2.4}.phase-shift-kkr svg text{fill:currentColor;font-size:13px}</style>
