---
import { apwBoundaryMatching } from '../../../data/part04/ch16TeachingModels.mjs';
const initial = apwBoundaryMatching({ energy: 2, depth: 4, radius: 0.9 });
const xs = Array.from({ length: 241 }, (_, i) => 2.2 * i / 240);
const sinc = (x) => Math.abs(x) < 1e-8 ? 1 : Math.sin(x) / x;
const series = xs.map((r) => r <= 0.9 ? initial.amplitude * sinc(initial.q * r) : sinc(initial.k * r));
const points = series.map((v, i) => `${58 + i * 638 / 240},${25 + (1.35 - v) * 257 / 2.7}`).join(' ');
---
<figure class="chapter-visual apw-matching" id="ch16-apw-matching">
  <figcaption><strong>原创交互模型：APW boundary value 与 slope mismatch</strong><span lang="en">Original interactive model: APW boundary value and slope mismatch</span></figcaption>
  <div class="chapter-visual__controls"><label>trial energy E<input data-apw-energy type="range" min="0.4" max="5" step="0.1" value="2" /><output data-apw-energy-output>2.0</output></label></div>
  <svg viewBox="0 0 720 330" role="img" aria-label="Value-matched radial surrogate with a slope mismatch at the augmentation radius">
    <line class="axis" x1="58" y1="282" x2="696" y2="282" /><line class="axis" x1="58" y1="25" x2="58" y2="282" />
    <line class="boundary" x1="319" x2="319" y1="25" y2="282" /><polyline class="radial" data-apw-radial points={points} />
    <text x="377" y="320" text-anchor="middle">radius r</text><text x="325" y="45">R</text>
  </svg>
  <div class="chapter-visual__readout" aria-live="polite">
    <span>amplitude=<output data-apw-amplitude>{initial.amplitude.toFixed(5)}</output></span>
    <span>D_inside=<output data-apw-inside>{initial.interiorLogDerivative.toFixed(5)}</output></span>
    <span>D_outside=<output data-apw-outside>{initial.exteriorLogDerivative.toFixed(5)}</output></span>
    <span>ΔD=<output data-apw-mismatch>{initial.mismatch.toFixed(5)}</output></span>
  </div>
  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>sphere 内外两个 s-wave sinc surrogates，只在 R 处匹配函数值。</p><p lang="en"><strong>Model:</strong> two s-wave sinc surrogates matched only in value at R.</p>
    <p><strong>验收：</strong>depth=0 时 amplitude=1 且 ΔD=0；非零 depth 通常留下 finite slope mismatch。</p><p lang="en"><strong>Acceptance:</strong> at zero depth the amplitude is one and ΔD is zero; nonzero depth generally leaves a finite mismatch.</p>
    <p><strong>边界：</strong>这不是 self-consistent radial solution、APW secular root 或 material band。</p><p lang="en"><strong>Boundary:</strong> this is not a self-consistent radial solution, APW secular root, or material band.</p>
  </div>
  <noscript><p>无 JavaScript fallback：静态图使用 E=2、depth=4、R=0.9。</p></noscript>
</figure>
<script>
  import { apwBoundaryMatching } from '../../../data/part04/ch16TeachingModels.mjs';
  const root=document.getElementById('ch16-apw-matching');
  if(root){const control=root.querySelector('[data-apw-energy]'),path=root.querySelector('[data-apw-radial]');const out={e:root.querySelector('[data-apw-energy-output]'),a:root.querySelector('[data-apw-amplitude]'),i:root.querySelector('[data-apw-inside]'),o:root.querySelector('[data-apw-outside]'),m:root.querySelector('[data-apw-mismatch]')};if(control instanceof HTMLInputElement&&path instanceof SVGPolylineElement){const xs=Array.from({length:241},(_,i)=>2.2*i/240),sinc=(x)=>Math.abs(x)<1e-8?1:Math.sin(x)/x;const update=()=>{const e=Number(control.value),r=apwBoundaryMatching({energy:e,depth:4,radius:.9}),values=xs.map((x)=>x<=.9?r.amplitude*sinc(r.q*x):sinc(r.k*x));path.setAttribute('points',values.map((v,i)=>`${58+i*638/240},${25+(1.35-v)*257/2.7}`).join(' '));if(out.e instanceof HTMLOutputElement)out.e.value=e.toFixed(1);if(out.a instanceof HTMLOutputElement)out.a.value=r.amplitude.toFixed(5);if(out.i instanceof HTMLOutputElement)out.i.value=r.interiorLogDerivative.toFixed(5);if(out.o instanceof HTMLOutputElement)out.o.value=r.exteriorLogDerivative.toFixed(5);if(out.m instanceof HTMLOutputElement)out.m.value=r.mismatch.toFixed(5)};control.addEventListener('input',update);update()}}
</script>
<style>.apw-matching input,.apw-matching svg{width:100%}.apw-matching label{display:grid;gap:.35rem}.axis{stroke:currentColor;stroke-width:1.4}.boundary{stroke:var(--sl-color-orange-high);stroke-width:2;stroke-dasharray:5 4}.radial{fill:none;stroke:var(--sl-color-accent-high);stroke-width:2.5}.apw-matching svg text{fill:currentColor;font-size:13px}</style>
