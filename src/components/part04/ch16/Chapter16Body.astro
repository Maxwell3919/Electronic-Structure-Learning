---
import Chapter16Contents from './Chapter16Contents.astro';
import Chapter16SourceMap from './Chapter16SourceMap.astro';
import Chapter16Orientation from './Chapter16Orientation.mdx';
import Chapter16APWFoundations from './Chapter16APWFoundations.mdx';
import Chapter16APWExamples from './Chapter16APWExamples.mdx';
import Chapter16KKR from './Chapter16KKR.mdx';
import Chapter16CPA from './Chapter16CPA.mdx';
import Chapter16MTOCanonical from './Chapter16MTOCanonical.mdx';
import Chapter16MTOLocalized from './Chapter16MTOLocalized.mdx';
import Chapter16EnergyForces from './Chapter16EnergyForces.mdx';
import Chapter16Review from './Chapter16Review.mdx';
---

<div class="chapter16-root">
  <Chapter16Contents />
  <Chapter16Orientation />
  <Chapter16SourceMap />
  <Chapter16APWFoundations />
  <Chapter16APWExamples />
  <Chapter16KKR />
  <Chapter16CPA />
  <Chapter16MTOCanonical />
  <Chapter16MTOLocalized />
  <Chapter16EnergyForces />
  <Chapter16Review />
</div>

<style is:global>
  .chapter16-root,
  .chapter16-root > *,
  .chapter16-root .bilingual-section,
  .chapter16-root .bilingual-section__grid,
  .chapter16-root .bilingual-section__zh,
  .chapter16-root .bilingual-section__en,
  .chapter16-root .derivation-block,
  .chapter16-root .bilingual-callout {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .chapter16-root .chapter-visual {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin-inline: 0;
    box-sizing: border-box;
  }

  .chapter16-root .chapter-source-map,
  .chapter16-root .katex-display,
  .chapter16-root pre,
  .chapter16-root table {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .chapter16-root p,
  .chapter16-root li,
  .chapter16-root th,
  .chapter16-root td {
    overflow-wrap: anywhere;
  }
</style>
