---
import { scalarCPA } from '../../../data/part04/ch16TeachingModels.mjs';
const initial = scalarCPA({ concentration: 0.5, potentialA: -1, potentialB: 1, cavityImag: -0.8 });
const path = Array.from({ length: 201 }, (_, i) => scalarCPA({ concentration: i / 200, potentialA: -1, potentialB: 1, cavityImag: -0.8 })).map((r) => `${58 + (r.sigma.re + 1.2) * 638 / 2.4},${24 + (1.35 - r.disorderWidth) * 248 / 1.35}`).join(' ');
const x = 58 + (initial.sigma.re + 1.2) * 638 / 2.4;
const y = 24 + (1.35 - initial.disorderWidth) * 248 / 1.35;
---
<figure class="chapter-visual cpa-effective-medium" id="ch16-cpa-effective-medium">
  <figcaption><strong>原创交互模型：single-site CPA coherent potential</strong><span lang="en">Original interactive model: single-site CPA coherent potential</span></figcaption>
  <div class="chapter-visual__controls"><label>A concentration c<input data-cpa-concentration type="range" min="0" max="1" step="0.01" value="0.5" /><output data-cpa-concentration-output>0.50</output></label></div>
  <svg viewBox="0 0 720 330" role="img" aria-label="Trajectory of a scalar coherent potential as concentration changes">
    <line class="axis" x1="58" y1="282" x2="696" y2="282" /><line class="axis" x1="377" y1="24" x2="377" y2="282" /><polyline class="cpa-path" points={path} /><circle class="cpa-marker" data-cpa-marker cx={x} cy={y} r="7" />
    <text x="377" y="320" text-anchor="middle">Re Σ</text><text transform="translate(18 153) rotate(-90)" text-anchor="middle">−Im Σ</text>
  </svg>
  <div class="chapter-visual__readout" aria-live="polite"><span>ReΣ=<output data-cpa-real>{initial.sigma.re.toFixed(6)}</output></span><span>−ImΣ=<output data-cpa-width>{initial.disorderWidth.toFixed(6)}</output></span><span>residual=<output data-cpa-residual>{initial.residualNorm.toExponential(2)}</output></span></div>
  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>$V_A=-1$、$V_B=1$ 嵌入固定 retarded cavity $g=-0.8i$ 的 scalar CPA。</p><p lang="en"><strong>Model:</strong> scalar CPA for $V_A=-1$ and $V_B=1$ in a fixed retarded cavity $g=-0.8i$.</p>
    <p><strong>验收：</strong>c=0/1 回到 pure B/A；selected root 满足 ImΣ≤0；residual 接近 machine precision。</p><p lang="en"><strong>Acceptance:</strong> c=0/1 recover pure B/A, the root is retarded, and the residual is near machine precision.</p>
    <p><strong>边界：</strong>该模型不含真实 lattice、charge self-consistency、short-range order 或 local relaxation。</p><p lang="en"><strong>Boundary:</strong> the model omits a real lattice, charge self-consistency, short-range order, and local relaxation.</p>
  </div>
  <noscript><p>无 JavaScript fallback：静态图使用 c=0.5。</p></noscript>
</figure>
<script>
  import { scalarCPA } from '../../../data/part04/ch16TeachingModels.mjs';
  const root=document.getElementById('ch16-cpa-effective-medium');if(root){const control=root.querySelector('[data-cpa-concentration]'),marker=root.querySelector('[data-cpa-marker]'),cout=root.querySelector('[data-cpa-concentration-output]'),re=root.querySelector('[data-cpa-real]'),width=root.querySelector('[data-cpa-width]'),residual=root.querySelector('[data-cpa-residual]');if(control instanceof HTMLInputElement&&marker instanceof SVGCircleElement){const update=()=>{const c=Number(control.value),r=scalarCPA({concentration:c,potentialA:-1,potentialB:1,cavityImag:-.8});marker.setAttribute('cx',String(58+(r.sigma.re+1.2)*638/2.4));marker.setAttribute('cy',String(24+(1.35-r.disorderWidth)*248/1.35));if(cout instanceof HTMLOutputElement)cout.value=c.toFixed(2);if(re instanceof HTMLOutputElement)re.value=r.sigma.re.toFixed(6);if(width instanceof HTMLOutputElement)width.value=r.disorderWidth.toFixed(6);if(residual instanceof HTMLOutputElement)residual.value=r.residualNorm.toExponential(2)};control.addEventListener('input',update);update()}}
</script>
<style>.cpa-effective-medium input,.cpa-effective-medium svg{width:100%}.cpa-effective-medium label{display:grid;gap:.35rem}.axis{stroke:currentColor;stroke-width:1.4}.cpa-path{fill:none;stroke:var(--sl-color-accent-high);stroke-width:2.5}.cpa-marker{fill:var(--sl-color-orange-high);stroke:currentColor;stroke-width:1.5}.cpa-effective-medium svg text{fill:currentColor;font-size:13px}</style>
