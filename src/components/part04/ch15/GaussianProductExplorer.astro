---
import { gaussianProduct } from '../../../data/part04/ch15TeachingModels.mjs';

const componentId = 'ch15-gaussian-product';
const defaults = { alpha: 1, beta: 0.6, separation: 2 };
const initial = gaussianProduct({ alpha: defaults.alpha, beta: defaults.beta, centerA: -defaults.separation / 2, centerB: defaults.separation / 2 });
const width = 720;
const height = 320;
const pad = { left: 54, right: 24, top: 24, bottom: 48 };
const xs = Array.from({ length: 321 }, (_, index) => -5 + 10 * index / 320);
const curves = (alpha, beta, separation) => {
  const centerA = -separation / 2;
  const centerB = separation / 2;
  const product = gaussianProduct({ alpha, beta, centerA, centerB });
  return {
    product,
    a: xs.map((x) => Math.exp(-alpha * (x - centerA) ** 2)),
    b: xs.map((x) => Math.exp(-beta * (x - centerB) ** 2)),
    p: xs.map((x) => Math.exp(-alpha * (x - centerA) ** 2 - beta * (x - centerB) ** 2)),
  };
};
const initialCurves = curves(defaults.alpha, defaults.beta, defaults.separation);
const toPolyline = (values) => values.map((value, index) => {
  const x = pad.left + index * (width - pad.left - pad.right) / (values.length - 1);
  const y = pad.top + (1.05 - value) * (height - pad.top - pad.bottom) / 1.05;
  return `${x.toFixed(2)},${y.toFixed(2)}`;
}).join(' ');
---

<figure class="chapter-visual gaussian-product" id={componentId}>
  <figcaption>
    <strong>原创交互模型：Gaussian product theorem</strong>
    <span lang="en">Original interactive model: the Gaussian product theorem</span>
  </figcaption>

  <div class="chapter-visual__controls gaussian-product__controls">
    <label>α<input data-gp-alpha type="range" min="0.2" max="2" step="0.05" value={defaults.alpha} /><output data-gp-alpha-output>{defaults.alpha.toFixed(2)}</output></label>
    <label>β<input data-gp-beta type="range" min="0.2" max="2" step="0.05" value={defaults.beta} /><output data-gp-beta-output>{defaults.beta.toFixed(2)}</output></label>
    <label>centre separation d<input data-gp-separation type="range" min="0" max="4" step="0.1" value={defaults.separation} /><output data-gp-separation-output>{defaults.separation.toFixed(1)}</output></label>
  </div>

  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${componentId}-title ${componentId}-desc`}>
    <title id={`${componentId}-title`}>Two primitive Gaussian functions and their product</title>
    <desc id={`${componentId}-desc`}>The product is another Gaussian centred at the exponent-weighted average of the two original centres.</desc>
    <line class="plot-axis" x1={pad.left} y1={height - pad.bottom} x2={width - pad.right} y2={height - pad.bottom} />
    <line class="plot-axis" x1={pad.left} y1={pad.top} x2={pad.left} y2={height - pad.bottom} />
    <polyline class="gp-curve gp-curve--a" data-gp-curve-a points={toPolyline(initialCurves.a)} />
    <polyline class="gp-curve gp-curve--b" data-gp-curve-b points={toPolyline(initialCurves.b)} />
    <polyline class="gp-curve gp-curve--product" data-gp-curve-product points={toPolyline(initialCurves.p)} />
    <line class="gp-centre" data-gp-centre x1={pad.left + ((initial.center + 5) / 10) * (width - pad.left - pad.right)} x2={pad.left + ((initial.center + 5) / 10) * (width - pad.left - pad.right)} y1={pad.top} y2={height - pad.bottom} />
    <text x={(width + pad.left - pad.right) / 2} y={height - 10} text-anchor="middle">x (arbitrary length)</text>
    <text transform={`translate(18 ${(height + pad.top - pad.bottom) / 2}) rotate(-90)`} text-anchor="middle">amplitude</text>
  </svg>

  <div class="chapter-visual__readout" aria-live="polite">
    <span>γ=<output data-gp-gamma>{initial.gamma.toFixed(3)}</output></span>
    <span>P=<output data-gp-centre-output>{initial.center.toFixed(3)}</output></span>
    <span>K_AB=<output data-gp-prefactor>{initial.prefactor.toFixed(5)}</output></span>
    <span>1D overlap=<output data-gp-overlap>{initial.overlap1D.toFixed(5)}</output></span>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>unnormalized one-dimensional primitive s Gaussians, <code>exp[-α(x-A)²]</code> and <code>exp[-β(x-B)²]</code>.</p>
    <p lang="en"><strong>Model:</strong> unnormalized one-dimensional primitive s Gaussians <code>exp[-α(x-A)²]</code> and <code>exp[-β(x-B)²]</code>.</p>
    <p><strong>验收：</strong><code>d=0</code> 时 product centre 与两个 centres 重合且 <code>K_AB=1</code>；交换 α↔β 并反射 centres 不改变 overlap。</p>
    <p lang="en"><strong>Acceptance:</strong> at <code>d=0</code> the product centre coincides with both original centres and <code>K_AB=1</code>; exchanging α and β while reflecting the centres leaves the overlap unchanged.</p>
    <p><strong>边界：</strong>该图只说明 primitive Gaussian algebra，不包含 normalization、contraction、angular momentum、nuclear cusp 或 periodic summation。</p>
    <p lang="en"><strong>Boundary:</strong> the figure illustrates primitive-Gaussian algebra only; it omits normalization, contraction, angular momentum, the nuclear cusp, and periodic summation.</p>
  </div>

  <noscript><p>无 JavaScript fallback：静态图对应 α=1、β=0.6、d=2；product centre、exponent 和 overlap 仍可读取。</p></noscript>
</figure>

<script>
  import { gaussianProduct } from '../../../data/part04/ch15TeachingModels.mjs';
  const root = document.getElementById('ch15-gaussian-product');
  if (root) {
    const alpha = root.querySelector('[data-gp-alpha]');
    const beta = root.querySelector('[data-gp-beta]');
    const separation = root.querySelector('[data-gp-separation]');
    const curveA = root.querySelector('[data-gp-curve-a]');
    const curveB = root.querySelector('[data-gp-curve-b]');
    const curveProduct = root.querySelector('[data-gp-curve-product]');
    const centreLine = root.querySelector('[data-gp-centre]');
    const outputs = {
      alpha: root.querySelector('[data-gp-alpha-output]'), beta: root.querySelector('[data-gp-beta-output]'), separation: root.querySelector('[data-gp-separation-output]'),
      gamma: root.querySelector('[data-gp-gamma]'), centre: root.querySelector('[data-gp-centre-output]'), prefactor: root.querySelector('[data-gp-prefactor]'), overlap: root.querySelector('[data-gp-overlap]'),
    };
    if (alpha instanceof HTMLInputElement && beta instanceof HTMLInputElement && separation instanceof HTMLInputElement && curveA instanceof SVGPolylineElement && curveB instanceof SVGPolylineElement && curveProduct instanceof SVGPolylineElement && centreLine instanceof SVGLineElement) {
      const width = 720, height = 320, pad = { left: 54, right: 24, top: 24, bottom: 48 };
      const xs = Array.from({ length: 321 }, (_, index) => -5 + 10 * index / 320);
      const points = (values) => values.map((value, index) => {
        const x = pad.left + index * (width - pad.left - pad.right) / (values.length - 1);
        const y = pad.top + (1.05 - value) * (height - pad.top - pad.bottom) / 1.05;
        return `${x.toFixed(2)},${y.toFixed(2)}`;
      }).join(' ');
      const update = () => {
        const a = Number(alpha.value), b = Number(beta.value), d = Number(separation.value);
        const A = -d / 2, B = d / 2;
        const result = gaussianProduct({ alpha: a, beta: b, centerA: A, centerB: B });
        curveA.setAttribute('points', points(xs.map((x) => Math.exp(-a * (x - A) ** 2))));
        curveB.setAttribute('points', points(xs.map((x) => Math.exp(-b * (x - B) ** 2))));
        curveProduct.setAttribute('points', points(xs.map((x) => Math.exp(-a * (x - A) ** 2 - b * (x - B) ** 2))));
        const cx = pad.left + ((result.center + 5) / 10) * (width - pad.left - pad.right);
        centreLine.setAttribute('x1', String(cx)); centreLine.setAttribute('x2', String(cx));
        if (outputs.alpha instanceof HTMLOutputElement) outputs.alpha.value = a.toFixed(2);
        if (outputs.beta instanceof HTMLOutputElement) outputs.beta.value = b.toFixed(2);
        if (outputs.separation instanceof HTMLOutputElement) outputs.separation.value = d.toFixed(1);
        if (outputs.gamma instanceof HTMLOutputElement) outputs.gamma.value = result.gamma.toFixed(3);
        if (outputs.centre instanceof HTMLOutputElement) outputs.centre.value = result.center.toFixed(3);
        if (outputs.prefactor instanceof HTMLOutputElement) outputs.prefactor.value = result.prefactor.toFixed(5);
        if (outputs.overlap instanceof HTMLOutputElement) outputs.overlap.value = result.overlap1D.toFixed(5);
      };
      [alpha, beta, separation].forEach((control) => control.addEventListener('input', update));
      update();
    }
  }
</script>

<style>
  .gaussian-product__controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 0.8rem; }
  .gaussian-product__controls label { display: grid; gap: 0.3rem; }
  .gaussian-product input, .gaussian-product svg { width: 100%; }
  .gaussian-product svg text { fill: currentColor; font-size: 13px; }
  .plot-axis { stroke: currentColor; stroke-width: 1.4; }
  .gp-curve { fill: none; stroke-width: 2.2; }
  .gp-curve--a { stroke: var(--sl-color-accent-high); }
  .gp-curve--b { stroke: currentColor; stroke-dasharray: 7 5; }
  .gp-curve--product { stroke: var(--sl-color-green-high); }
  .gp-centre { stroke: var(--sl-color-orange-high); stroke-dasharray: 4 4; }
</style>
