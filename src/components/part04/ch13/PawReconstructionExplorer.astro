---
import { pawTeachingProfile } from '../../../data/part04/ch13TeachingModels.mjs';

const componentId = 'ch13-paw-reconstruction';
const width = 680;
const height = 300;
const pad = { left: 52, right: 20, top: 24, bottom: 46 };
const defaults = { augmentationRadius: 1.6, amplitude: 0.7 };
const radii = Array.from({ length: 161 }, (_, index) => 4 * index / 160);

const yMin = -0.2;
const yMax = 0.9;
const toPolyline = (key, amplitude) => radii.map((radius, index) => {
  const value = pawTeachingProfile({ radius, augmentationRadius: defaults.augmentationRadius, amplitude })[key];
  const x = pad.left + index * (width - pad.left - pad.right) / (radii.length - 1);
  const y = pad.top + (yMax - value) * (height - pad.top - pad.bottom) / (yMax - yMin);
  return `${x.toFixed(2)},${y.toFixed(2)}`;
}).join(' ');
---

<figure class="chapter-visual paw-explorer" id={componentId}>
  <figcaption>
    <strong>原创交互模型：PAW 的平滑函数与局域增广修正</strong>
    <span lang="en">Original interactive model: a smooth PAW function plus a localized augmentation correction</span>
  </figcaption>

  <label class="paw-explorer__control">
    <span>一中心修正幅度 A（无量纲）| One-centre correction amplitude A</span>
    <input data-paw-amplitude type="range" min="0" max="1.2" step="0.05" value={defaults.amplitude} />
    <output data-paw-amplitude-output>{defaults.amplitude.toFixed(2)}</output>
  </label>

  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${componentId}-title ${componentId}-desc`}>
    <title id={`${componentId}-title`}>Smooth and reconstructed radial teaching profiles</title>
    <desc id={`${componentId}-desc`}>A smooth radial function extends through all space. A localized correction changes it only inside an augmentation radius of 1.6 dimensionless units.</desc>
    <line class="plot-axis" x1={pad.left} y1={height - pad.bottom} x2={width - pad.right} y2={height - pad.bottom} />
    <line class="plot-axis" x1={pad.left} y1={pad.top} x2={pad.left} y2={height - pad.bottom} />
    <line class="paw-explorer__radius" x1={pad.left + defaults.augmentationRadius / 4 * (width - pad.left - pad.right)} y1={pad.top} x2={pad.left + defaults.augmentationRadius / 4 * (width - pad.left - pad.right)} y2={height - pad.bottom} />
    <polyline class="paw-explorer__curve paw-explorer__curve--smooth" data-paw-smooth points={toPolyline('smooth', defaults.amplitude)} />
    <polyline class="paw-explorer__curve paw-explorer__curve--reconstructed" data-paw-reconstructed points={toPolyline('reconstructed', defaults.amplitude)} />
    <text x={(width + pad.left - pad.right) / 2} y={height - 10} text-anchor="middle">r (dimensionless)</text>
    <text transform={`translate(17 ${(height + pad.top - pad.bottom) / 2}) rotate(-90)`} text-anchor="middle">radial amplitude</text>
    <text x={pad.left + defaults.augmentationRadius / 4 * (width - pad.left - pad.right) + 7} y={pad.top + 16}>r_c</text>
    <g transform={`translate(${width - 235} 36)`}>
      <line class="paw-explorer__curve paw-explorer__curve--smooth" x1="0" x2="38" y1="0" y2="0" />
      <text x="46" y="5">smooth / 平滑</text>
      <line class="paw-explorer__curve paw-explorer__curve--reconstructed" x1="0" x2="38" y1="25" y2="25" />
      <text x="46" y="30">reconstructed / 重构</text>
    </g>
  </svg>

  <div class="chapter-visual__readout" aria-live="polite">
    <span>球外最大差值 | max difference outside r_c:</span>
    <strong data-paw-outside>0.000000</strong>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>平滑径向函数取 <code>r exp(−0.7r)</code>；修正项乘以紧支撑窗口 <code>(1−r/r_c)^2</code>，在 <code>r≥r_c=1.6</code> 时严格为零。所有量无量纲。</p>
    <p lang="en"><strong>Model:</strong> the smooth radial function is <code>r exp(−0.7r)</code>. The correction is multiplied by a compact-support window <code>(1−r/r_c)^2</code> and is exactly zero for <code>r≥r_c=1.6</code>. All quantities are dimensionless.</p>
    <p><strong>验收：</strong>任意滑块值下，重构函数与平滑函数在增广半径外必须逐点相同；<code>A=0</code> 时两条曲线在全空间重合。</p>
    <p lang="en"><strong>Acceptance:</strong> for every slider value, reconstructed and smooth functions must agree pointwise outside the augmentation radius; at <code>A=0</code> they coincide everywhere.</p>
    <p><strong>边界：</strong>这是局域修正结构的教学示意，不是原子 partial wave、projector 或真实 PAW dataset；曲线节点和幅度不代表元素数据。</p>
    <p lang="en"><strong>Boundary:</strong> this is a teaching model of a localized correction, not an atomic partial wave, projector, or PAW dataset. Its nodes and amplitudes represent no element.</p>
  </div>

  <noscript><p>关闭 JavaScript 后保留 A=0.70 的静态平滑与重构曲线；球外差值仍为零。</p></noscript>
</figure>

<script>
  import { pawTeachingProfile } from '../../../data/part04/ch13TeachingModels.mjs';

  const root = document.getElementById('ch13-paw-reconstruction');
  if (root) {
    const input = root.querySelector('[data-paw-amplitude]');
    const output = root.querySelector('[data-paw-amplitude-output]');
    const smooth = root.querySelector('[data-paw-smooth]');
    const reconstructed = root.querySelector('[data-paw-reconstructed]');
    const outsideOutput = root.querySelector('[data-paw-outside]');
    if (
      input instanceof HTMLInputElement
      && output instanceof HTMLOutputElement
      && smooth instanceof SVGPolylineElement
      && reconstructed instanceof SVGPolylineElement
      && outsideOutput instanceof HTMLElement
    ) {
      const width = 680;
      const height = 300;
      const pad = { left: 52, right: 20, top: 24, bottom: 46 };
      const radii = Array.from({ length: 161 }, (_, index) => 4 * index / 160);
      const yMin = -0.2;
      const yMax = 0.9;
      const pointsFor = (key, amplitude) => radii.map((radius, index) => {
        const value = pawTeachingProfile({ radius, augmentationRadius: 1.6, amplitude })[key];
        const x = pad.left + index * (width - pad.left - pad.right) / (radii.length - 1);
        const y = pad.top + (yMax - value) * (height - pad.top - pad.bottom) / (yMax - yMin);
        return `${x.toFixed(2)},${y.toFixed(2)}`;
      }).join(' ');

      const update = () => {
        const amplitude = Number(input.value);
        smooth.setAttribute('points', pointsFor('smooth', amplitude));
        reconstructed.setAttribute('points', pointsFor('reconstructed', amplitude));
        output.value = amplitude.toFixed(2);
        let maxDifference = 0;
        radii.filter((radius) => radius >= 1.6).forEach((radius) => {
          const profile = pawTeachingProfile({ radius, augmentationRadius: 1.6, amplitude });
          maxDifference = Math.max(maxDifference, Math.abs(profile.reconstructed - profile.smooth));
        });
        outsideOutput.textContent = maxDifference.toFixed(6);
      };
      input.addEventListener('input', update);
      update();
    }
  }
</script>

<style>
  .paw-explorer__control {
    display: grid;
    gap: 0.35rem;
  }

  .paw-explorer input,
  .paw-explorer svg {
    width: 100%;
  }

  .paw-explorer svg text {
    fill: currentColor;
    font-size: 13px;
  }

  .paw-explorer__curve {
    fill: none;
    stroke-width: 2.4;
  }

  .paw-explorer__curve--smooth {
    stroke: var(--sl-color-gray-2);
    stroke-dasharray: 6 4;
  }

  .paw-explorer__curve--reconstructed {
    stroke: var(--sl-color-accent-high);
  }

  .paw-explorer__radius {
    stroke: var(--sl-color-gray-4);
    stroke-dasharray: 4 4;
  }

  .plot-axis {
    stroke: currentColor;
    stroke-width: 1.4;
  }
</style>
