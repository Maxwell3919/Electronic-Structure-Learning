---
import { screenedStructureBand } from '../../../data/part04/ch17TeachingModels.mjs';
const initial=screenedStructureBand({screening:0.5,cutoff:3,maxShell:40,points:181});
const width=720,height=330,pad={left:56,right:24,top:24,bottom:48};
const all=[...initial.exact,...initial.truncated],min=Math.min(...all),max=Math.max(...all),span=max-min||1;
const toPoints=(values)=>values.map((value,index)=>`${(pad.left+index/(values.length-1)*(width-pad.left-pad.right)).toFixed(2)},${(pad.top+(max-value)/span*(height-pad.top-pad.bottom)).toFixed(2)}`).join(' ');
---
<figure class="chapter-visual lmto-range" id="ch17-lmto-range">
  <figcaption><strong>原创交互模型：screened LMTO range truncation</strong><span lang="en">Original interactive model: screened LMTO range truncation</span></figcaption>
  <div class="chapter-visual__controls lmto-controls"><label>screening α<input data-lmto-screening type="range" min="0" max="1.2" step="0.05" value="0.5" /><output data-lmto-screening-output>0.50</output></label><label>retained shells<input data-lmto-cutoff type="range" min="1" max="8" step="1" value="3" /><output data-lmto-cutoff-output>3</output></label></div>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="Full and shell-truncated one-dimensional screened structure bands">
    <line class="axis" x1={pad.left} y1={height-pad.bottom} x2={width-pad.right} y2={height-pad.bottom}/><polyline class="band exact" data-lmto-exact points={toPoints(initial.exact)}/><polyline class="band truncated" data-lmto-truncated points={toPoints(initial.truncated)}/><text x={(width+pad.left-pad.right)/2} y={height-10} text-anchor="middle">k from 0 to π</text>
  </svg>
  <div class="chapter-visual__readout" aria-live="polite"><span>max band error=<output data-lmto-error>{initial.maxError.toExponential(4)}</output></span><span>tail bound=<output data-lmto-bound>{initial.omittedTailBound.toExponential(4)}</output></span><span>last retained coupling=<output data-lmto-last>{initial.lastRetainedCoupling.toExponential(4)}</output></span></div>
  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>one-dimensional structure couplings S_n=exp(-α n)/n²，比较 40-shell reference 与 finite-shell truncation。</p><p lang="en"><strong>Model:</strong> one-dimensional structure couplings S_n=exp(-α n)/n², comparing a 40-shell reference with finite-shell truncation.</p>
    <p><strong>验收：</strong>固定 cutoff 时增加 screening 降低 tail；固定 screening 时增加 retained shells 降低 max band error。</p><p lang="en"><strong>Acceptance:</strong> stronger screening reduces the tail at fixed cutoff, while retaining more shells reduces the maximum band error at fixed screening.</p>
    <p><strong>边界：</strong>这是 representation-range surrogate，不是 LMTO radial potential function、self-consistent Hamiltonian 或 O(N) proof。</p><p lang="en"><strong>Boundary:</strong> this is a representation-range surrogate, not an LMTO radial potential function, self-consistent Hamiltonian, or proof of O(N) scaling.</p>
  </div>
  <noscript><p>无 JavaScript fallback：静态图使用 α=0.5、3 retained shells，并保留 truncation error 与 tail bound。</p></noscript>
</figure>
<script>
  import { screenedStructureBand } from '../../../data/part04/ch17TeachingModels.mjs';
  const root=document.getElementById('ch17-lmto-range');if(root){const screening=root.querySelector('[data-lmto-screening]'),cutoff=root.querySelector('[data-lmto-cutoff]'),exact=root.querySelector('[data-lmto-exact]'),truncated=root.querySelector('[data-lmto-truncated]'),sout=root.querySelector('[data-lmto-screening-output]'),cout=root.querySelector('[data-lmto-cutoff-output]'),error=root.querySelector('[data-lmto-error]'),bound=root.querySelector('[data-lmto-bound]'),last=root.querySelector('[data-lmto-last]');if(screening instanceof HTMLInputElement&&cutoff instanceof HTMLInputElement&&exact instanceof SVGPolylineElement&&truncated instanceof SVGPolylineElement){const width=720,height=330,pad={left:56,right:24,top:24,bottom:48};const update=()=>{const s=Number(screening.value),c=Number(cutoff.value),result=screenedStructureBand({screening:s,cutoff:c,maxShell:40,points:181}),all=[...result.exact,...result.truncated],min=Math.min(...all),max=Math.max(...all),span=max-min||1,toPoints=(values)=>values.map((value,index)=>`${(pad.left+index/(values.length-1)*(width-pad.left-pad.right)).toFixed(2)},${(pad.top+(max-value)/span*(height-pad.top-pad.bottom)).toFixed(2)}`).join(' ');exact.setAttribute('points',toPoints(result.exact));truncated.setAttribute('points',toPoints(result.truncated));if(sout instanceof HTMLOutputElement)sout.value=s.toFixed(2);if(cout instanceof HTMLOutputElement)cout.value=String(c);if(error instanceof HTMLOutputElement)error.value=result.maxError.toExponential(4);if(bound instanceof HTMLOutputElement)bound.value=result.omittedTailBound.toExponential(4);if(last instanceof HTMLOutputElement)last.value=result.lastRetainedCoupling.toExponential(4)};[screening,cutoff].forEach((control)=>control.addEventListener('input',update));update()}}
</script>
<style>.lmto-range input,.lmto-range svg{width:100%}.lmto-controls{display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:.8rem}.lmto-controls label{display:grid;gap:.35rem}.axis{stroke:currentColor;stroke-width:1.3}.band{fill:none;stroke-width:2.4}.exact{stroke:var(--sl-color-accent-high)}.truncated{stroke:currentColor;stroke-dasharray:7 5}.lmto-range svg text{fill:currentColor;font-size:13px}</style>
