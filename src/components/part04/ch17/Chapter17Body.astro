---
import Chapter17Contents from './Chapter17Contents.astro';
import Chapter17SourceMap from './Chapter17SourceMap.astro';
import Chapter17Orientation from './Chapter17Orientation.mdx';
import Chapter17Linearization from './Chapter17Linearization.mdx';
import Chapter17LAPW from './Chapter17LAPW.mdx';
import Chapter17LMTO from './Chapter17LMTO.mdx';
import Chapter17NMTOFullPotential from './Chapter17NMTOFullPotential.mdx';
import Chapter17Review from './Chapter17Review.mdx';
---

<div class="chapter17-root">
  <Chapter17Contents />
  <Chapter17Orientation />
  <Chapter17SourceMap />
  <Chapter17Linearization />
  <Chapter17LAPW />
  <Chapter17LMTO />
  <Chapter17NMTOFullPotential />
  <Chapter17Review />
</div>

<style is:global>
  .chapter17-root,
  .chapter17-root > *,
  .chapter17-root .bilingual-section,
  .chapter17-root .bilingual-section__grid,
  .chapter17-root .bilingual-section__zh,
  .chapter17-root .bilingual-section__en,
  .chapter17-root .derivation-block,
  .chapter17-root .bilingual-callout {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .chapter17-root .chapter-visual {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin-inline: 0;
    box-sizing: border-box;
  }

  .chapter17-root .chapter-source-map,
  .chapter17-root .katex-display,
  .chapter17-root pre,
  .chapter17-root table {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .chapter17-root p,
  .chapter17-root li,
  .chapter17-root th,
  .chapter17-root td {
    overflow-wrap: anywhere;
  }
</style>
