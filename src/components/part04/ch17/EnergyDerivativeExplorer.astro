---
import { radialEnergyDerivative } from '../../../data/part04/ch17TeachingModels.mjs';
const initial = radialEnergyDerivative({ energy: 2, radius: 4, points: 321 });
const width=720,height=330,pad={left:56,right:24,top:24,bottom:48};
const maxDerivative=Math.max(...initial.derivative.map(Math.abs));
const derivativeScaled=initial.derivative.map((value)=>value/(maxDerivative||1));
const toPoints=(values)=>values.map((value,index)=>`${(pad.left+initial.radii[index]/4*(width-pad.left-pad.right)).toFixed(2)},${(pad.top+(1.2-value)/2.4*(height-pad.top-pad.bottom)).toFixed(2)}`).join(' ');
---
<figure class="chapter-visual energy-derivative" id="ch17-energy-derivative">
  <figcaption><strong>原创交互模型：u 与 energy derivative u-dot</strong><span lang="en">Original interactive model: u and its energy derivative</span></figcaption>
  <div class="chapter-visual__controls"><label>reference energy Eν<input data-ed-energy type="range" min="0.6" max="4.5" step="0.1" value="2" /><output data-ed-energy-output>2.0</output></label></div>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="Normalized radial state and scaled energy derivative">
    <line class="axis" x1={pad.left} y1={height-pad.bottom} x2={width-pad.right} y2={height-pad.bottom}/><line class="axis" x1={pad.left} y1={pad.top} x2={pad.left} y2={height-pad.bottom}/>
    <polyline class="curve state" data-ed-state points={toPoints(initial.values)}/><polyline class="curve derivative" data-ed-derivative points={toPoints(derivativeScaled)}/>
    <text x={(width+pad.left-pad.right)/2} y={height-10} text-anchor="middle">radius r</text><text transform={`translate(18 ${(height+pad.top-pad.bottom)/2}) rotate(-90)`} text-anchor="middle">u and scaled u-dot</text>
  </svg>
  <div class="chapter-visual__readout" aria-live="polite"><span>norm(u)=<output data-ed-norm>{initial.norm.toFixed(9)}</output></span><span>inner product(u,u-dot)=<output data-ed-overlap>{initial.overlap.toExponential(3)}</output></span><span>norm(u-dot)=<output data-ed-derivative-norm>{initial.derivativeNorm.toFixed(6)}</output></span></div>
  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>finite-difference energy derivative of an L2-normalized radial state family.</p><p lang="en"><strong>Model:</strong> a finite-difference energy derivative of an L2-normalized radial-state family.</p>
    <p><strong>验收：</strong>norm(u)=1 且 inner product(u,u-dot) 接近 0，体现固定 normalization 的 derivative convention。</p><p lang="en"><strong>Acceptance:</strong> norm(u)=1 and the inner product of u with u-dot is near zero under the fixed-normalization derivative convention.</p>
    <p><strong>边界：</strong>u-dot 是 energy derivative；图中为便于显示单独缩放，不能按纵轴大小比较 u 与 u-dot 的物理单位。</p><p lang="en"><strong>Boundary:</strong> u-dot is an energy derivative and is separately rescaled for display, so its plotted amplitude cannot be compared dimensionally with u.</p>
  </div>
  <noscript><p>无 JavaScript fallback：静态图使用 Eν=2，并保留 normalization 与 orthogonality readouts。</p></noscript>
</figure>
<script>
  import { radialEnergyDerivative } from '../../../data/part04/ch17TeachingModels.mjs';
  const root=document.getElementById('ch17-energy-derivative');if(root){const control=root.querySelector('[data-ed-energy]'),state=root.querySelector('[data-ed-state]'),derivative=root.querySelector('[data-ed-derivative]'),eout=root.querySelector('[data-ed-energy-output]'),norm=root.querySelector('[data-ed-norm]'),overlap=root.querySelector('[data-ed-overlap]'),dnorm=root.querySelector('[data-ed-derivative-norm]');if(control instanceof HTMLInputElement&&state instanceof SVGPolylineElement&&derivative instanceof SVGPolylineElement){const width=720,height=330,pad={left:56,right:24,top:24,bottom:48};const update=()=>{const energy=Number(control.value),result=radialEnergyDerivative({energy,radius:4,points:321}),scale=Math.max(...result.derivative.map(Math.abs))||1,toPoints=(values)=>values.map((value,index)=>`${(pad.left+result.radii[index]/4*(width-pad.left-pad.right)).toFixed(2)},${(pad.top+(1.2-value)/2.4*(height-pad.top-pad.bottom)).toFixed(2)}`).join(' ');state.setAttribute('points',toPoints(result.values));derivative.setAttribute('points',toPoints(result.derivative.map((value)=>value/scale)));if(eout instanceof HTMLOutputElement)eout.value=energy.toFixed(1);if(norm instanceof HTMLOutputElement)norm.value=result.norm.toFixed(9);if(overlap instanceof HTMLOutputElement)overlap.value=result.overlap.toExponential(3);if(dnorm instanceof HTMLOutputElement)dnorm.value=result.derivativeNorm.toFixed(6)};control.addEventListener('input',update);update()}}
</script>
<style>.energy-derivative input,.energy-derivative svg{width:100%}.energy-derivative label{display:grid;gap:.35rem}.axis{stroke:currentColor;stroke-width:1.3}.curve{fill:none;stroke-width:2.4}.state{stroke:var(--sl-color-accent-high)}.derivative{stroke:var(--sl-color-orange-high);stroke-dasharray:6 4}.energy-derivative svg text{fill:currentColor;font-size:13px}</style>
