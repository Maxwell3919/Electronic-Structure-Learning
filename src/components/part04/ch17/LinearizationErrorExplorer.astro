---
import { radialLinearization } from '../../../data/part04/ch17TeachingModels.mjs';
const defaults = { referenceEnergy: 2, targetEnergy: 2.2, radius: 4, points: 321 };
const initial = radialLinearization(defaults);
const width = 720, height = 330, pad = { left: 56, right: 24, top: 24, bottom: 48 };
const scaleX = (r) => pad.left + r / defaults.radius * (width - pad.left - pad.right);
const scaleY = (value) => pad.top + (1.2 - value) / 2.4 * (height - pad.top - pad.bottom);
const points = (values) => values.map((value, index) => `${scaleX(initial.reference.radii[index]).toFixed(2)},${scaleY(value).toFixed(2)}`).join(' ');
---
<figure class="chapter-visual linearization-error" id="ch17-linearization-error">
  <figcaption><strong>原创交互模型：radial linearization error</strong><span lang="en">Original interactive model: radial linearization error</span></figcaption>
  <div class="chapter-visual__controls"><label>target offset ΔE<input data-lin-delta type="range" min="-0.5" max="0.5" step="0.025" value="0.2" /><output data-lin-delta-output>0.200</output></label></div>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="Exact normalized radial surrogate and first-order energy linearization">
    <line class="axis" x1={pad.left} y1={height-pad.bottom} x2={width-pad.right} y2={height-pad.bottom}/><line class="axis" x1={pad.left} y1={pad.top} x2={pad.left} y2={height-pad.bottom}/>
    <polyline class="curve exact" data-lin-exact points={points(initial.target.values)}/><polyline class="curve approx" data-lin-approx points={points(initial.approximation)}/>
    <text x={(width+pad.left-pad.right)/2} y={height-10} text-anchor="middle">radius r</text><text transform={`translate(18 ${(height+pad.top-pad.bottom)/2}) rotate(-90)`} text-anchor="middle">normalized amplitude</text>
  </svg>
  <div class="chapter-visual__readout" aria-live="polite"><span>L2 error=<output data-lin-error>{initial.errorNorm.toExponential(4)}</output></span><span>target overlap=<output data-lin-overlap>{initial.targetOverlap.toFixed(8)}</output></span><span>approx norm=<output data-lin-norm>{initial.approximationNorm.toFixed(8)}</output></span></div>
  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>normalized free-radial surrogate <code>sin(sqrt(E) r)</code> on a finite sphere, linearized about E=2.</p><p lang="en"><strong>Model:</strong> a normalized free-radial surrogate <code>sin(sqrt(E) r)</code> on a finite sphere, linearized about E=2.</p>
    <p><strong>验收：</strong>ΔE=0 时 exact 与 linearized curves 重合；小 ΔE 下 L2 error 按 ΔE² 缩放。</p><p lang="en"><strong>Acceptance:</strong> exact and linearized curves coincide at ΔE=0, and the small-offset L2 error scales as ΔE².</p>
    <p><strong>边界：</strong>该模型只验证一阶 Taylor structure；不代表 LAPW/LMTO eigenvalue error、self-consistency 或真实 radial potential。</p><p lang="en"><strong>Boundary:</strong> the model verifies first-order Taylor structure only; it is not a LAPW or LMTO eigenvalue, self-consistent, or material radial-potential calculation.</p>
  </div>
  <noscript><p>无 JavaScript fallback：静态图使用 Eν=2、ΔE=0.2，并保留 error、overlap 与 norm。</p></noscript>
</figure>
<script>
  import { radialLinearization } from '../../../data/part04/ch17TeachingModels.mjs';
  const root=document.getElementById('ch17-linearization-error');if(root){const control=root.querySelector('[data-lin-delta]'),exact=root.querySelector('[data-lin-exact]'),approx=root.querySelector('[data-lin-approx]'),deltaOut=root.querySelector('[data-lin-delta-output]'),error=root.querySelector('[data-lin-error]'),overlap=root.querySelector('[data-lin-overlap]'),norm=root.querySelector('[data-lin-norm]');if(control instanceof HTMLInputElement&&exact instanceof SVGPolylineElement&&approx instanceof SVGPolylineElement){const width=720,height=330,pad={left:56,right:24,top:24,bottom:48};const update=()=>{const delta=Number(control.value),result=radialLinearization({referenceEnergy:2,targetEnergy:2+delta,radius:4,points:321}),toPoints=(values)=>values.map((value,index)=>`${(pad.left+result.reference.radii[index]/4*(width-pad.left-pad.right)).toFixed(2)},${(pad.top+(1.2-value)/2.4*(height-pad.top-pad.bottom)).toFixed(2)}`).join(' ');exact.setAttribute('points',toPoints(result.target.values));approx.setAttribute('points',toPoints(result.approximation));if(deltaOut instanceof HTMLOutputElement)deltaOut.value=delta.toFixed(3);if(error instanceof HTMLOutputElement)error.value=result.errorNorm.toExponential(4);if(overlap instanceof HTMLOutputElement)overlap.value=result.targetOverlap.toFixed(8);if(norm instanceof HTMLOutputElement)norm.value=result.approximationNorm.toFixed(8)};control.addEventListener('input',update);update()}}
</script>
<style>.linearization-error input,.linearization-error svg{width:100%}.linearization-error label{display:grid;gap:.35rem}.axis{stroke:currentColor;stroke-width:1.3}.curve{fill:none;stroke-width:2.4}.exact{stroke:var(--sl-color-accent-high)}.approx{stroke:currentColor;stroke-dasharray:7 5}.linearization-error svg text{fill:currentColor;font-size:13px}</style>
