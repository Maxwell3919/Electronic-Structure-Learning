---
import { lapwBoundaryMatch } from '../../../data/part04/ch17TeachingModels.mjs';
const initial=lapwBoundaryMatch({referenceEnergy:2,planeWaveNumber:2.1,radius:1});
const width=720,height=330,pad={left:56,right:24,top:24,bottom:48};
const sinc=(x)=>Math.abs(x)<1e-8?1:Math.sin(x)/x;
const boundary=(energy,r)=>sinc(Math.sqrt(energy)*r);
const dot=(energy,r)=>{const h=1e-5;return(boundary(energy+h,r)-boundary(energy-h,r))/(2*h)};
const radii=Array.from({length:321},(_,i)=>2*i/320);
const values=radii.map((r)=>r<=1?initial.coefficientU*boundary(2,r)+initial.coefficientDotU*dot(2,r):sinc(2.1*r));
const toPoints=(series)=>series.map((value,index)=>`${(pad.left+radii[index]/2*(width-pad.left-pad.right)).toFixed(2)},${(pad.top+(1.25-value)/2.5*(height-pad.top-pad.bottom)).toFixed(2)}`).join(' ');
---
<figure class="chapter-visual lapw-matching" id="ch17-lapw-matching">
  <figcaption><strong>原创交互模型：LAPW value-and-slope matching</strong><span lang="en">Original interactive model: LAPW value-and-slope matching</span></figcaption>
  <div class="chapter-visual__controls"><label>reference energy Eν<input data-lapw-energy type="range" min="0.6" max="4" step="0.1" value="2" /><output data-lapw-energy-output>2.0</output></label></div>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="Linear combination of u and u-dot matched in value and slope to an interstitial radial plane-wave component">
    <line class="axis" x1={pad.left} y1={height-pad.bottom} x2={width-pad.right} y2={height-pad.bottom}/><line class="boundary" x1={pad.left+(width-pad.left-pad.right)/2} x2={pad.left+(width-pad.left-pad.right)/2} y1={pad.top} y2={height-pad.bottom}/><polyline class="match-curve" data-lapw-curve points={toPoints(values)}/>
    <text x={(width+pad.left-pad.right)/2} y={height-10} text-anchor="middle">radius r</text><text x={pad.left+(width-pad.left-pad.right)/2+6} y={42}>sphere R</text>
  </svg>
  <div class="chapter-visual__readout" aria-live="polite"><span>A=<output data-lapw-a>{initial.coefficientU.toFixed(6)}</output></span><span>B=<output data-lapw-b>{initial.coefficientDotU.toFixed(6)}</output></span><span>value residual=<output data-lapw-value>{initial.valueResidual.toExponential(2)}</output></span><span>slope residual=<output data-lapw-slope>{initial.slopeResidual.toExponential(2)}</output></span></div>
  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>s-wave sinc surrogate；sphere 内用 A u(Eν)+B u-dot(Eν)，sphere 外用固定 interstitial component。</p><p lang="en"><strong>Model:</strong> an s-wave sinc surrogate with A u(Eν)+B u-dot(Eν) inside the sphere and a fixed interstitial component outside.</p>
    <p><strong>验收：</strong>2×2 boundary system 同时将 value 与 radial slope residual 压到 floating-point precision。</p><p lang="en"><strong>Acceptance:</strong> the 2×2 boundary system reduces both value and radial-slope residuals to floating-point precision.</p>
    <p><strong>边界：</strong>图中没有 crystal harmonics、all l channels、local orbitals、semicore states、SCF 或 full potential。</p><p lang="en"><strong>Boundary:</strong> the figure omits crystal harmonics, all other l channels, local orbitals, semicore states, self-consistency, and full potential.</p>
  </div>
  <noscript><p>无 JavaScript fallback：静态图使用 Eν=2、G=2.1、R=1，并保留 coefficients 与 matching residuals。</p></noscript>
</figure>
<script>
  import { lapwBoundaryMatch } from '../../../data/part04/ch17TeachingModels.mjs';
  const root=document.getElementById('ch17-lapw-matching');if(root){const control=root.querySelector('[data-lapw-energy]'),curve=root.querySelector('[data-lapw-curve]'),eout=root.querySelector('[data-lapw-energy-output]'),aout=root.querySelector('[data-lapw-a]'),bout=root.querySelector('[data-lapw-b]'),vout=root.querySelector('[data-lapw-value]'),sout=root.querySelector('[data-lapw-slope]');if(control instanceof HTMLInputElement&&curve instanceof SVGPolylineElement){const width=720,height=330,pad={left:56,right:24,top:24,bottom:48},radii=Array.from({length:321},(_,i)=>2*i/320),sinc=(x)=>Math.abs(x)<1e-8?1:Math.sin(x)/x,boundary=(energy,r)=>sinc(Math.sqrt(energy)*r),dot=(energy,r)=>{const h=1e-5;return(boundary(energy+h,r)-boundary(energy-h,r))/(2*h)};const update=()=>{const energy=Number(control.value),result=lapwBoundaryMatch({referenceEnergy:energy,planeWaveNumber:2.1,radius:1}),values=radii.map((r)=>r<=1?result.coefficientU*boundary(energy,r)+result.coefficientDotU*dot(energy,r):sinc(2.1*r));curve.setAttribute('points',values.map((value,index)=>`${(pad.left+radii[index]/2*(width-pad.left-pad.right)).toFixed(2)},${(pad.top+(1.25-value)/2.5*(height-pad.top-pad.bottom)).toFixed(2)}`).join(' '));if(eout instanceof HTMLOutputElement)eout.value=energy.toFixed(1);if(aout instanceof HTMLOutputElement)aout.value=result.coefficientU.toFixed(6);if(bout instanceof HTMLOutputElement)bout.value=result.coefficientDotU.toFixed(6);if(vout instanceof HTMLOutputElement)vout.value=result.valueResidual.toExponential(2);if(sout instanceof HTMLOutputElement)sout.value=result.slopeResidual.toExponential(2)};control.addEventListener('input',update);update()}}
</script>
<style>.lapw-matching input,.lapw-matching svg{width:100%}.lapw-matching label{display:grid;gap:.35rem}.axis{stroke:currentColor;stroke-width:1.3}.boundary{stroke:var(--sl-color-orange-high);stroke-width:2;stroke-dasharray:5 4}.match-curve{fill:none;stroke:var(--sl-color-accent-high);stroke-width:2.5}.lapw-matching svg text{fill:currentColor;font-size:13px}</style>
