---
import Chapter14Contents from './Chapter14Contents.astro';
import Chapter14SourceMap from './Chapter14SourceMap.astro';
import Chapter14Orientation from './Chapter14Orientation.mdx';
import Chapter14LocalizedFoundations from './Chapter14LocalizedFoundations.mdx';
import Chapter14BandModels from './Chapter14BandModels.mdx';
import Chapter14GrapheneAndLattices from './Chapter14GrapheneAndLattices.mdx';
import Chapter14MaterialsAndTransfer from './Chapter14MaterialsAndTransfer.mdx';
import Chapter14Review from './Chapter14Review.mdx';
---

<div class="chapter14-root">
  <Chapter14Contents />
  <Chapter14Orientation />
  <Chapter14SourceMap />
  <Chapter14LocalizedFoundations />
  <Chapter14BandModels />
  <Chapter14GrapheneAndLattices />
  <Chapter14MaterialsAndTransfer />
  <Chapter14Review />
</div>

<style is:global>
  .chapter14-root,
  .chapter14-root > *,
  .chapter14-root .bilingual-section,
  .chapter14-root .bilingual-section__grid,
  .chapter14-root .bilingual-section__zh,
  .chapter14-root .bilingual-section__en,
  .chapter14-root .derivation-block,
  .chapter14-root .bilingual-callout {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .chapter14-root .chapter-visual {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin-inline: 0;
    box-sizing: border-box;
  }

  .chapter14-root .chapter-source-map,
  .chapter14-root .katex-display,
  .chapter14-root pre,
  .chapter14-root table {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .chapter14-root p,
  .chapter14-root li,
  .chapter14-root th,
  .chapter14-root td {
    overflow-wrap: anywhere;
  }
</style>
