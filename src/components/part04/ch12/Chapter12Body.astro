---
import Chapter12Contents from './Chapter12Contents.astro';
import Chapter12SourceMap from './Chapter12SourceMap.astro';
import Chapter12Orientation from './Chapter12Orientation.mdx';
import Chapter12PlaneWaveFoundations from './Chapter12PlaneWaveFoundations.mdx';
import Chapter12BandsAndPotentials from './Chapter12BandsAndPotentials.mdx';
import Chapter12DensityAndRealSpace from './Chapter12DensityAndRealSpace.mdx';
import Chapter12Review from './Chapter12Review.mdx';
---

<div class="chapter12-root">
  <Chapter12Contents />
  <Chapter12Orientation />
  <Chapter12SourceMap />
  <Chapter12PlaneWaveFoundations />
  <Chapter12BandsAndPotentials />
  <Chapter12DensityAndRealSpace />
  <Chapter12Review />
</div>

<style is:global>
  .chapter12-root,
  .chapter12-root > *,
  .chapter12-root .bilingual-section,
  .chapter12-root .bilingual-section__grid,
  .chapter12-root .bilingual-section__zh,
  .chapter12-root .bilingual-section__en,
  .chapter12-root .derivation-block,
  .chapter12-root .bilingual-callout {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .chapter12-root .chapter-visual {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin-inline: 0;
    box-sizing: border-box;
  }

  .chapter12-root .chapter-source-map,
  .chapter12-root .katex-display,
  .chapter12-root pre,
  .chapter12-root table {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .chapter12-root p,
  .chapter12-root li,
  .chapter12-root th,
  .chapter12-root td {
    overflow-wrap: anywhere;
  }
</style>
