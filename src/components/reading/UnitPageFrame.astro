---
const { unit = null, pageType = 'site' } = Astro.props;
---

<div
  class="esl-unit-page-frame"
  data-reading-frame={unit ? 'unit' : pageType}
  data-page-type={pageType}
  data-unit-reading-frame={unit ? 'true' : undefined}
  data-unit-id={unit?.unitId}
  data-source-family={unit?.sourceFamily}
>
  <slot />
</div>
