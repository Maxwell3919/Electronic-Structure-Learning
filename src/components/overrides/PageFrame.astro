---
import DefaultPageFrame from '@astrojs/starlight/components/PageFrame.astro';
import UnitPageFrame from '../reading/UnitPageFrame.astro';
import { resolveUnit, martinUnits } from '../../lib/unitCatalog.mjs';
const id = Astro.locals.starlightRoute.id;
const unit = resolveUnit(`/${id}/`);
const partRoutes = new Set(martinUnits.map((item) => item.part.slug));
const pageType = unit ? unit.kind
  : partRoutes.has(id) || id === 'practice-sholl-steckel' ? 'part-index'
    : id === 'theory' || id === 'book-map' || id === 'theory/atlas' ? 'theory-map'
      : id.startsWith('labs/') ? 'lab'
        : id.startsWith('literature') ? 'literature' : 'site';
---
<UnitPageFrame unit={unit} pageType={pageType}>
  <DefaultPageFrame>
    <slot name="header" slot="header" />
    <slot name="sidebar" slot="sidebar" />
    <slot />
  </DefaultPageFrame>
</UnitPageFrame>
