---
import EditorialPageHero from '../design/EditorialPageHero.astro';

interface Props {
  titleZh: string;
  titleEn: string;
  description: string;
  descriptionEn?: string;
  eyebrow?: string;
  pageType?: 'home' | 'learning' | 'theory' | 'lab' | 'case' | 'reference';
}

const {
  titleZh,
  titleEn,
  description,
  descriptionEn,
  eyebrow = 'Editorial Quantum Atlas',
  pageType = 'theory',
} = Astro.props;
---

<EditorialPageHero
  {eyebrow}
  {titleZh}
  {titleEn}
  descriptionZh={description}
  {descriptionEn}
  {pageType}
>
  <slot />
</EditorialPageHero>
