---
import { withBasePath } from '../../data/site/schema.mjs';

interface Lab {
  id: string;
  titleZh: string;
  titleEn: string;
  objective: string;
  software: string[];
  status: string;
  route: string;
}

interface Props { labs: Lab[]; }
const { labs } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section class="esl-catalog" aria-label="计算实验目录">
  {labs.map((lab) => (
    <article class="esl-catalog__item" id={lab.id}>
      <h2><a href={withBasePath(lab.route, base)}>{lab.titleZh}</a></h2>
      <p class="esl-card__title-en" lang="en">{lab.titleEn}</p>
      <p>{lab.objective}</p>
      <p class="esl-card__meta">{lab.software.join(' · ')} · 状态：{lab.status}</p>
      <p class="esl-boundary-note">课程界面已登记；实验正文、输入和验收尚未发布。</p>
    </article>
  ))}
</section>
