---
import { withBasePath } from '../../data/site/schema.mjs';

interface ReferenceSection {
  id: string;
  titleZh: string;
  titleEn: string;
  status: string;
  route: string;
}

interface Props { sections: ReferenceSection[]; }
const { sections } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<nav class="esl-catalog" aria-label="参考手册目录">
  {sections.map((section) => (
    <article class="esl-catalog__item" id={section.id}>
      <h2><a href={withBasePath(section.route, base)}>{section.titleZh}</a></h2>
      <p class="esl-card__title-en" lang="en">{section.titleEn}</p>
      <p class="esl-card__meta">{section.status}</p>
    </article>
  ))}
</nav>

