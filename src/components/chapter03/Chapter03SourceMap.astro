---
import catalog from '../../data/martin/index.mjs';

const treatments = {
  '3.1': '电子—核 Hamiltonian、Born–Oppenheimer 分离、变分原理与基态/激发态 | Electron–nuclear Hamiltonian, Born–Oppenheimer separation, variation, and states',
  '3.2': '扩展体系电中性、经典 Coulomb 中性分组与短程交换关联余项 | Neutrality, neutral Coulomb grouping, and the short-ranged exchange-correlation remainder',
  '3.3': 'Hellmann–Feynman 力、Pulay 修正、应力与 virial 定理 | Hellmann–Feynman force, Pulay terms, stress, and virial theorem',
  '3.4': '任意 Hamiltonian 参数的广义力与耦合常数积分 | Generalized force for a Hamiltonian parameter and coupling-constant integration',
  '3.5': 'canonical/grand-canonical 密度矩阵、熵、自由能与期望值 | Canonical/grand-canonical density matrices, entropy, free energy, and expectation values',
  '3.6': '独立电子、Fermi–Dirac 占据、Hartree 与 Hartree–Fock | Independent electrons, Fermi–Dirac occupations, Hartree, and Hartree–Fock',
  '3.7': 'pair density、交换洞、关联洞、HF 之后的关联与方法边界 | Pair density, exchange/correlation holes, post-HF correlation, and method boundaries',
};

const chapter = catalog.parts[0].units[2];
---

<h2 id="source-map">原书结构与来源定位 | Source Map</h2>

<div class="chapter-source-map">
  <table>
    <thead>
      <tr>
        <th scope="col">节 | Section</th>
        <th scope="col">原书标题 | Martin title</th>
        <th scope="col">印刷页 | Print page</th>
        <th scope="col">本站处理 | Website treatment</th>
        <th scope="col">状态 | Status</th>
      </tr>
    </thead>
    <tbody>
      {chapter.sections.map((section) => (
        <tr>
          <td><code>{section.id}</code></td>
          <td>{section.title}</td>
          <td>{section.page}</td>
          <td>{treatments[section.id]}</td>
          <td>review</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<p>
  Martin Chapter 3 begins on printed page 60. Section 3.7 ends on printed page 77, source exercises begin on page 78, and further reading ends on page 80. This website follows §§3.1–3.7 in directory order. The source exercises, answers, page layouts, and textbook figures are not reproduced.
</p>
<p lang="en">
