---
import Chapter20OrientationAndTerms from './Chapter20OrientationAndTerms.mdx';
import Chapter20SourceMap from './Chapter20SourceMap.astro';
import Chapter20LatticeAndDirect from './Chapter20LatticeAndDirect.mdx';
import Chapter20DensityResponse from './Chapter20DensityResponse.mdx';
import Chapter20VariationalAndPeriodic from './Chapter20VariationalAndPeriodic.mdx';
import Chapter20EffectiveCharges from './Chapter20EffectiveCharges.mdx';
import Chapter20EPCSpin from './Chapter20EPCSpin.mdx';
import Chapter20Closing from './Chapter20Closing.mdx';
---

<div class="chapter20-root">
  <Chapter20OrientationAndTerms />
  <Chapter20SourceMap />
  <Chapter20LatticeAndDirect />
  <Chapter20DensityResponse />
  <Chapter20VariationalAndPeriodic />
  <Chapter20EffectiveCharges />
  <Chapter20EPCSpin />
  <Chapter20Closing />
</div>

<style is:global>
  .chapter20-root,
  .chapter20-root > *,
  .chapter20-root .bilingual-section,
  .chapter20-root .bilingual-section__grid,
  .chapter20-root .bilingual-section__zh,
  .chapter20-root .bilingual-section__en,
  .chapter20-root .derivation-block,
  .chapter20-root .bilingual-callout {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .chapter20-root .chapter-visual {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin-inline: 0;
    box-sizing: border-box;
  }

  .chapter20-root .chapter-source-map,
  .chapter20-root .chapter20-symbol-table,
  .chapter20-root .chapter20-evidence-table,
  .chapter20-root .chapter20-source-table,
  .chapter20-root .katex-display,
  .chapter20-root pre {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .chapter20-root p,
  .chapter20-root li,
  .chapter20-root th,
  .chapter20-root td {
    overflow-wrap: anywhere;
  }
</style>
