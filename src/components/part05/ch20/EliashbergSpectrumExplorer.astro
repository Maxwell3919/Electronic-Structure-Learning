---
import { sampleEliashbergSpectrum } from '../../../data/part05/ch20TeachingModels.mjs';

const componentId = 'ch20-eliashberg-spectrum';
const width = 780;
const height = 350;
const pad = { left: 62, right: 62, top: 30, bottom: 54 };
const baseModes = [
  { frequency: 12, weight: 0.8 },
  { frequency: 28, weight: 0.55 },
  { frequency: 52, weight: 0.35 },
];
const defaults = { width: 1.8, weightScale: 1 };
const initial = sampleEliashbergSpectrum({ modes: baseModes, width: defaults.width });
const alphaMax = Math.max(...initial.spectrum.map((point) => point.alpha2F)) * 1.08;
const lambdaMax = initial.lambda * 1.08;
const xScale = (frequency) => pad.left + frequency / 70 * (width - pad.left - pad.right);
const yAlpha = (value) => pad.top + (1 - value / alphaMax) * (height - pad.top - pad.bottom);
const yLambda = (value) => pad.top + (1 - value / lambdaMax) * (height - pad.top - pad.bottom);
const alphaPoints = initial.spectrum
  .map((point) => `${xScale(point.frequency).toFixed(2)},${yAlpha(point.alpha2F).toFixed(2)}`)
  .join(' ');
const lambdaPoints = initial.cumulative
  .map((point) => `${xScale(point.frequency).toFixed(2)},${yLambda(point.lambda).toFixed(2)}`)
  .join(' ');
---

<figure class="chapter-visual eliashberg-spectrum" id={componentId}>
  <figcaption>
    <strong>Eliashberg 谱与累积耦合 | Eliashberg spectrum and cumulative coupling</strong>
    <span>原创正谱模型：三个声子频率区的 Gaussian 权重构成 α²F(ω)，并数值积分得到 λ(ω) 与 ωlog。</span>
    <span lang="en">Original positive-spectrum model: three Gaussian phonon regions form α²F(ω), which is integrated numerically to obtain cumulative λ(ω) and ωlog.</span>
  </figcaption>

  <div class="chapter-visual__controls">
    <label>
      谱展宽 σ（模型频率单位）
      <input data-width type="range" min="0.5" max="5" step="0.1" value={defaults.width} />
    </label>
    <label>
      矩阵元权重尺度 s
      <input data-scale type="range" min="0.5" max="2" step="0.05" value={defaults.weightScale} />
    </label>
  </div>

  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${componentId}-title ${componentId}-desc`}>
    <title id={`${componentId}-title`}>Eliashberg 谱函数和累积 lambda</title>
    <desc id={`${componentId}-desc`}>横轴为模型声子频率。实线对应 Eliashberg 谱函数，虚线对应从零积分到当前频率的累积电子声子耦合常数。</desc>
    <line class="axis" x1={pad.left} y1={height - pad.bottom} x2={width - pad.right} y2={height - pad.bottom} />
    <line class="axis" x1={pad.left} y1={pad.top} x2={pad.left} y2={height - pad.bottom} />
    <line class="axis" x1={width - pad.right} y1={pad.top} x2={width - pad.right} y2={height - pad.bottom} />
    <polyline class="spectrum-curve" data-spectrum points={alphaPoints} />
    <polyline class="lambda-curve" data-cumulative points={lambdaPoints} />
    <text x={(width + pad.left - pad.right) / 2} y={height - 10} text-anchor="middle">phonon frequency ω (model units)</text>
    <text transform={`translate(18 ${(height + pad.top - pad.bottom) / 2}) rotate(-90)`} text-anchor="middle">α²F(ω)</text>
    <text transform={`translate(${width - 14} ${(height + pad.top - pad.bottom) / 2}) rotate(90)`} text-anchor="middle">cumulative λ</text>
    <text class="direct-label" x={xScale(18)} y={pad.top + 22}>α²F(ω)</text>
    <text class="direct-label" x={xScale(47)} y={pad.top + 44}>λ(ω)</text>
  </svg>

  <div class="chapter-visual__readout" aria-live="polite">
    <span>σ = <output data-width-output>{defaults.width.toFixed(1)}</output></span>
    <span>s = <output data-scale-output>{defaults.weightScale.toFixed(2)}</output></span>
    <span>λ = <output data-lambda>{initial.lambda.toFixed(3)}</output></span>
    <span>ωlog = <output data-omega-log>{initial.omegaLog.toFixed(2)}</output></span>
    <span>grid Δω = <output data-grid>{initial.delta.toFixed(2)}</output></span>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>三个正 Gaussian 峰表示 Fermi 面加权后的模式贡献；λ=2∫α²F(ω)/ω dω，lnωlog=(2/λ)∫α²F(ω)lnω/ω dω。</p>
    <p><strong>验收：</strong>把所有权重乘 2 时 λ 乘 2，而 ωlog 在数值误差内不变；加密频率网格应稳定积分；所有峰为正不代表任何具体材料超导。</p>
    <p><strong>边界：</strong>模型没有 k/q/Fermi 面、真实 g、声子线宽、Coulomb pseudopotential、各向异性或非绝热效应；展宽只演示积分敏感性，不能当作生产 smearing 推荐。</p>
  </div>

  <noscript>
    <p><strong>无 JavaScript fallback | No-JavaScript fallback：</strong>默认 σ=1.8、s=1 的 α²F、累积 λ、总 λ 和 ωlog 仍可见；控件不更新。</p>
  </noscript>
</figure>

<script>
  import { sampleEliashbergSpectrum } from '../../../data/part05/ch20TeachingModels.mjs';

  const root = document.getElementById('ch20-eliashberg-spectrum');
  if (root) {
    const widthInput = root.querySelector('[data-width]');
    const scaleInput = root.querySelector('[data-scale]');
    const spectrumCurve = root.querySelector('[data-spectrum]');
    const cumulativeCurve = root.querySelector('[data-cumulative]');
    const widthOutput = root.querySelector('[data-width-output]');
    const scaleOutput = root.querySelector('[data-scale-output]');
    const lambdaOutput = root.querySelector('[data-lambda]');
    const omegaLogOutput = root.querySelector('[data-omega-log]');
    const gridOutput = root.querySelector('[data-grid]');

    if (
      widthInput instanceof HTMLInputElement
      && scaleInput instanceof HTMLInputElement
      && spectrumCurve instanceof SVGPolylineElement
      && cumulativeCurve instanceof SVGPolylineElement
      && widthOutput instanceof HTMLOutputElement
      && scaleOutput instanceof HTMLOutputElement
      && lambdaOutput instanceof HTMLOutputElement
      && omegaLogOutput instanceof HTMLOutputElement
      && gridOutput instanceof HTMLOutputElement
    ) {
      const width = 780;
      const height = 350;
      const pad = { left: 62, right: 62, top: 30, bottom: 54 };
      const baseModes = [
        { frequency: 12, weight: 0.8 },
        { frequency: 28, weight: 0.55 },
        { frequency: 52, weight: 0.35 },
      ];
      const xScale = (frequency) => pad.left + frequency / 70 * (width - pad.left - pad.right);

      const update = () => {
        const broadening = Number(widthInput.value);
        const weightScale = Number(scaleInput.value);
        const modes = baseModes.map((mode) => ({
          frequency: mode.frequency,
          weight: mode.weight * weightScale,
        }));
        const result = sampleEliashbergSpectrum({ modes, width: broadening });
        const alphaMax = Math.max(...result.spectrum.map((point) => point.alpha2F)) * 1.08;
        const lambdaMax = Math.max(result.lambda * 1.08, 1e-9);
        const yAlpha = (value) => pad.top
          + (1 - value / alphaMax) * (height - pad.top - pad.bottom);
        const yLambda = (value) => pad.top
          + (1 - value / lambdaMax) * (height - pad.top - pad.bottom);
        spectrumCurve.setAttribute('points', result.spectrum
          .map((point) => `${xScale(point.frequency).toFixed(2)},${yAlpha(point.alpha2F).toFixed(2)}`)
          .join(' '));
        cumulativeCurve.setAttribute('points', result.cumulative
          .map((point) => `${xScale(point.frequency).toFixed(2)},${yLambda(point.lambda).toFixed(2)}`)
          .join(' '));
        widthOutput.value = broadening.toFixed(1);
        scaleOutput.value = weightScale.toFixed(2);
        lambdaOutput.value = result.lambda.toFixed(3);
        omegaLogOutput.value = result.omegaLog.toFixed(2);
        gridOutput.value = result.delta.toFixed(2);
      };

      widthInput.addEventListener('input', update);
      scaleInput.addEventListener('input', update);
      update();
    }
  }
</script>

<style>
  .eliashberg-spectrum {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin-inline: 0;
    overflow-x: auto;
  }

  .eliashberg-spectrum svg {
    display: block;
    width: 100%;
    min-width: 36rem;
    height: auto;
  }

  .axis {
    stroke: currentColor;
    stroke-width: 1.4;
  }

  .spectrum-curve,
  .lambda-curve {
    fill: none;
    stroke-width: 2.7;
  }

  .spectrum-curve {
    stroke: var(--sl-color-accent-high);
  }

  .lambda-curve {
    stroke: currentColor;
    stroke-dasharray: 7 4;
  }

  text {
    fill: currentColor;
    font-size: 14px;
  }

  .direct-label {
    font-weight: 700;
  }
</style>
