---
import { sampleInterpolationError } from '../../../data/part05/ch23WannierModels.mjs';

const componentId = 'ch23-interpolation-locality';
const defaults = { cutoff: 3, maxRange: 12, decayLength: 1.8, nearestHopping: -1, points: 401 };
const result = sampleInterpolationError(defaults);
const width = 860;
const height = 430;
const top = { x0: 70, x1: 800, y0: 42, y1: 255 };
const bottom = { x0: 70, x1: 800, y0: 310, y1: 390 };
const energies = result.samples.flatMap((item) => [item.exact, item.interpolated]);
const eMin = Math.min(...energies);
const eMax = Math.max(...energies);
const x = (k) => top.x0 + (k + Math.PI) / (2 * Math.PI) * (top.x1 - top.x0);
const yE = (energy) => top.y1 - (energy - eMin) / Math.max(eMax - eMin, 1e-12) * (top.y1 - top.y0);
const maxAbsError = Math.max(...result.samples.map((item) => Math.abs(item.error)), 1e-12);
const yErr = (error) => (bottom.y0 + bottom.y1) / 2 - error / maxAbsError * (bottom.y1 - bottom.y0) / 2;
const exactPath = result.samples.map((item, index) => `${index === 0 ? 'M' : 'L'} ${x(item.k)} ${yE(item.exact)}`).join(' ');
const interpolatedPath = result.samples.map((item, index) => `${index === 0 ? 'M' : 'L'} ${x(item.k)} ${yE(item.interpolated)}`).join(' ');
const errorPath = result.samples.map((item, index) => `${index === 0 ? 'M' : 'L'} ${x(item.k)} ${yErr(item.error)}`).join(' ');
---

<figure class="chapter-visual interpolation-locality" id={componentId}>
  <figcaption>
    <strong>实空间 hopping 截断与插值误差 | Real-space hopping truncation and interpolation error</strong>
    <span>原创确定性模型：由指数衰减 hopping 构造精确 band，再截断到有限 R 比较全 k 区域误差。</span>
    <span lang="en">Original deterministic model: construct an exact band from exponentially decaying hoppings, truncate at finite R, and compare the error over the full k range.</span>
  </figcaption>

  <div class="chapter-visual__controls">
    <label>截断范围 R<sub>cut</sub> <input data-cutoff type="range" min="1" max="12" step="1" value={defaults.cutoff} /></label>
    <label>衰减长度 ξ (cells) <input data-decay type="range" min="0.6" max="4" step="0.1" value={defaults.decayLength} /></label>
  </div>

  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${componentId}-title ${componentId}-desc`}>
    <title id={`${componentId}-title`}>精确与截断 Wannier hopping 的能带和误差</title>
    <desc id={`${componentId}-desc`}>上图比较完整十二邻域 hopping 和有限截断插值，下图显示逐 k 误差。</desc>
    <rect class="plot-bg" x={top.x0} y={top.y0} width={top.x1-top.x0} height={top.y1-top.y0} />
    <line class="axis" x1={top.x0} x2={top.x1} y1={top.y1} y2={top.y1} />
    <line class="axis" x1={top.x0} x2={top.x0} y1={top.y0} y2={top.y1} />
    <path data-exact class="band exact" d={exactPath} />
    <path data-interpolated class="band interpolated" d={interpolatedPath} />
    <rect class="plot-bg" x={bottom.x0} y={bottom.y0} width={bottom.x1-bottom.x0} height={bottom.y1-bottom.y0} />
    <line class="zero" x1={bottom.x0} x2={bottom.x1} y1={(bottom.y0+bottom.y1)/2} y2={(bottom.y0+bottom.y1)/2} />
    <path data-error class="error-path" d={errorPath} />
    <text x="245" y="63">exact / full R≤12</text>
    <text x="610" y="63">truncated interpolation</text>
    <text x="435" y="296" text-anchor="middle">E<sub>interp</sub>(k) − E<sub>exact</sub>(k)</text>
    <text x="435" y="420" text-anchor="middle">k</text>
  </svg>

  <div class="chapter-visual__readout" aria-live="polite">
    <span>max |ΔE| = <output data-max-error>{result.maxError.toFixed(5)}</output></span>
    <span>RMS ΔE = <output data-rms>{result.rmsError.toFixed(5)}</output></span>
    <span>|t(R<sub>cut</sub>)| = <output data-last-hop>{Math.abs(result.hoppings[defaults.cutoff-1].hopping).toExponential(2)}</output></span>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>$H(k)=2\sum_{R=1}^{12}t_R\cos(kR)$，$t_R=t_1e^{-(R-1)/\xi}/R$；插值只保留 $R\le R_{cut}$。</p>
    <p><strong>验收：</strong>$R_{cut}=12$ 时 max/RMS error 为零；固定 ξ 时增加 cutoff 不增大误差；更长 ξ 产生更慢 hopping 衰减，通常需要更大 cutoff。</p>
    <p><strong>边界：</strong>真实多带插值还依赖子空间、matrix-valued hoppings、Wigner–Seitz 距离、简并和 coarse k mesh。沿一条路径小误差不代表 full-BZ、velocity 或其他 matrix element 已验证。</p>
  </div>

  <noscript><p><strong>无 JavaScript fallback | No-JavaScript fallback：</strong>默认 cutoff=3 的 exact/truncated bands、误差曲线和验收条件保持可见。</p></noscript>
</figure>

<script>
  import { sampleInterpolationError } from '../../../data/part05/ch23WannierModels.mjs';
  const root = document.getElementById('ch23-interpolation-locality');
  if (root) {
    const cutoff = root.querySelector('[data-cutoff]');
    const decay = root.querySelector('[data-decay]');
    const exact = root.querySelector('[data-exact]');
    const interpolated = root.querySelector('[data-interpolated]');
    const error = root.querySelector('[data-error]');
    const outputs = {
      maxError: root.querySelector('[data-max-error]'), rms: root.querySelector('[data-rms]'), lastHop: root.querySelector('[data-last-hop]'),
    };
    if ([cutoff, decay].every((item) => item instanceof HTMLInputElement)
      && [exact, interpolated, error].every((item) => item instanceof SVGPathElement)
      && Object.values(outputs).every((item) => item instanceof HTMLOutputElement)) {
      const top={x0:70,x1:800,y0:42,y1:255}; const bottom={x0:70,x1:800,y0:310,y1:390};
      const update=()=>{
        const result=sampleInterpolationError({cutoff:Number(cutoff.value),maxRange:12,decayLength:Number(decay.value),nearestHopping:-1,points:401});
        const energies=result.samples.flatMap((item)=>[item.exact,item.interpolated]); const eMin=Math.min(...energies); const eMax=Math.max(...energies);
        const x=(k)=>top.x0+(k+Math.PI)/(2*Math.PI)*(top.x1-top.x0); const yE=(value)=>top.y1-(value-eMin)/Math.max(eMax-eMin,1e-12)*(top.y1-top.y0);
        const maxAbs=Math.max(...result.samples.map((item)=>Math.abs(item.error)),1e-12); const yErr=(value)=>(bottom.y0+bottom.y1)/2-value/maxAbs*(bottom.y1-bottom.y0)/2;
        exact.setAttribute('d',result.samples.map((item,index)=>`${index===0?'M':'L'} ${x(item.k)} ${yE(item.exact)}`).join(' '));
        interpolated.setAttribute('d',result.samples.map((item,index)=>`${index===0?'M':'L'} ${x(item.k)} ${yE(item.interpolated)}`).join(' '));
        error.setAttribute('d',result.samples.map((item,index)=>`${index===0?'M':'L'} ${x(item.k)} ${yErr(item.error)}`).join(' '));
        outputs.maxError.value=result.maxError.toFixed(5); outputs.rms.value=result.rmsError.toFixed(5);
        outputs.lastHop.value=Math.abs(result.hoppings[Number(cutoff.value)-1].hopping).toExponential(2);
      };
      [cutoff,decay].forEach((input)=>input.addEventListener('input',update)); update();
    }
  }
</script>

<style>
  .interpolation-locality{width:100%;min-width:0;max-width:100%;margin-inline:0;overflow-x:auto}.interpolation-locality svg{display:block;width:100%;min-width:42rem;height:auto}
  .plot-bg{fill:var(--sl-color-gray-7);stroke:var(--sl-color-gray-5)}.axis,.zero{stroke:currentColor;stroke-width:1.3}.zero{stroke-dasharray:5 4}.band,.error-path{fill:none;stroke-width:2.8}.exact{stroke:currentColor}.interpolated{stroke:var(--sl-color-accent-high);stroke-dasharray:7 4}.error-path{stroke:var(--sl-color-accent-high)}text{fill:currentColor;font-size:14px}
</style>
