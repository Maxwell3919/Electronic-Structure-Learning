---
import { sampleGaugeWannier } from '../../../data/part05/ch23WannierModels.mjs';

const componentId = 'ch23-gauge-localization';
const defaults = { kPoints: 41, phaseShift: 2, phaseRipple: 0 };
const result = sampleGaugeWannier(defaults);
const width = 860;
const height = 390;
const left = { x0: 60, x1: 395, y0: 45, y1: 300 };
const right = { x0: 465, x1: 815, y0: 45, y1: 300 };
const bandX = (k) => left.x0 + k / (2 * Math.PI) * (left.x1 - left.x0);
const bandY = (energy) => left.y1 - (energy + 2) / 4 * (left.y1 - left.y0);
const bandPath = result.band.map((item, index) => `${index === 0 ? 'M' : 'L'} ${bandX(item.k)} ${bandY(item.energy)}`).join(' ');
const maxProbability = Math.max(...result.probabilities.map((item) => item.probability));
const cellMin = result.probabilities[0].cell;
const cellMax = result.probabilities.at(-1).cell;
const probX = (cell) => right.x0 + (cell - cellMin) / (cellMax - cellMin) * (right.x1 - right.x0);
const probY = (probability) => right.y1 - probability / Math.max(maxProbability, 1e-12) * (right.y1 - right.y0);
const probabilityPath = result.probabilities.map((item, index) => `${index === 0 ? 'M' : 'L'} ${probX(item.cell)} ${probY(item.probability)}`).join(' ');
---

<figure class="chapter-visual gauge-localization" id={componentId}>
  <figcaption>
    <strong>规范相位、晶格平移与局域化 | Gauge phase, lattice translation, and localization</strong>
    <span>原创离散 Fourier 模型：能带固定，改变 Bloch 相位后 Wannier 中心可平移或产生实空间尾。</span>
    <span lang="en">Original discrete-Fourier model: the band is fixed, while the Bloch phase moves the Wannier centre or creates real-space tails.</span>
  </figcaption>

  <div class="chapter-visual__controls">
    <label>整数相位绕数 m <input data-shift type="range" min="-4" max="4" step="1" value={defaults.phaseShift} /></label>
    <label>平滑相位起伏 A <input data-ripple type="range" min="0" max="2" step="0.05" value={defaults.phaseRipple} /></label>
    <label>k 点数 N<sub>k</sub> <input data-kpoints type="range" min="21" max="81" step="20" value={defaults.kPoints} /></label>
  </div>

  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${componentId}-title ${componentId}-desc`}>
    <title id={`${componentId}-title`}>相同能带在不同 Bloch gauge 下的 Wannier 概率</title>
    <desc id={`${componentId}-desc`}>左图为不随规范改变的余弦能带，右图为规范相位 Fourier 变换后的晶格概率。</desc>
    <rect class="plot-bg" x={left.x0} y={left.y0} width={left.x1-left.x0} height={left.y1-left.y0} />
    <rect class="plot-bg" x={right.x0} y={right.y0} width={right.x1-right.x0} height={right.y1-right.y0} />
    <line class="axis" x1={left.x0} x2={left.x1} y1={left.y1} y2={left.y1} />
    <line class="axis" x1={left.x0} x2={left.x0} y1={left.y0} y2={left.y1} />
    <line class="axis" x1={right.x0} x2={right.x1} y1={right.y1} y2={right.y1} />
    <line class="axis" x1={right.x0} x2={right.x0} y1={right.y0} y2={right.y1} />
    <path class="band-path" d={bandPath} />
    <path data-probability class="probability-path" d={probabilityPath} />
    <text x={(left.x0+left.x1)/2} y="28" text-anchor="middle">E(k) = −2 cos k (unchanged)</text>
    <text x={(right.x0+right.x1)/2} y="28" text-anchor="middle">|w(R)|²</text>
    <text x={(left.x0+left.x1)/2} y="338" text-anchor="middle">k</text>
    <text x={(right.x0+right.x1)/2} y="338" text-anchor="middle">lattice cell R</text>
  </svg>

  <div class="chapter-visual__readout" aria-live="polite">
    <span>centre = <output data-center>{result.center.toFixed(3)}</output> cells</span>
    <span>spread = <output data-spread>{result.spread.toFixed(4)}</output> cells²</span>
    <span>peak R = <output data-peak>{result.peakCell}</output></span>
    <span>norm = <output data-norm>{result.norm.toFixed(6)}</output></span>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>单带能量固定为 E(k)=−2 cos k，Bloch coefficient 乘以 exp[i(mk+A sin k)] 后作离散 inverse Fourier transform。</p>
    <p><strong>验收：</strong>A=0 且 m 为整数时概率严格局域在 R=m，spread=0；改变 m 只平移中心，不改变能带；A&gt;0 时中心保持同一 branch 附近而 spread 增大；概率归一化为 1。</p>
    <p><strong>边界：</strong>模型没有真实原子轨道、多个 bands、有限基组误差或拓扑阻碍。整数中心差对应 lattice-vector gauge，不是不同体极化的唯一证明。</p>
  </div>

  <noscript><p><strong>无 JavaScript fallback | No-JavaScript fallback：</strong>默认 m=2、A=0 的固定能带和单晶胞 Wannier 概率仍可见；控件不更新。</p></noscript>
</figure>

<script>
  import { sampleGaugeWannier } from '../../../data/part05/ch23WannierModels.mjs';
  const root = document.getElementById('ch23-gauge-localization');
  if (root) {
    const shift = root.querySelector('[data-shift]');
    const ripple = root.querySelector('[data-ripple]');
    const kpoints = root.querySelector('[data-kpoints]');
    const curve = root.querySelector('[data-probability]');
    const outputs = {
      center: root.querySelector('[data-center]'), spread: root.querySelector('[data-spread]'),
      peak: root.querySelector('[data-peak]'), norm: root.querySelector('[data-norm]'),
    };
    if ([shift, ripple, kpoints].every((item) => item instanceof HTMLInputElement)
      && curve instanceof SVGPathElement
      && Object.values(outputs).every((item) => item instanceof HTMLOutputElement)) {
      const right = { x0: 465, x1: 815, y0: 45, y1: 300 };
      const update = () => {
        const result = sampleGaugeWannier({
          kPoints: Number(kpoints.value), phaseShift: Number(shift.value), phaseRipple: Number(ripple.value),
        });
        const maxProbability = Math.max(...result.probabilities.map((item) => item.probability));
        const cellMin = result.probabilities[0].cell; const cellMax = result.probabilities.at(-1).cell;
        const x = (cell) => right.x0 + (cell-cellMin)/(cellMax-cellMin)*(right.x1-right.x0);
        const y = (probability) => right.y1 - probability/Math.max(maxProbability,1e-12)*(right.y1-right.y0);
        curve.setAttribute('d', result.probabilities.map((item,index) => `${index===0?'M':'L'} ${x(item.cell)} ${y(item.probability)}`).join(' '));
        outputs.center.value = result.center.toFixed(3); outputs.spread.value = result.spread.toFixed(4);
        outputs.peak.value = String(result.peakCell); outputs.norm.value = result.norm.toFixed(6);
      };
      [shift, ripple, kpoints].forEach((input) => input.addEventListener('input', update)); update();
    }
  }
</script>

<style>
  .gauge-localization { width:100%; min-width:0; max-width:100%; margin-inline:0; overflow-x:auto; }
  .gauge-localization svg { display:block; width:100%; min-width:42rem; height:auto; }
  .plot-bg { fill:var(--sl-color-gray-7); stroke:var(--sl-color-gray-5); }
  .axis { stroke:currentColor; stroke-width:1.4; }
  .band-path { fill:none; stroke:var(--sl-color-gray-3); stroke-width:2.5; }
  .probability-path { fill:none; stroke:var(--sl-color-accent-high); stroke-width:3; }
  text { fill:currentColor; font-size:14px; }
</style>
