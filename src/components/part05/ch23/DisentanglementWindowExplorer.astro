---
import { sampleEntangledWindow } from '../../../data/part05/ch23WannierModels.mjs';

const componentId='ch23-disentanglement-window';
const defaults={coupling:0.12,outerMin:-0.8,outerMax:0.8,points:161};
const result=sampleEntangledWindow(defaults);
const width=860; const height=480;
const top={x0:70,x1:800,y0:45,y1:245}; const bottom={x0:70,x1:800,y0:310,y1:430};
const x=(k)=>top.x0+(k+Math.PI)/(2*Math.PI)*(top.x1-top.x0);
const yE=(e)=>top.y1-(e+1.1)/2.2*(top.y1-top.y0);
const yF=(f)=>bottom.y1-f*(bottom.y1-bottom.y0);
const lowerPath=result.samples.map((item,index)=>`${index===0?'M':'L'} ${x(item.k)} ${yE(item.states[0].energy)}`).join(' ');
const upperPath=result.samples.map((item,index)=>`${index===0?'M':'L'} ${x(item.k)} ${yE(item.states[1].energy)}`).join(' ');
const fidelityPath=result.samples.map((item,index)=>`${index===0?'M':'L'} ${x(item.k)} ${yF(item.fidelity)}`).join(' ');
---

<figure class="chapter-visual disentanglement-window" id={componentId}>
  <figcaption>
    <strong>纠缠能带、outer window 与子空间 fidelity | Entangled bands, outer window, and subspace fidelity</strong>
    <span>原创 avoided-crossing 模型：目标原子轨道由两个本征态共同张成，窗口漏掉其中一态时投影 fidelity 降低。</span>
    <span lang="en">Original avoided-crossing model: two eigenstates jointly span a target orbital, and fidelity falls when the outer window omits one contribution.</span>
  </figcaption>

  <div class="chapter-visual__controls">
    <label>耦合 v (eV) <input data-coupling type="range" min="0.02" max="0.4" step="0.01" value={defaults.coupling} /></label>
    <label>outer min (eV) <input data-min type="range" min="-1.2" max="0" step="0.05" value={defaults.outerMin} /></label>
    <label>outer max (eV) <input data-max type="range" min="0" max="1.2" step="0.05" value={defaults.outerMax} /></label>
  </div>

  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${componentId}-title ${componentId}-desc`}>
    <title id={`${componentId}-title`}>avoided crossing 与 outer window 投影 fidelity</title>
    <desc id={`${componentId}-desc`}>上图显示两条纠缠本征能带及能量窗口，下图显示目标轨道在窗口候选空间中的投影 fidelity。</desc>
    <rect class="plot-bg" x={top.x0} y={top.y0} width={top.x1-top.x0} height={top.y1-top.y0}/>
    <rect data-window class="window" x={top.x0} y={yE(defaults.outerMax)} width={top.x1-top.x0} height={yE(defaults.outerMin)-yE(defaults.outerMax)}/>
    <path data-lower class="band lower" d={lowerPath}/><path data-upper class="band upper" d={upperPath}/>
    <line class="axis" x1={top.x0} x2={top.x1} y1={top.y1} y2={top.y1}/>
    <line class="axis" x1={top.x0} x2={top.x0} y1={top.y0} y2={top.y1}/>
    <rect class="plot-bg" x={bottom.x0} y={bottom.y0} width={bottom.x1-bottom.x0} height={bottom.y1-bottom.y0}/>
    <path data-fidelity class="fidelity" d={fidelityPath}/>
    <line class="axis" x1={bottom.x0} x2={bottom.x1} y1={bottom.y1} y2={bottom.y1}/>
    <line class="axis" x1={bottom.x0} x2={bottom.x0} y1={bottom.y0} y2={bottom.y1}/>
    <text x="435" y="28" text-anchor="middle">eigenvalues and selected energy window</text>
    <text x="435" y="298" text-anchor="middle">target-orbital projection fidelity</text>
    <text x="435" y="468" text-anchor="middle">k</text>
  </svg>

  <div class="chapter-visual__readout" aria-live="polite">
    <span>min fidelity = <output data-min-fidelity>{result.minFidelity.toFixed(3)}</output></span>
    <span>mean fidelity = <output data-mean>{result.meanFidelity.toFixed(3)}</output></span>
    <span>incomplete k points = <output data-missing>{result.missingPoints}</output> / {defaults.points}</span>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>二维 Hamiltonian 的两个裸轨道随 k 交叉并以 v 混合；目标是固定裸轨道 |a⟩。outer window 中本征态对 |a⟩ 的权重和定义 fidelity。</p>
    <p><strong>验收：</strong>窗口包含两条本征态时 fidelity=1；漏掉一条时 fidelity 等于保留态的投影权重并在 avoided crossing 附近显著下降；增大耦合扩展两态共同贡献的 k 区域。</p>
    <p><strong>边界：</strong>真实 disentanglement 还要求固定维数、k 邻接平滑性、inner/frozen window 和复合 projector 优化。本模型只隔离“候选空间必须包含目标 character”这一必要条件。</p>
  </div>

  <noscript><p><strong>无 JavaScript fallback | No-JavaScript fallback：</strong>默认 avoided crossing、outer window 和 fidelity 曲线保持可见。</p></noscript>
</figure>

<script>
  import { sampleEntangledWindow } from '../../../data/part05/ch23WannierModels.mjs';
  const root=document.getElementById('ch23-disentanglement-window');
  if(root){
    const coupling=root.querySelector('[data-coupling]');const min=root.querySelector('[data-min]');const max=root.querySelector('[data-max]');
    const lower=root.querySelector('[data-lower]');const upper=root.querySelector('[data-upper]');const fidelity=root.querySelector('[data-fidelity]');const windowRect=root.querySelector('[data-window]');
    const outputs={minFidelity:root.querySelector('[data-min-fidelity]'),mean:root.querySelector('[data-mean]'),missing:root.querySelector('[data-missing]')};
    if([coupling,min,max].every((item)=>item instanceof HTMLInputElement)&&[lower,upper,fidelity].every((item)=>item instanceof SVGPathElement)&&windowRect instanceof SVGRectElement&&Object.values(outputs).every((item)=>item instanceof HTMLOutputElement)){
      const top={x0:70,x1:800,y0:45,y1:245};const bottom={x0:70,x1:800,y0:310,y1:430};const x=(k)=>top.x0+(k+Math.PI)/(2*Math.PI)*(top.x1-top.x0);const yE=(e)=>top.y1-(e+1.1)/2.2*(top.y1-top.y0);const yF=(f)=>bottom.y1-f*(bottom.y1-bottom.y0);
      const update=()=>{
        const outerMin=Number(min.value);const outerMax=Number(max.value);if(outerMax<=outerMin)return;
        const result=sampleEntangledWindow({coupling:Number(coupling.value),outerMin,outerMax,points:161});
        lower.setAttribute('d',result.samples.map((item,index)=>`${index===0?'M':'L'} ${x(item.k)} ${yE(item.states[0].energy)}`).join(' '));
        upper.setAttribute('d',result.samples.map((item,index)=>`${index===0?'M':'L'} ${x(item.k)} ${yE(item.states[1].energy)}`).join(' '));
        fidelity.setAttribute('d',result.samples.map((item,index)=>`${index===0?'M':'L'} ${x(item.k)} ${yF(item.fidelity)}`).join(' '));
        windowRect.setAttribute('y',String(yE(outerMax)));windowRect.setAttribute('height',String(yE(outerMin)-yE(outerMax)));
        outputs.minFidelity.value=result.minFidelity.toFixed(3);outputs.mean.value=result.meanFidelity.toFixed(3);outputs.missing.value=String(result.missingPoints);
      };
      [coupling,min,max].forEach((input)=>input.addEventListener('input',update));update();
    }
  }
</script>

<style>
  .disentanglement-window{width:100%;min-width:0;max-width:100%;margin-inline:0;overflow-x:auto}.disentanglement-window svg{display:block;width:100%;min-width:42rem;height:auto}
  .plot-bg{fill:var(--sl-color-gray-7);stroke:var(--sl-color-gray-5)}.window{fill:var(--sl-color-accent-low);opacity:.4}.axis{stroke:currentColor;stroke-width:1.4}.band{fill:none;stroke-width:2.6}.lower{stroke:var(--sl-color-accent-high)}.upper{stroke:var(--sl-color-gray-3)}.fidelity{fill:none;stroke:var(--sl-color-accent-high);stroke-width:3}text{fill:currentColor;font-size:14px}
</style>
