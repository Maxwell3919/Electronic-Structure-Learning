---
import { sampleSpinorOverlapLoop } from '../../../data/part05/ch23OverlapModels.mjs';

const componentId = 'ch23-overlap-branch';
const defaults = { kPoints: 32, polarAngle: 1.1, physicalWinding: 1, gaugeWinding: 0 };
const result = sampleSpinorOverlapLoop(defaults);
const width = 840;
const height = 390;
const plot = { x0: 70, x1: 790, y0: 45, y1: 285 };
const x = (index) => plot.x0 + index / (defaults.kPoints - 1) * (plot.x1 - plot.x0);
const yMag = (value) => plot.y1 - value * (plot.y1 - plot.y0);
const magPath = result.overlaps.map((item,index)=>`${index===0?'M':'L'} ${x(index)} ${yMag(item.magnitude)}`).join(' ');
---

<figure class="chapter-visual overlap-branch" id={componentId}>
  <figcaption>
    <strong>离散 overlap、中心 branch 与 gauge winding | Discrete overlaps, centre branch, and gauge winding</strong>
    <span>原创两分量 spinor 环路：overlap 模长给出 gauge-invariant 距离，phase sum 记录中心的 lattice branch。</span>
    <span lang="en">Original two-component spinor loop: overlap magnitudes give a gauge-invariant distance, while the phase sum tracks the lattice branch of the centre.</span>
  </figcaption>

  <div class="chapter-visual__controls">
    <label>k 点数 N<sub>k</sub> <input data-kpoints type="range" min="16" max="128" step="16" value={defaults.kPoints} /></label>
    <label>spinor 极角 θ <input data-polar type="range" min="0.2" max="2.8" step="0.05" value={defaults.polarAngle} /></label>
    <label>gauge winding g <input data-gauge type="range" min="-3" max="3" step="1" value={defaults.gaugeWinding} /></label>
  </div>

  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${componentId}-title ${componentId}-desc`}>
    <title id={`${componentId}-title`}>相邻 k 点 overlap 模长与中心分支</title>
    <desc id={`${componentId}-desc`}>曲线显示沿闭合 k 环路的相邻态重叠模长，读数比较 principal centre 与 unwrapped branch。</desc>
    <rect class="plot-bg" x={plot.x0} y={plot.y0} width={plot.x1-plot.x0} height={plot.y1-plot.y0} />
    <line class="axis" x1={plot.x0} x2={plot.x1} y1={plot.y1} y2={plot.y1} />
    <line class="axis" x1={plot.x0} x2={plot.x0} y1={plot.y0} y2={plot.y1} />
    <path data-magnitude class="magnitude-path" d={magPath} />
    <text x={(plot.x0+plot.x1)/2} y="325" text-anchor="middle">link index along closed k loop</text>
    <text transform={`translate(22 ${(plot.y0+plot.y1)/2}) rotate(-90)`} text-anchor="middle">|M(k,b)|</text>
  </svg>

  <div class="chapter-visual__readout" aria-live="polite">
    <span>centre mod lattice = <output data-modulo>{result.centerModulo.toFixed(4)}</output></span>
    <span>unwrapped centre = <output data-unwrapped>{result.centerUnwrapped.toFixed(4)}</output></span>
    <span>Σ(1−|M|²) = <output data-metric>{result.invariantMetric.toFixed(5)}</output></span>
    <span>min |M| = <output data-min>{result.minOverlap.toFixed(5)}</output></span>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>cell-periodic spinor 为 [cos(θ/2), sin(θ/2)e^(ik)]，再乘整数 gauge phase e^(igk)；相邻 link overlap 构成闭合乘积。</p>
    <p><strong>验收：</strong>改变整数 g 时 principal centre modulo lattice 与 Σ(1−|M|²) 不变，unwrapped centre 改变整数；增加 N_k 时 min |M|→1、离散 metric 收敛。</p>
    <p><strong>边界：</strong>principal complex log 丢弃整数 branch；比较极化或中心运动必须跟踪连续 branch。该一维单占据 spinor 不构成多带拓扑分类。</p>
  </div>

  <noscript><p><strong>无 JavaScript fallback | No-JavaScript fallback：</strong>默认 overlap 曲线、principal/unwrapped 中心和验收条件保持可见。</p></noscript>
</figure>

<script>
  import { sampleSpinorOverlapLoop } from '../../../data/part05/ch23OverlapModels.mjs';
  const root=document.getElementById('ch23-overlap-branch');
  if(root){
    const kpoints=root.querySelector('[data-kpoints]'); const polar=root.querySelector('[data-polar]'); const gauge=root.querySelector('[data-gauge]');
    const curve=root.querySelector('[data-magnitude]');
    const outputs={modulo:root.querySelector('[data-modulo]'),unwrapped:root.querySelector('[data-unwrapped]'),metric:root.querySelector('[data-metric]'),min:root.querySelector('[data-min]')};
    if([kpoints,polar,gauge].every((item)=>item instanceof HTMLInputElement)&&curve instanceof SVGPathElement&&Object.values(outputs).every((item)=>item instanceof HTMLOutputElement)){
      const plot={x0:70,x1:790,y0:45,y1:285};
      const update=()=>{
        const result=sampleSpinorOverlapLoop({kPoints:Number(kpoints.value),polarAngle:Number(polar.value),physicalWinding:1,gaugeWinding:Number(gauge.value)});
        const x=(index)=>plot.x0+index/(result.overlaps.length-1)*(plot.x1-plot.x0); const y=(value)=>plot.y1-value*(plot.y1-plot.y0);
        curve.setAttribute('d',result.overlaps.map((item,index)=>`${index===0?'M':'L'} ${x(index)} ${y(item.magnitude)}`).join(' '));
        outputs.modulo.value=result.centerModulo.toFixed(4); outputs.unwrapped.value=result.centerUnwrapped.toFixed(4);
        outputs.metric.value=result.invariantMetric.toFixed(5); outputs.min.value=result.minOverlap.toFixed(5);
      };
      [kpoints,polar,gauge].forEach((input)=>input.addEventListener('input',update)); update();
    }
  }
</script>

<style>
  .overlap-branch{width:100%;min-width:0;max-width:100%;margin-inline:0;overflow-x:auto}
  .overlap-branch svg{display:block;width:100%;min-width:40rem;height:auto}
  .plot-bg{fill:var(--sl-color-gray-7);stroke:var(--sl-color-gray-5)}
  .axis{stroke:currentColor;stroke-width:1.4}
  .magnitude-path{fill:none;stroke:var(--sl-color-accent-high);stroke-width:3}
  text{fill:currentColor;font-size:14px}
</style>
