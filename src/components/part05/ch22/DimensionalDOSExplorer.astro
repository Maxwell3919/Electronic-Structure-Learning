---
import { sampleDimensionalDOS } from '../../../data/part05/ch22TeachingModels.mjs';

const componentId = 'ch22-dimensional-dos';
const defaults = { edge: 0, broadening: 0.03, energyMin: -0.08, energyMax: 1, points: 241 };
const sample = sampleDimensionalDOS(defaults);
const width = 840;
const height = 410;
const pad = { left: 72, right: 28, top: 36, bottom: 66 };
const xScale = (energy) => pad.left + (energy - defaults.energyMin) / (defaults.energyMax - defaults.energyMin) * (width - pad.left - pad.right);
const maxDos = Math.max(...sample.flatMap((item) => [item.dos1d, item.dos2d, item.dos3d]));
const yScale = (value) => height - pad.bottom - value / maxDos * (height - pad.top - pad.bottom);
const makePath = (key) => sample.map((item, index) => `${index === 0 ? 'M' : 'L'} ${xScale(item.energy).toFixed(2)} ${yScale(item[key]).toFixed(2)}`).join(' ');
---

<figure class="chapter-visual dimensional-dos" id={componentId}>
  <figcaption>
    <strong>抛物带边的 1D/2D/3D 态密度 | 1D/2D/3D density of states at a parabolic band edge</strong>
    <span>原创教学模型：同一抛物色散在不同维度产生发散、台阶和平方根起始。</span>
    <span lang="en">Original teaching model: the same parabolic dispersion produces a divergence, a step, or a square-root onset depending on dimensionality.</span>
  </figcaption>

  <div class="chapter-visual__controls">
    <label>展宽 η (eV) <input data-broadening type="range" min="0.005" max="0.12" step="0.005" value={defaults.broadening} /></label>
    <label>带边 E₀ (eV) <input data-edge type="range" min="-0.2" max="0.2" step="0.01" value={defaults.edge} /></label>
  </div>

  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${componentId}-title ${componentId}-desc`}>
    <title id={`${componentId}-title`}>不同维度的理想抛物带态密度</title>
    <desc id={`${componentId}-desc`}>一维曲线在带边附近增大，二维曲线呈台阶，三维曲线从零按平方根增加。</desc>
    <rect x={pad.left} y={pad.top} width={width - pad.left - pad.right} height={height - pad.top - pad.bottom} class="plot-bg" />
    <line class="axis" x1={pad.left} x2={width - pad.right} y1={height - pad.bottom} y2={height - pad.bottom} />
    <line class="axis" x1={pad.left} x2={pad.left} y1={pad.top} y2={height - pad.bottom} />
    <path data-dos1d d={makePath('dos1d')} class="dos dos-1d" />
    <path data-dos2d d={makePath('dos2d')} class="dos dos-2d" />
    <path data-dos3d d={makePath('dos3d')} class="dos dos-3d" />
    <line data-edge-line x1={xScale(defaults.edge)} x2={xScale(defaults.edge)} y1={pad.top} y2={height - pad.bottom} class="edge-line" />
    <text x="170" y="65">1D: (E−E₀)⁻¹ᐟ²</text>
    <text x="390" y="95">2D: constant step</text>
    <text x="590" y="145">3D: (E−E₀)¹ᐟ²</text>
    <text x={(pad.left + width - pad.right) / 2} y={height - 16} text-anchor="middle">energy E (eV)</text>
    <text transform={`translate(22 ${(pad.top + height - pad.bottom) / 2}) rotate(-90)`} text-anchor="middle">DOS (arbitrary normalized units)</text>
  </svg>

  <div class="chapter-visual__readout" aria-live="polite">
    <span>η = <output data-eta>{defaults.broadening.toFixed(3)}</output> eV</span>
    <span>E₀ = <output data-edge-output>{defaults.edge.toFixed(2)}</output> eV</span>
    <span>1D peak proxy = <output data-peak>{maxDos.toFixed(2)}</output></span>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>各向同性抛物带 E=E₀+ℏ²k²/2m，忽略简并和常数前因子；数值展宽用 η 限制带边奇异性。</p>
    <p><strong>验收：</strong>减小 η 时 1D 带边峰增大，2D 台阶高度保持有限，3D 在带边从零上升；移动 E₀ 只应平移三条曲线。</p>
    <p><strong>边界：</strong>真实低维材料可有多谷、非抛物色散、van Hove 奇点、SOC、相互作用和有限温度。超胞 DOS 的“每体积”归一化依赖真空，不是二维或一维内禀单位。</p>
  </div>

  <noscript><p><strong>无 JavaScript fallback | No-JavaScript fallback：</strong>默认 η=0.03 eV 的三条静态曲线、公式标签和模型边界保持可见。</p></noscript>
</figure>

<script>
  import { sampleDimensionalDOS } from '../../../data/part05/ch22TeachingModels.mjs';
  const root = document.getElementById('ch22-dimensional-dos');
  if (root) {
    const broadening = root.querySelector('[data-broadening]');
    const edge = root.querySelector('[data-edge]');
    const path1 = root.querySelector('[data-dos1d]');
    const path2 = root.querySelector('[data-dos2d]');
    const path3 = root.querySelector('[data-dos3d]');
    const edgeLine = root.querySelector('[data-edge-line]');
    const etaOutput = root.querySelector('[data-eta]');
    const edgeOutput = root.querySelector('[data-edge-output]');
    const peakOutput = root.querySelector('[data-peak]');
    if (broadening instanceof HTMLInputElement && edge instanceof HTMLInputElement
      && [path1, path2, path3].every((item) => item instanceof SVGPathElement)
      && edgeLine instanceof SVGLineElement
      && [etaOutput, edgeOutput, peakOutput].every((item) => item instanceof HTMLOutputElement)) {
      const width = 840; const height = 410; const pad = { left: 72, right: 28, top: 36, bottom: 66 };
      const energyMin = -0.28; const energyMax = 1;
      const update = () => {
        const params = { edge: Number(edge.value), broadening: Number(broadening.value), energyMin, energyMax, points: 241 };
        const sample = sampleDimensionalDOS(params);
        const maxDos = Math.max(...sample.flatMap((item) => [item.dos1d, item.dos2d, item.dos3d]));
        const xScale = (energy) => pad.left + (energy - energyMin) / (energyMax - energyMin) * (width - pad.left - pad.right);
        const yScale = (value) => height - pad.bottom - value / maxDos * (height - pad.top - pad.bottom);
        const makePath = (key) => sample.map((item, index) => `${index === 0 ? 'M' : 'L'} ${xScale(item.energy).toFixed(2)} ${yScale(item[key]).toFixed(2)}`).join(' ');
        path1.setAttribute('d', makePath('dos1d')); path2.setAttribute('d', makePath('dos2d')); path3.setAttribute('d', makePath('dos3d'));
        edgeLine.setAttribute('x1', String(xScale(params.edge))); edgeLine.setAttribute('x2', String(xScale(params.edge)));
        etaOutput.value = params.broadening.toFixed(3); edgeOutput.value = params.edge.toFixed(2); peakOutput.value = maxDos.toFixed(2);
      };
      [broadening, edge].forEach((input) => input.addEventListener('input', update)); update();
    }
  }
</script>

<style>
  .dimensional-dos { width: 100%; min-width: 0; max-width: 100%; margin-inline: 0; overflow-x: auto; }
  .dimensional-dos svg { display: block; width: 100%; min-width: 38rem; height: auto; }
  .plot-bg { fill: var(--sl-color-gray-7); stroke: var(--sl-color-gray-5); }
  .axis { stroke: currentColor; stroke-width: 1.5; }
  .dos { fill: none; stroke-width: 3.2; }
  .dos-1d { stroke: var(--sl-color-accent-high); }
  .dos-2d { stroke: currentColor; stroke-dasharray: 8 5; }
  .dos-3d { stroke: var(--sl-color-gray-3); stroke-dasharray: 3 4; }
  .edge-line { stroke: var(--sl-color-accent); stroke-width: 1.5; stroke-dasharray: 4 4; }
  text { fill: currentColor; font-size: 14px; }
</style>
