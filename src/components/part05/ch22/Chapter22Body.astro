---
import Chapter22OrientationAndTerms from './Chapter22OrientationAndTerms.mdx';
import Chapter22SourceMap from './Chapter22SourceMap.astro';
import Chapter22ElectrostaticsSlabs from './Chapter22ElectrostaticsSlabs.mdx';
import Chapter22SurfaceStates from './Chapter22SurfaceStates.mdx';
import Chapter22Interfaces from './Chapter22Interfaces.mdx';
import Chapter22LowDimensional from './Chapter22LowDimensional.mdx';
import Chapter22Closing from './Chapter22Closing.mdx';
---

<div class="chapter22-root">
  <Chapter22OrientationAndTerms />
  <Chapter22SourceMap />
  <Chapter22ElectrostaticsSlabs />
  <Chapter22SurfaceStates />
  <Chapter22Interfaces />
  <Chapter22LowDimensional />
  <Chapter22Closing />
</div>

<style is:global>
  .chapter22-root,
  .chapter22-root > *,
  .chapter22-root .bilingual-section,
  .chapter22-root .bilingual-section__grid,
  .chapter22-root .bilingual-section__zh,
  .chapter22-root .bilingual-section__en,
  .chapter22-root .bilingual-callout,
  .chapter22-root .derivation-block,
  .chapter22-root .chapter-visual {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .chapter22-root .chapter-visual {
    width: 100%;
    margin-inline: 0;
  }

  .chapter22-root .chapter-source-map,
  .chapter22-root .katex-display,
  .chapter22-root pre {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .chapter22-root p,
  .chapter22-root li,
  .chapter22-root th,
  .chapter22-root td {
    overflow-wrap: anywhere;
  }

  .chapter22-anchor {
    display: block;
    position: relative;
    top: -5rem;
    visibility: hidden;
  }
</style>
