---
import { slabWorkFunction } from '../../../data/part05/ch22TeachingModels.mjs';

const componentId = 'ch22-slab-work-function';
const width = 820;
const height = 340;
const pad = { left: 66, right: 28, top: 28, bottom: 56 };
const defaults = { bulkReference: -8, fermiEnergy: -5, leftDipole: 2.2, rightDipole: 2.2, vacuumThickness: 18 };
const result = slabWorkFunction(defaults);
const yMin = -8.8;
const yMax = -4.8;
const xScale = (z) => pad.left + z / result.length * (width - pad.left - pad.right);
const yScale = (value) => pad.top + (yMax - value) / (yMax - yMin) * (height - pad.top - pad.bottom);
const points = result.profile.map(({ z, potential }) => `${xScale(z).toFixed(2)},${yScale(potential).toFixed(2)}`).join(' ');
---

<figure class="chapter-visual slab-work-function" id={componentId}>
  <figcaption>
    <strong>周期 slab、真空平台与功函数 | Periodic slab, vacuum plateaus, and work function</strong>
    <span>原创教学模型：改变两侧表面偶极和真空厚度，区分对称 slab 的平台与非对称 slab 的残余场。</span>
    <span lang="en">Original teaching model: vary the two surface dipoles and the vacuum thickness to distinguish a symmetric-slab plateau from an asymmetric-slab residual field.</span>
  </figcaption>

  <div class="chapter-visual__controls">
    <label>左表面偶极步 ΔV<sub>L</sub> (eV) <input data-left type="range" min="0.5" max="4" step="0.1" value={defaults.leftDipole} /></label>
    <label>右表面偶极步 ΔV<sub>R</sub> (eV) <input data-right type="range" min="0.5" max="4" step="0.1" value={defaults.rightDipole} /></label>
    <label>真空厚度 L<sub>vac</sub> (Å) <input data-vacuum type="range" min="8" max="35" step="1" value={defaults.vacuumThickness} /></label>
    <label>费米能 E<sub>F</sub> (eV) <input data-fermi type="range" min="-6.5" max="-3.5" step="0.1" value={defaults.fermiEnergy} /></label>
  </div>

  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${componentId}-title ${componentId}-desc`}>
    <title id={`${componentId}-title`}>沿 slab 法向的平面平均势与费米能</title>
    <desc id={`${componentId}-desc`}>中央区域为 slab，两侧为真空。对称偶极产生相同平台，非对称偶极在周期真空中产生模型残余斜率。</desc>
    <rect data-slab-region class="slab-region" x={xScale(result.leftSurface)} y={pad.top} width={xScale(result.rightSurface) - xScale(result.leftSurface)} height={height - pad.top - pad.bottom} />
    <line class="axis" x1={pad.left} y1={height - pad.bottom} x2={width - pad.right} y2={height - pad.bottom} />
    <line class="axis" x1={pad.left} y1={pad.top} x2={pad.left} y2={height - pad.bottom} />
    <polyline data-potential class="potential-curve" points={points} />
    <line data-fermi-line class="fermi-line" x1={pad.left} x2={width - pad.right} y1={yScale(defaults.fermiEnergy)} y2={yScale(defaults.fermiEnergy)} />
    <text x={(pad.left + width - pad.right) / 2} y={height - 12} text-anchor="middle">surface-normal coordinate z (Å)</text>
    <text transform={`translate(18 ${(height + pad.top - pad.bottom) / 2}) rotate(-90)`} text-anchor="middle">electron potential energy (eV)</text>
    <text data-left-label x={pad.left + 12} y={pad.top + 20}>left vacuum</text>
    <text data-right-label x={width - pad.right - 12} y={pad.top + 20} text-anchor="end">right vacuum</text>
    <text x={(xScale(result.leftSurface) + xScale(result.rightSurface)) / 2} y={pad.top + 20} text-anchor="middle">slab</text>
  </svg>

  <div class="chapter-visual__readout" aria-live="polite">
    <span>V<sub>vac,L</sub> = <output data-left-vac>{result.leftVacuum.toFixed(2)}</output> eV</span>
    <span>V<sub>vac,R</sub> = <output data-right-vac>{result.rightVacuum.toFixed(2)}</output> eV</span>
    <span>Φ<sub>L</sub> = <output data-left-phi>{result.leftWorkFunction.toFixed(2)}</output> eV</span>
    <span>Φ<sub>R</sub> = <output data-right-phi>{result.rightWorkFunction.toFixed(2)}</output> eV</span>
    <span>残余场 = <output data-field>{result.residualField.toFixed(4)}</output> eV/Å</span>
    <span data-state>{result.symmetric ? '对称 slab：两侧平台一致' : '非对称 slab：存在模型残余场'}</span>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>体内参考固定为 −8 eV；两侧表面偶极分别把真空能级抬高 ΔV<sub>L/R</sub>。非对称偶极在周期超胞中以线性残余场表示，未模拟真实自洽电荷。</p>
    <p><strong>验收：</strong>ΔV<sub>L</sub>=ΔV<sub>R</sub> 时残余场严格为零且 Φ<sub>L</sub>=Φ<sub>R</sub>；固定偶极差时增加真空厚度使场幅值按 1/L<sub>vac</sub> 减小；移动 E<sub>F</sub> 只改变功函数，不改变势剖面。</p>
    <p><strong>边界：</strong>该模型不替代平面/宏观平均、自洽 dipole correction、slab 厚度收敛、真空平台检查或真实表面电荷密度。一个“看似平坦”的局部区间也不能单独证明功函数收敛。</p>
  </div>

  <noscript><p><strong>无 JavaScript fallback | No-JavaScript fallback：</strong>默认对称 slab 曲线、读数与验收条件仍可见；滑块不更新。</p></noscript>
</figure>

<script>
  import { slabWorkFunction } from '../../../data/part05/ch22TeachingModels.mjs';
  const root = document.getElementById('ch22-slab-work-function');
  if (root) {
    const left = root.querySelector('[data-left]'); const right = root.querySelector('[data-right]');
    const vacuum = root.querySelector('[data-vacuum]'); const fermi = root.querySelector('[data-fermi]');
    const curve = root.querySelector('[data-potential]'); const fermiLine = root.querySelector('[data-fermi-line]');
    const slabRegion = root.querySelector('[data-slab-region]'); const state = root.querySelector('[data-state]');
    const outputs = {
      leftVac: root.querySelector('[data-left-vac]'), rightVac: root.querySelector('[data-right-vac]'),
      leftPhi: root.querySelector('[data-left-phi]'), rightPhi: root.querySelector('[data-right-phi]'), field: root.querySelector('[data-field]'),
    };
    if ([left, right, vacuum, fermi].every((item) => item instanceof HTMLInputElement)
      && curve instanceof SVGPolylineElement && fermiLine instanceof SVGLineElement
      && slabRegion instanceof SVGRectElement && state instanceof HTMLElement
      && Object.values(outputs).every((item) => item instanceof HTMLOutputElement)) {
      const width = 820; const height = 340; const pad = { left: 66, right: 28, top: 28, bottom: 56 };
      const yMin = -8.8; const yMax = -4.8;
      const yScale = (value) => pad.top + (yMax - value) / (yMax - yMin) * (height - pad.top - pad.bottom);
      const update = () => {
        const params = {
          bulkReference: -8,
          leftDipole: Number(left.value), rightDipole: Number(right.value),
          vacuumThickness: Number(vacuum.value), fermiEnergy: Number(fermi.value),
        };
        const result = slabWorkFunction(params);
        const xScale = (z) => pad.left + z / result.length * (width - pad.left - pad.right);
        curve.setAttribute('points', result.profile.map(({ z, potential }) => `${xScale(z).toFixed(2)},${yScale(potential).toFixed(2)}`).join(' '));
        fermiLine.setAttribute('y1', String(yScale(params.fermiEnergy))); fermiLine.setAttribute('y2', String(yScale(params.fermiEnergy)));
        slabRegion.setAttribute('x', String(xScale(result.leftSurface)));
        slabRegion.setAttribute('width', String(xScale(result.rightSurface) - xScale(result.leftSurface)));
        outputs.leftVac.value = result.leftVacuum.toFixed(2); outputs.rightVac.value = result.rightVacuum.toFixed(2);
        outputs.leftPhi.value = result.leftWorkFunction.toFixed(2); outputs.rightPhi.value = result.rightWorkFunction.toFixed(2);
        outputs.field.value = result.residualField.toFixed(4);
        state.textContent = result.symmetric ? '对称 slab：两侧平台一致' : '非对称 slab：存在模型残余场';
      };
      [left, right, vacuum, fermi].forEach((input) => input.addEventListener('input', update)); update();
    }
  }
</script>

<style>
  .slab-work-function { width: 100%; min-width: 0; max-width: 100%; margin-inline: 0; overflow-x: auto; }
  .slab-work-function svg { display: block; width: 100%; min-width: 38rem; height: auto; }
  .axis { stroke: currentColor; stroke-width: 1.4; }
  .slab-region { fill: var(--sl-color-gray-6); }
  .potential-curve { fill: none; stroke: var(--sl-color-accent-high); stroke-width: 2.6; }
  .fermi-line { stroke: currentColor; stroke-dasharray: 7 5; stroke-width: 1.8; }
  text { fill: currentColor; font-size: 14px; }
</style>
