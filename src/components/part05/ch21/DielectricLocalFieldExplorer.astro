---
import { dielectricLocalFieldModel } from '../../../data/part05/ch21OpticalModels.mjs';

const componentId = 'ch21-dielectric-local-field';
const width = 780;
const height = 350;
const defaults = { head: 8, wing: 2, body: 5 };
const result = dielectricLocalFieldModel(defaults);
const leftBase = 300;
const leftScale = 220 / Math.max(result.bareHead, result.macroscopic);
const rightScale = 220 / Math.max(result.naiveInverseHead, result.inverse00);
---

<figure class="chapter-visual dielectric-local-field" id={componentId}>
  <figcaption>
    <strong>微观介电矩阵与宏观局域场修正 | Microscopic dielectric matrix and macroscopic local-field correction</strong>
    <span>原创 2×2 模型：比较先取 head 再求倒数与先求整个介电矩阵的逆再提取宏观分量。</span>
    <span lang="en">Original 2×2 model: compare inverting the head alone with inverting the full dielectric matrix before extracting the macroscopic component.</span>
  </figcaption>

  <div class="chapter-visual__controls">
    <label>
      head ε₀₀
      <input data-head type="range" min="5" max="12" step="0.1" value={defaults.head} />
    </label>
    <label>
      wing ε₀G
      <input data-wing type="range" min="0" max="3.5" step="0.1" value={defaults.wing} />
    </label>
    <label>
      body εGG
      <input data-body type="range" min="3" max="10" step="0.1" value={defaults.body} />
    </label>
  </div>

  <div class="dielectric-matrix" aria-label="Current two by two microscopic dielectric matrix">
    <span>ε =</span>
    <span class="matrix-bracket">[</span>
    <span class="matrix-values">
      <output data-matrix-head>{defaults.head.toFixed(1)}</output>
      <output data-matrix-wing-a>{defaults.wing.toFixed(1)}</output>
      <output data-matrix-wing-b>{defaults.wing.toFixed(1)}</output>
      <output data-matrix-body>{defaults.body.toFixed(1)}</output>
    </span>
    <span class="matrix-bracket">]</span>
  </div>

  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${componentId}-title ${componentId}-desc`}>
    <title id={`${componentId}-title`}>介电 head、宏观介电量和逆矩阵 head 的比较</title>
    <desc id={`${componentId}-desc`}>左侧比较裸 head 与包含局域场后的宏观介电量，右侧比较 head 的简单倒数与完整逆矩阵的零零分量。</desc>
    <line class="axis" x1="55" y1={leftBase} x2="355" y2={leftBase} />
    <line class="axis" x1="425" y1={leftBase} x2="725" y2={leftBase} />
    <rect class="bar bar--plain" data-bare x="105" y={leftBase - result.bareHead * leftScale} width="80" height={result.bareHead * leftScale} />
    <rect class="bar bar--corrected" data-macro x="225" y={leftBase - result.macroscopic * leftScale} width="80" height={result.macroscopic * leftScale} />
    <rect class="bar bar--plain" data-naive x="475" y={leftBase - result.naiveInverseHead * rightScale} width="80" height={result.naiveInverseHead * rightScale} />
    <rect class="bar bar--corrected" data-inverse x="595" y={leftBase - result.inverse00 * rightScale} width="80" height={result.inverse00 * rightScale} />
    <text x="145" y="325" text-anchor="middle">ε₀₀</text>
    <text x="265" y="325" text-anchor="middle">ε_M</text>
    <text x="515" y="325" text-anchor="middle">1/ε₀₀</text>
    <text x="635" y="325" text-anchor="middle">(ε⁻¹)₀₀</text>
    <text x="205" y="30" text-anchor="middle">dielectric quantities</text>
    <text x="575" y="30" text-anchor="middle">inverse quantities</text>
    <text class="bar-value" data-bare-label x="145" y={leftBase - result.bareHead * leftScale - 8} text-anchor="middle">{result.bareHead.toFixed(3)}</text>
    <text class="bar-value" data-macro-label x="265" y={leftBase - result.macroscopic * leftScale - 8} text-anchor="middle">{result.macroscopic.toFixed(3)}</text>
    <text class="bar-value" data-naive-label x="515" y={leftBase - result.naiveInverseHead * rightScale - 8} text-anchor="middle">{result.naiveInverseHead.toFixed(4)}</text>
    <text class="bar-value" data-inverse-label x="635" y={leftBase - result.inverse00 * rightScale - 8} text-anchor="middle">{result.inverse00.toFixed(4)}</text>
  </svg>

  <div class="chapter-visual__readout" aria-live="polite">
    <span>det ε = <output data-determinant>{result.determinant.toFixed(3)}</output></span>
    <span>ε<sub>M</sub> = <output data-macro-output>{result.macroscopic.toFixed(3)}</output></span>
    <span>local-field shift = <output data-correction>{result.localFieldCorrection.toFixed(3)}</output></span>
    <span>1/ε₀₀ = <output data-naive-output>{result.naiveInverseHead.toFixed(4)}</output></span>
    <span>(ε⁻¹)₀₀ = <output data-inverse-output>{result.inverse00.toFixed(4)}</output></span>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>$\epsilon=\begin{pmatrix}a&b\\b&d\end{pmatrix}$，$\epsilon_M=1/(\epsilon^{-1})_{00}=a-b^2/d$。索引 0 代表 macroscopic head，第二分量代表一个 microscopic reciprocal vector。</p>
    <p><strong>验收：</strong>$b=0$ 时 $\epsilon_M=\epsilon_{00}$ 且 $(\epsilon^{-1})_{00}=1/\epsilon_{00}$；非零 wing 时必须先求完整逆矩阵；输入范围保持正 determinant；解析逆矩阵乘原矩阵得到 identity。</p>
    <p><strong>边界：</strong>真实介电矩阵含许多 $G,G'$、复频率结构、晶体方向和 $q\to0$ 极限。该图只验证矩阵运算顺序，不预测任何材料的 dielectric constant。</p>
  </div>

  <noscript>
    <p><strong>无 JavaScript fallback | No-JavaScript fallback：</strong>默认 ε₀₀=8、ε₀G=2、εGG=5 的矩阵、四个柱和局域场读数仍可见；控件不更新。</p>
  </noscript>
</figure>

<script>
  import { dielectricLocalFieldModel } from '../../../data/part05/ch21OpticalModels.mjs';

  const root = document.getElementById('ch21-dielectric-local-field');
  if (root) {
    const headInput = root.querySelector('[data-head]');
    const wingInput = root.querySelector('[data-wing]');
    const bodyInput = root.querySelector('[data-body]');
    const matrixHead = root.querySelector('[data-matrix-head]');
    const matrixWingA = root.querySelector('[data-matrix-wing-a]');
    const matrixWingB = root.querySelector('[data-matrix-wing-b]');
    const matrixBody = root.querySelector('[data-matrix-body]');
    const bareBar = root.querySelector('[data-bare]');
    const macroBar = root.querySelector('[data-macro]');
    const naiveBar = root.querySelector('[data-naive]');
    const inverseBar = root.querySelector('[data-inverse]');
    const bareLabel = root.querySelector('[data-bare-label]');
    const macroLabel = root.querySelector('[data-macro-label]');
    const naiveLabel = root.querySelector('[data-naive-label]');
    const inverseLabel = root.querySelector('[data-inverse-label]');
    const determinantOutput = root.querySelector('[data-determinant]');
    const macroOutput = root.querySelector('[data-macro-output]');
    const correctionOutput = root.querySelector('[data-correction]');
    const naiveOutput = root.querySelector('[data-naive-output]');
    const inverseOutput = root.querySelector('[data-inverse-output]');

    const outputs = [matrixHead, matrixWingA, matrixWingB, matrixBody, determinantOutput, macroOutput, correctionOutput, naiveOutput, inverseOutput];
    const bars = [bareBar, macroBar, naiveBar, inverseBar];
    const labels = [bareLabel, macroLabel, naiveLabel, inverseLabel];

    if (
      headInput instanceof HTMLInputElement
      && wingInput instanceof HTMLInputElement
      && bodyInput instanceof HTMLInputElement
      && outputs.every((item) => item instanceof HTMLOutputElement)
      && bars.every((item) => item instanceof SVGRectElement)
      && labels.every((item) => item instanceof SVGTextElement)
    ) {
      const leftBase = 300;
      const setBar = (bar, label, value, scale, digits) => {
        const height = value * scale;
        bar.setAttribute('y', String(leftBase - height));
        bar.setAttribute('height', String(height));
        label.setAttribute('y', String(leftBase - height - 8));
        label.textContent = value.toFixed(digits);
      };

      const update = () => {
        const head = Number(headInput.value);
        const wing = Number(wingInput.value);
        const body = Number(bodyInput.value);
        const result = dielectricLocalFieldModel({ head, wing, body });
        const leftScale = 220 / Math.max(result.bareHead, result.macroscopic);
        const rightScale = 220 / Math.max(result.naiveInverseHead, result.inverse00);

        matrixHead.value = head.toFixed(1);
        matrixWingA.value = wing.toFixed(1);
        matrixWingB.value = wing.toFixed(1);
        matrixBody.value = body.toFixed(1);
        setBar(bareBar, bareLabel, result.bareHead, leftScale, 3);
        setBar(macroBar, macroLabel, result.macroscopic, leftScale, 3);
        setBar(naiveBar, naiveLabel, result.naiveInverseHead, rightScale, 4);
        setBar(inverseBar, inverseLabel, result.inverse00, rightScale, 4);
        determinantOutput.value = result.determinant.toFixed(3);
        macroOutput.value = result.macroscopic.toFixed(3);
        correctionOutput.value = result.localFieldCorrection.toFixed(3);
        naiveOutput.value = result.naiveInverseHead.toFixed(4);
        inverseOutput.value = result.inverse00.toFixed(4);
      };

      headInput.addEventListener('input', update);
      wingInput.addEventListener('input', update);
      bodyInput.addEventListener('input', update);
      update();
    }
  }
</script>

<style>
  .dielectric-local-field {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin-inline: 0;
    overflow-x: auto;
  }

  .dielectric-local-field svg {
    display: block;
    width: 100%;
    min-width: 36rem;
    height: auto;
  }

  .dielectric-matrix {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin-block: 0.75rem;
    font-family: var(--__sl-font-mono);
  }

  .matrix-bracket {
    font-size: 3.6rem;
    line-height: 1;
  }

  .matrix-values {
    display: grid;
    grid-template-columns: repeat(2, minmax(3.2rem, auto));
    gap: 0.2rem 0.8rem;
    text-align: center;
  }

  .axis {
    stroke: currentColor;
    stroke-width: 1.3;
  }

  .bar--plain {
    fill: currentColor;
  }

  .bar--corrected {
    fill: var(--sl-color-accent-high);
  }

  text {
    fill: currentColor;
    font-size: 14px;
  }

  .bar-value {
    font-weight: 600;
  }
</style>
