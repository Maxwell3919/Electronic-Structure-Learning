---
import {
  excitonTransitionModel,
  sampleExcitonAttractionScan,
} from '../../../data/part05/ch21OpticalModels.mjs';

const componentId = 'ch21-exciton-binding';
const width = 780;
const height = 370;
const pad = { left: 66, right: 30, top: 30, bottom: 60 };
const defaults = {
  continuumEdge: 6,
  attraction: 0.8,
  channelRatio: 0.7,
  maxAttraction: 2.5,
};
const scan = sampleExcitonAttractionScan({
  continuumEdge: defaults.continuumEdge,
  channelRatio: defaults.channelRatio,
  maxAttraction: defaults.maxAttraction,
  points: 201,
});
const current = excitonTransitionModel(defaults);
const energyMin = Math.min(...scan.map((point) => point.lower.energy), defaults.continuumEdge) - 0.25;
const energyMax = Math.max(...scan.map((point) => point.upper.energy)) + 0.25;
const xScale = (attraction) => pad.left
  + attraction / defaults.maxAttraction * (width - pad.left - pad.right);
const yScale = (energy) => pad.top
  + (energyMax - energy) / (energyMax - energyMin) * (height - pad.top - pad.bottom);
const lowerPoints = scan.map((point) => `${xScale(point.attraction).toFixed(2)},${yScale(point.lower.energy).toFixed(2)}`).join(' ');
const upperPoints = scan.map((point) => `${xScale(point.attraction).toFixed(2)},${yScale(point.upper.energy).toFixed(2)}`).join(' ');
const radius = (strength) => 4 + 6 * Math.sqrt(strength / Math.max(current.totalStrength, 1e-12));
---

<figure class="chapter-visual exciton-binding" id={componentId}>
  <figcaption>
    <strong>起始 continuum、吸引 kernel 与 bound pole | Starting continuum, attractive kernel, and a bound pole</strong>
    <span>原创二跃迁有效模型：把起始 continuum edge 与吸引强度分开，观察最低中性极点何时落到 edge 以下。</span>
    <span lang="en">Original two-transition effective model: separate the starting continuum edge from the attractive interaction and observe when the lowest neutral pole falls below the edge.</span>
  </figcaption>

  <div class="chapter-visual__controls">
    <label>
      起始 continuum edge E<sub>g</sub>
      <input data-edge type="range" min="4" max="9" step="0.1" value={defaults.continuumEdge} />
    </label>
    <label>
      吸引强度 g
      <input data-attraction type="range" min="0" max={defaults.maxAttraction} step="0.05" value={defaults.attraction} />
    </label>
    <label>
      channel ratio u₂/u₁
      <input data-ratio type="range" min="0.1" max="1.5" step="0.05" value={defaults.channelRatio} />
    </label>
  </div>

  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${componentId}-title ${componentId}-desc`}>
    <title id={`${componentId}-title`}>吸引 kernel 下二跃迁中性激发能量</title>
    <desc id={`${componentId}-desc`}>横轴为吸引强度。水平虚线为起始 continuum edge。低能模式穿过该线时，有限模型中出现正的 binding energy。</desc>
    <rect class="bound-region" data-bound-region x={pad.left} width={width - pad.left - pad.right} y={yScale(defaults.continuumEdge)} height={height - pad.bottom - yScale(defaults.continuumEdge)} />
    <line class="axis" x1={pad.left} y1={height - pad.bottom} x2={width - pad.right} y2={height - pad.bottom} />
    <line class="axis" x1={pad.left} y1={pad.top} x2={pad.left} y2={height - pad.bottom} />
    <line class="continuum-line" data-continuum x1={pad.left} x2={width - pad.right} y1={yScale(defaults.continuumEdge)} y2={yScale(defaults.continuumEdge)} />
    <polyline class="exciton-curve exciton-curve--lower" data-lower points={lowerPoints} />
    <polyline class="exciton-curve exciton-curve--upper" data-upper points={upperPoints} />
    <line class="selection-line" data-selection x1={xScale(defaults.attraction)} x2={xScale(defaults.attraction)} y1={pad.top} y2={height - pad.bottom} />
    <circle class="mode-marker mode-marker--lower" data-lower-marker cx={xScale(defaults.attraction)} cy={yScale(current.lower.energy)} r={radius(current.lower.strength)} />
    <circle class="mode-marker mode-marker--upper" data-upper-marker cx={xScale(defaults.attraction)} cy={yScale(current.upper.energy)} r={radius(current.upper.strength)} />
    <text x={pad.left} y={height - 28} text-anchor="middle">0</text>
    <text x={width - pad.right} y={height - 28} text-anchor="middle">2.5</text>
    <text x={(width + pad.left - pad.right) / 2} y={height - 8} text-anchor="middle">attraction g</text>
    <text transform={`translate(18 ${(height + pad.top - pad.bottom) / 2}) rotate(-90)`} text-anchor="middle">neutral excitation energy</text>
    <text class="region-label" data-region-label x={pad.left + 12} y={yScale(defaults.continuumEdge) + 22}>below starting continuum</text>
  </svg>

  <div class="chapter-visual__readout" aria-live="polite">
    <span>E<sub>g</sub> = <output data-edge-output>{defaults.continuumEdge.toFixed(1)}</output></span>
    <span>g = <output data-attraction-output>{defaults.attraction.toFixed(2)}</output></span>
    <span>Ω<sub>low</sub> = <output data-lower-energy>{current.lower.energy.toFixed(3)}</output></span>
    <span>binding E<sub>b</sub> = <output data-binding>{Math.max(0, current.bindingEnergy).toFixed(3)}</output></span>
    <span>status = <output data-status>{current.isBound ? 'bound in model' : 'continuum-like'}</output></span>
    <span>F<sub>low</sub> = <output data-lower-strength>{current.lower.strength.toFixed(3)}</output></span>
    <span>F total = <output data-total-strength>{current.totalStrength.toFixed(3)}</output></span>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>两条独立跃迁位于 $E_g+0.25$ 与 $E_g+1.2$，并加入归一化 rank-one 吸引 kernel $-g|u\rangle\langle u|$。$E_g$ 是人为声明的 continuum edge，不自动等于真实 quasiparticle gap。</p>
    <p><strong>验收：</strong>$g=0$ 时极点回到独立跃迁；增大正吸引使最低本征值不升高；当 $\Omega_{\mathrm{low}}&lt;E_g$ 时模型 binding $E_b=E_g-\Omega_{\mathrm{low}}&gt;0$；正交本征向量保持总偶极强度。</p>
    <p><strong>边界：</strong>有限二跃迁模型没有真实电子—空穴相对坐标、Rydberg series、$k$ 空间 continuum、screening、quasiparticle self-energy 或材料维度。图中 “bound” 只指相对声明 edge 的模型本征值。</p>
  </div>

  <noscript>
    <p><strong>无 JavaScript fallback | No-JavaScript fallback：</strong>默认 E<sub>g</sub>=6、g=0.8、u₂/u₁=0.7 的模式曲线、continuum edge 和 binding 读数仍可见；控件不更新。</p>
  </noscript>
</figure>

<script>
  import {
    excitonTransitionModel,
    sampleExcitonAttractionScan,
  } from '../../../data/part05/ch21OpticalModels.mjs';

  const root = document.getElementById('ch21-exciton-binding');
  if (root) {
    const edgeInput = root.querySelector('[data-edge]');
    const attractionInput = root.querySelector('[data-attraction]');
    const ratioInput = root.querySelector('[data-ratio]');
    const boundRegion = root.querySelector('[data-bound-region]');
    const continuumLine = root.querySelector('[data-continuum]');
    const lowerCurve = root.querySelector('[data-lower]');
    const upperCurve = root.querySelector('[data-upper]');
    const selectionLine = root.querySelector('[data-selection]');
    const lowerMarker = root.querySelector('[data-lower-marker]');
    const upperMarker = root.querySelector('[data-upper-marker]');
    const regionLabel = root.querySelector('[data-region-label]');
    const edgeOutput = root.querySelector('[data-edge-output]');
    const attractionOutput = root.querySelector('[data-attraction-output]');
    const lowerEnergyOutput = root.querySelector('[data-lower-energy]');
    const bindingOutput = root.querySelector('[data-binding]');
    const statusOutput = root.querySelector('[data-status]');
    const lowerStrengthOutput = root.querySelector('[data-lower-strength]');
    const totalStrengthOutput = root.querySelector('[data-total-strength]');

    if (
      edgeInput instanceof HTMLInputElement
      && attractionInput instanceof HTMLInputElement
      && ratioInput instanceof HTMLInputElement
      && boundRegion instanceof SVGRectElement
      && continuumLine instanceof SVGLineElement
      && lowerCurve instanceof SVGPolylineElement
      && upperCurve instanceof SVGPolylineElement
      && selectionLine instanceof SVGLineElement
      && lowerMarker instanceof SVGCircleElement
      && upperMarker instanceof SVGCircleElement
      && regionLabel instanceof SVGTextElement
      && edgeOutput instanceof HTMLOutputElement
      && attractionOutput instanceof HTMLOutputElement
      && lowerEnergyOutput instanceof HTMLOutputElement
      && bindingOutput instanceof HTMLOutputElement
      && statusOutput instanceof HTMLOutputElement
      && lowerStrengthOutput instanceof HTMLOutputElement
      && totalStrengthOutput instanceof HTMLOutputElement
    ) {
      const width = 780;
      const height = 370;
      const pad = { left: 66, right: 30, top: 30, bottom: 60 };
      const maxAttraction = 2.5;
      const xScale = (attraction) => pad.left
        + attraction / maxAttraction * (width - pad.left - pad.right);

      const update = () => {
        const continuumEdge = Number(edgeInput.value);
        const attraction = Number(attractionInput.value);
        const channelRatio = Number(ratioInput.value);
        const scan = sampleExcitonAttractionScan({
          continuumEdge,
          channelRatio,
          maxAttraction,
          points: 201,
        });
        const current = excitonTransitionModel({ continuumEdge, attraction, channelRatio });
        const energyMin = Math.min(...scan.map((point) => point.lower.energy), continuumEdge) - 0.25;
        const energyMax = Math.max(...scan.map((point) => point.upper.energy)) + 0.25;
        const yScale = (energy) => pad.top
          + (energyMax - energy) / (energyMax - energyMin) * (height - pad.top - pad.bottom);
        const edgeY = yScale(continuumEdge);
        const x = xScale(attraction);
        const markerRadius = (strength) => 4
          + 6 * Math.sqrt(strength / Math.max(current.totalStrength, 1e-12));

        boundRegion.setAttribute('y', String(edgeY));
        boundRegion.setAttribute('height', String(height - pad.bottom - edgeY));
        continuumLine.setAttribute('y1', String(edgeY));
        continuumLine.setAttribute('y2', String(edgeY));
        regionLabel.setAttribute('y', String(edgeY + 22));
        lowerCurve.setAttribute('points', scan
          .map((point) => `${xScale(point.attraction).toFixed(2)},${yScale(point.lower.energy).toFixed(2)}`)
          .join(' '));
        upperCurve.setAttribute('points', scan
          .map((point) => `${xScale(point.attraction).toFixed(2)},${yScale(point.upper.energy).toFixed(2)}`)
          .join(' '));
        selectionLine.setAttribute('x1', String(x));
        selectionLine.setAttribute('x2', String(x));
        lowerMarker.setAttribute('cx', String(x));
        lowerMarker.setAttribute('cy', String(yScale(current.lower.energy)));
        lowerMarker.setAttribute('r', String(markerRadius(current.lower.strength)));
        upperMarker.setAttribute('cx', String(x));
        upperMarker.setAttribute('cy', String(yScale(current.upper.energy)));
        upperMarker.setAttribute('r', String(markerRadius(current.upper.strength)));

        edgeOutput.value = continuumEdge.toFixed(1);
        attractionOutput.value = attraction.toFixed(2);
        lowerEnergyOutput.value = current.lower.energy.toFixed(3);
        bindingOutput.value = Math.max(0, current.bindingEnergy).toFixed(3);
        statusOutput.value = current.isBound ? 'bound in model' : 'continuum-like';
        lowerStrengthOutput.value = current.lower.strength.toFixed(3);
        totalStrengthOutput.value = current.totalStrength.toFixed(3);
      };

      edgeInput.addEventListener('input', update);
      attractionInput.addEventListener('input', update);
      ratioInput.addEventListener('input', update);
      update();
    }
  }
</script>

<style>
  .exciton-binding {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin-inline: 0;
    overflow-x: auto;
  }

  .exciton-binding svg {
    display: block;
    width: 100%;
    min-width: 38rem;
    height: auto;
  }

  .bound-region {
    fill: var(--sl-color-gray-6);
    opacity: 0.45;
  }

  .axis {
    stroke: currentColor;
    stroke-width: 1.3;
  }

  .continuum-line,
  .selection-line {
    stroke: currentColor;
    stroke-dasharray: 6 4;
  }

  .exciton-curve {
    fill: none;
    stroke-width: 2.4;
  }

  .exciton-curve--lower {
    stroke: currentColor;
  }

  .exciton-curve--upper {
    stroke: var(--sl-color-accent-high);
  }

  .mode-marker {
    stroke: var(--sl-color-gray-7);
    stroke-width: 2;
  }

  .mode-marker--lower {
    fill: currentColor;
  }

  .mode-marker--upper {
    fill: var(--sl-color-accent-high);
  }

  text {
    fill: currentColor;
    font-size: 14px;
  }

  .region-label {
    font-size: 12px;
  }
</style>
