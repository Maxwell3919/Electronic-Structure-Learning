---
import catalog from '../../data/martin/index.mjs';

const treatments = {
  '2.1': '基态/激发态性质、Born–Oppenheimer 分工与激发类型 | Ground/excited-state properties, Born–Oppenheimer separation, and excitation types',
  '2.2': '成键分类、电子密度、差分密度与密度的信息边界 | Bonding classes, electron density, difference density, and information limits',
  '2.3': 'E(V)、压力、体模量、自由能与焓 | E(V), pressure, bulk modulus, free energy, and enthalpy',
  '2.4': 'LDA/GGA/杂化泛函的结构误差与统一比较 | Structural errors and controlled comparisons across functionals',
  '2.5': '能量—体积曲线、相焓交叉与压力相变 | Energy–volume curves, enthalpy crossings, and pressure transitions',
  '2.6': '结构搜索、聚合氮与高压 H–S 体系 | Structure searches, polymeric nitrogen, and high-pressure H–S systems',
  '2.7': 'Stoner 图像、磁序与相互作用尺度 | Stoner picture, magnetic order, and interaction scales',
  '2.8': '应变能、应力与弹性常数 | Strain energy, stress, and elastic constants',
  '2.9': '冻结声子、动力学矩阵、软模与位移型相变 | Frozen phonons, dynamical matrices, soft modes, and displacive transitions',
  '2.10': '振动自由能、地球深部、液体和从头算分子动力学 | Vibrational free energy, deep Earth, liquids, and ab initio molecular dynamics',
  '2.11': '表面重构、化学势与界面能量比较 | Surface reconstruction, chemical potentials, and interface energetics',
  '2.12': '二维层状材料、层间弱相互作用与异质结构 | Layered 2D materials, weak interlayer interactions, and heterostructures',
  '2.13': '有限团簇、尺寸依赖结构与纳米带 | Finite clusters, size-dependent structures, and nanoribbons',
  '2.14': '加/减电子谱、ARPES、准粒子能带和带隙 | Addition/removal spectra, ARPES, quasiparticle bands, and bandgaps',
  '2.15': '定粒子数激发、光学响应、激子与长程核 | Fixed-particle-number excitations, optical response, excitons, and long-range kernels',
  '2.16': '自旋—轨道耦合、体—边对应与表面态 | Spin–orbit coupling, bulk–boundary correspondence, and surface states',
  '2.17': '离域—关联竞争与 DFT 之外的多体问题 | Competition between delocalization and correlation, and many-body physics beyond DFT',
};

const chapter = catalog.parts[0].units[1];
---

<h2 id="source-map">原书结构与来源定位 | Source Map</h2>

<div class="chapter-source-map">
  <table>
    <thead>
      <tr>
        <th scope="col">节 | Section</th>
        <th scope="col">原书标题 | Martin title</th>
        <th scope="col">印刷页 | Print page</th>
        <th scope="col">本站处理 | Website treatment</th>
        <th scope="col">状态 | Status</th>
      </tr>
    </thead>
    <tbody>
      {chapter.sections.map((section) => (
        <tr>
          <td><code>{section.id}</code></td>
          <td>{section.title}</td>
          <td>{section.page}</td>
          <td>{treatments[section.id]}</td>
          <td>review</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<p>
  Martin Chapter 2 starts on printed page 15 and ends with further reading on page 59. The source map follows the directory order exactly. The website does not reproduce Martin's figures 2.1–2.27, their layouts, or their captions; the three visualizations below are independently designed from explicitly stated teaching models.
</p>
<p lang="en">
  Martin Chapter 2 runs from printed page 15 through the further-reading page 59. This map preserves the directory order. The website does not reproduce Martin's Figures 2.1–2.27, their layouts, or their captions; the three visualizations below are independently designed from declared teaching models.
