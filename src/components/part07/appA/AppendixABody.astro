---
import AppendixAContents from './AppendixAContents.astro';
import AppendixAOrientation from './AppendixAOrientation.mdx';
import AppendixABasicVariation from './AppendixABasicVariation.mdx';
import AppendixAGradientFunctionals from './AppendixAGradientFunctionals.mdx';
import AppendixAReview from './AppendixAReview.mdx';
---

<div class="appendix-a-root">
  <AppendixAContents />
  <AppendixAOrientation />
  <AppendixABasicVariation />
  <AppendixAGradientFunctionals />
  <AppendixAReview />
</div>

<style is:global>
  .appendix-a-root,
  .appendix-a-root > *,
  .appendix-a-root .bilingual-section,
  .appendix-a-root .bilingual-section__grid,
  .appendix-a-root .bilingual-section__grid > *,
  .appendix-a-root .bilingual-section__zh,
  .appendix-a-root .bilingual-section__en,
  .appendix-a-root .derivation-block,
  .appendix-a-root .bilingual-callout {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .appendix-a-root .chapter-visual {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin-inline: 0;
    box-sizing: border-box;
  }

  .appendix-a-root .chapter-source-map,
  .appendix-a-root .table-scroll,
  .appendix-a-root .katex-display,
  .appendix-a-root pre,
  .appendix-a-root table {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .appendix-a-root p,
  .appendix-a-root li,
  .appendix-a-root th,
  .appendix-a-root td,
  .appendix-a-root code {
    overflow-wrap: anywhere;
  }
</style>
