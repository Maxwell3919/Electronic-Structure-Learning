---
import AppendixEContents from './AppendixEContents.astro';
import AppendixEOrientation from './AppendixEOrientation.mdx';
import AppendixEMaxwellConductivity from './AppendixEMaxwellConductivity.mdx';
import AppendixELongitudinalTransverse from './AppendixELongitudinalTransverse.mdx';
import AppendixELatticeReview from './AppendixELatticeReview.mdx';
---

<div class="appendix-e-root">
  <AppendixEContents />
  <AppendixEOrientation />
  <AppendixEMaxwellConductivity />
  <AppendixELongitudinalTransverse />
  <AppendixELatticeReview />
</div>

<style is:global>
  .appendix-e-root,
  .appendix-e-root > *,
  .appendix-e-root .bilingual-section,
  .appendix-e-root .bilingual-section__grid,
  .appendix-e-root .bilingual-section__zh,
  .appendix-e-root .bilingual-section__en,
  .appendix-e-root .bilingual-callout,
  .appendix-e-root .bilingual-callout__grid {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .appendix-e-root .chapter-visual {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin-inline: 0;
    box-sizing: border-box;
  }

  .appendix-e-root .chapter-source-map,
  .appendix-e-root .katex-display,
  .appendix-e-root pre,
  .appendix-e-root table {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .appendix-e-root p,
  .appendix-e-root li,
  .appendix-e-root th,
  .appendix-e-root td,
  .appendix-e-root code {
    overflow-wrap: anywhere;
  }
</style>
