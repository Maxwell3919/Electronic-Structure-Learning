---
import {
  dielectricModelDefaults,
  macroscopicDielectricFromMatrix,
} from '../../../data/part07/dielectricOpticsModel.mjs';

const defaults = macroscopicDielectricFromMatrix({
  epsilon00: dielectricModelDefaults.epsilon00,
  epsilon11: dielectricModelDefaults.epsilon11,
  coupling: dielectricModelDefaults.localFieldCoupling,
});
const fallbackCases = [
  { epsilon11: 3, coupling: 0 },
  { epsilon11: 3, coupling: 1.2 },
  { epsilon11: 1.5, coupling: 1.8 },
].map((entry) => ({
  ...entry,
  ...macroscopicDielectricFromMatrix({
    epsilon00: dielectricModelDefaults.epsilon00,
    epsilon11: entry.epsilon11,
    coupling: entry.coupling,
  }),
}));
---

<figure class="chapter-visual local-field-explorer" data-local-field-explorer>
  <figcaption>
    <strong>原创交互模型：microscopic dielectric matrix 与 local-field correction</strong>
    <span lang="en">Original interactive model: microscopic dielectric matrix and local-field correction</span>
  </figcaption>

  <div class="chapter-visual__controls local-field-explorer__controls">
    <label>
      <span>off-diagonal coupling c | 非对角耦合</span>
      <input type="range" min="0" max="2" step="0.05" value={dielectricModelDefaults.localFieldCoupling} data-local-field-coupling />
      <output data-local-field-coupling-output>{dielectricModelDefaults.localFieldCoupling.toFixed(2)}</output>
    </label>
    <label>
      <span>microscopic diagonal ε₁₁</span>
      <input type="range" min="1" max="6" step="0.1" value={dielectricModelDefaults.epsilon11} data-local-field-epsilon11 />
      <output data-local-field-epsilon11-output>{dielectricModelDefaults.epsilon11.toFixed(1)}</output>
    </label>
  </div>

  <svg viewBox="0 0 760 300" role="img" aria-labelledby="local-field-title local-field-desc">
    <title id="local-field-title">Two-by-two dielectric matrix and Schur-complement macroscopic response</title>
    <desc id="local-field-desc">
      A two-by-two microscopic dielectric matrix contains a head element epsilon zero zero, one local-field channel epsilon one one, and an off-diagonal coupling c. Inverting the full matrix gives the macroscopic dielectric function as epsilon zero zero minus c squared over epsilon one one, not simply the head element.
    </desc>
    <defs>
      <marker id="local-field-arrow" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto">
        <path d="M0,0 L9,4.5 L0,9 z" class="local-field-explorer__arrowhead" />
      </marker>
    </defs>

    <g transform="translate(55 55)">
      <rect x="0" y="0" width="230" height="150" rx="12" class="local-field-explorer__box" />
      <text x="115" y="28" text-anchor="middle">microscopic ε matrix</text>
      <text x="115" y="65" text-anchor="middle">[ ε₀₀   c ]</text>
      <text x="115" y="92" text-anchor="middle">[  c   ε₁₁ ]</text>
      <text x="115" y="126" text-anchor="middle">G=0 head + G≠0 channel</text>
    </g>

    <line x1="300" y1="130" x2="390" y2="130" marker-end="url(#local-field-arrow)" class="local-field-explorer__arrow" />
    <text x="345" y="112" text-anchor="middle">invert full matrix</text>

    <g transform="translate(410 55)">
      <rect x="0" y="0" width="295" height="150" rx="12" class="local-field-explorer__box local-field-explorer__box--accent" />
      <text x="147" y="28" text-anchor="middle">macroscopic dielectric response</text>
      <text x="147" y="65" text-anchor="middle">εM = 1 / [ε⁻¹]₀₀</text>
      <text x="147" y="94" text-anchor="middle">= ε₀₀ − c²/ε₁₁</text>
      <text x="147" y="126" text-anchor="middle">Schur complement</text>
    </g>

    <path d="M170 220 C170 270, 590 270, 590 220" class="local-field-explorer__bracket" />
    <text x="380" y="280" text-anchor="middle">local-field channels reduce εM relative to the uncoupled head in this positive model</text>
  </svg>

  <div class="chapter-visual__readout local-field-explorer__readout" aria-live="polite">
    <span>ε₀₀ | matrix head</span>
    <strong>{dielectricModelDefaults.epsilon00.toFixed(2)}</strong>
    <span>εM | macroscopic</span>
    <strong data-local-field-macro>{defaults.macroscopic.toFixed(4)}</strong>
    <span>ε₀₀−εM | correction</span>
    <strong data-local-field-correction>{defaults.localFieldCorrection.toFixed(4)}</strong>
    <span>det ε | determinant</span>
    <strong data-local-field-determinant>{defaults.determinant.toFixed(4)}</strong>
  </div>

  <div class="local-field-explorer__fallback">
    <p><strong>无 JavaScript 参考表 | No-JavaScript reference table</strong></p>
    <table>
      <thead><tr><th>ε₁₁</th><th>c</th><th>εM</th><th>ε₀₀−εM</th></tr></thead>
      <tbody>
        {fallbackCases.map((entry) => (
          <tr>
            <td>{entry.epsilon11.toFixed(1)}</td>
            <td>{entry.coupling.toFixed(1)}</td>
            <td>{entry.macroscopic.toFixed(4)}</td>
            <td>{entry.localFieldCorrection.toFixed(4)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong><code>ε=[[ε₀₀,c],[c,ε₁₁]]</code>，固定 <code>ε₀₀=5</code>，由完整 inverse matrix 提取 <code>εM=1/[ε⁻¹]₀₀=ε₀₀−c²/ε₁₁</code>。</p>
    <p lang="en"><strong>Model:</strong> <code>ε=[[ε₀₀,c],[c,ε₁₁]]</code> with fixed <code>ε₀₀=5</code>; the full inverse gives <code>εM=1/[ε⁻¹]₀₀=ε₀₀−c²/ε₁₁</code>.</p>
    <p><strong>验收：</strong><code>c=0</code> 时 <code>εM=ε₀₀</code>；Schur complement 与 inverse-matrix extraction 数值一致；determinant 非正时模型 fail-closed。</p>
    <p lang="en"><strong>Acceptance:</strong> at <code>c=0</code>, <code>εM=ε₀₀</code>; the Schur complement equals the inverse-matrix extraction; a non-positive determinant fails closed.</p>
    <p><strong>边界：</strong>这是单个 local-field channel 的实对称静态模型。真实晶体需要复数、频率依赖的 GG′ dielectric matrix；local-field correction 的符号和大小取决于完整 matrix。</p>
    <p lang="en"><strong>Boundary:</strong> this is a real symmetric static model with one local-field channel. A real crystal requires a complex, frequency-dependent GG′ dielectric matrix; the sign and magnitude of the correction depend on the full matrix.</p>
  </div>
</figure>

<script>
  import {
    dielectricModelDefaults,
    macroscopicDielectricFromMatrix,
  } from '../../../data/part07/dielectricOpticsModel.mjs';

  document.querySelectorAll('[data-local-field-explorer]').forEach((root) => {
    const coupling = root.querySelector('[data-local-field-coupling]');
    const epsilon11 = root.querySelector('[data-local-field-epsilon11]');
    const couplingOutput = root.querySelector('[data-local-field-coupling-output]');
    const epsilon11Output = root.querySelector('[data-local-field-epsilon11-output]');
    const macro = root.querySelector('[data-local-field-macro]');
    const correction = root.querySelector('[data-local-field-correction]');
    const determinant = root.querySelector('[data-local-field-determinant]');
    if (!(coupling instanceof HTMLInputElement) || !(epsilon11 instanceof HTMLInputElement)) return;

    const update = () => {
      try {
        const result = macroscopicDielectricFromMatrix({
          epsilon00: dielectricModelDefaults.epsilon00,
          epsilon11: Number(epsilon11.value),
          coupling: Number(coupling.value),
        });
        if (couplingOutput instanceof HTMLOutputElement) couplingOutput.value = result.localFieldCorrection >= 0 ? Number(coupling.value).toFixed(2) : 'invalid';
        if (epsilon11Output instanceof HTMLOutputElement) epsilon11Output.value = Number(epsilon11.value).toFixed(1);
        if (macro instanceof HTMLElement) macro.textContent = result.macroscopic.toFixed(4);
        if (correction instanceof HTMLElement) correction.textContent = result.localFieldCorrection.toFixed(4);
        if (determinant instanceof HTMLElement) determinant.textContent = result.determinant.toFixed(4);
      } catch {
        if (macro instanceof HTMLElement) macro.textContent = 'undefined';
        if (correction instanceof HTMLElement) correction.textContent = 'undefined';
        if (determinant instanceof HTMLElement) determinant.textContent = 'singular';
      }
    };
    coupling.addEventListener('input', update);
    epsilon11.addEventListener('input', update);
    update();
  });
</script>

<style>
  .local-field-explorer { overflow-x: auto; }
  .local-field-explorer svg { width: 100%; min-width: 40rem; }
  .local-field-explorer text { fill: currentColor; font-size: 14px; }
  .local-field-explorer__box { fill: var(--sl-color-gray-6); stroke: var(--sl-color-gray-4); stroke-width: 2; }
  .local-field-explorer__box--accent { stroke: var(--sl-color-accent-high); }
  .local-field-explorer__arrow, .local-field-explorer__bracket { fill: none; stroke: currentColor; stroke-width: 2; }
  .local-field-explorer__arrowhead { fill: currentColor; }
  .local-field-explorer__controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1rem; }
  .local-field-explorer__controls label { display: grid; gap: 0.35rem; }
  .local-field-explorer__readout { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 0.4rem 1rem; }
  .local-field-explorer__fallback { max-width: 36rem; }
</style>
