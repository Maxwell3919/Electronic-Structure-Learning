---
import {
  dielectricModelDefaults,
  integrateFSum,
  lorentzDielectric,
  splitOscillatorStrength,
} from '../../../data/part07/dielectricOpticsModel.mjs';

const width = 650;
const height = 300;
const left = 58;
const right = 620;
const top = 34;
const bottom = 250;
const maxOmega = 2.5;
const xMap = (omega) => left + (right - left) * omega / maxOmega;
const yMap = (value) => bottom - value * (bottom - top) / 1.8;
const curveFor = (fraction) => {
  const resonances = splitOscillatorStrength({
    totalStrength: dielectricModelDefaults.totalStrength,
    fraction,
    omega1: dielectricModelDefaults.omega1,
    omega2: dielectricModelDefaults.omega2,
  });
  return Array.from({ length: 321 }, (_, index) => {
    const omega = maxOmega * index / 320;
    return {
      omega,
      sigma: lorentzDielectric({
        omega,
        epsilonInfinity: dielectricModelDefaults.epsilonInfinity,
        resonances,
        damping: dielectricModelDefaults.damping,
      }).conductivityReal,
    };
  });
};
const pathFor = (samples) => samples
  .map((point, index) => `${index === 0 ? 'M' : 'L'} ${xMap(point.omega).toFixed(2)} ${yMap(point.sigma).toFixed(2)}`)
  .join(' ');
const defaultResonances = splitOscillatorStrength({
  totalStrength: dielectricModelDefaults.totalStrength,
  fraction: dielectricModelDefaults.weightFraction,
  omega1: dielectricModelDefaults.omega1,
  omega2: dielectricModelDefaults.omega2,
});
const defaultPath = pathFor(curveFor(dielectricModelDefaults.weightFraction));
const defaultSum = integrateFSum({
  epsilonInfinity: dielectricModelDefaults.epsilonInfinity,
  resonances: defaultResonances,
  damping: dielectricModelDefaults.damping,
  maxOmega: 10,
  intervals: 24000,
});
const fallbackCases = [0.15, 0.55, 0.85].map((fraction) => {
  const resonances = splitOscillatorStrength({
    totalStrength: dielectricModelDefaults.totalStrength,
    fraction,
    omega1: dielectricModelDefaults.omega1,
    omega2: dielectricModelDefaults.omega2,
  });
  const sum = integrateFSum({
    epsilonInfinity: dielectricModelDefaults.epsilonInfinity,
    resonances,
    damping: dielectricModelDefaults.damping,
    maxOmega: 10,
    intervals: 24000,
  });
  return { fraction, ...sum };
});
---

<figure class="chapter-visual spectral-weight" data-spectral-weight>
  <figcaption>
    <strong>原创交互模型：固定 f-sum 下的光谱权重重分配</strong>
    <span lang="en">Original interactive model: spectral-weight redistribution at fixed f-sum</span>
  </figcaption>

  <div class="chapter-visual__controls spectral-weight__controls">
    <label>
      <span>low-frequency weight fraction | 低频振子权重比例</span>
      <input type="range" min="0.05" max="0.95" step="0.05" value={dielectricModelDefaults.weightFraction} data-spectral-fraction />
      <output data-spectral-fraction-output>{dielectricModelDefaults.weightFraction.toFixed(2)}</output>
    </label>
  </div>

  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="spectral-title spectral-desc">
    <title id="spectral-title">Real conductivity of two Lorentz oscillators with fixed total strength</title>
    <desc id="spectral-desc">
      A keyboard-operable slider transfers oscillator strength between resonances at 0.8 and 1.55 while their total strength remains fixed. Peak positions and heights change, but the integrated real conductivity remains approximately constant over the declared finite window.
    </desc>
    <line x1={left} y1={bottom} x2={right} y2={bottom} class="plot-axis" />
    <line x1={left} y1={top} x2={left} y2={bottom} class="plot-axis" />
    <line x1={xMap(dielectricModelDefaults.omega1)} y1={top} x2={xMap(dielectricModelDefaults.omega1)} y2={bottom} class="plot-guide" />
    <line x1={xMap(dielectricModelDefaults.omega2)} y1={top} x2={xMap(dielectricModelDefaults.omega2)} y2={bottom} class="plot-guide" />
    <path d={defaultPath} class="plot-curve" data-spectral-path />
    <text x={right} y="280" text-anchor="end">ω</text>
    <text x="16" y="48">Re σ(ω)</text>
  </svg>

  <div class="chapter-visual__readout spectral-weight__readout" aria-live="polite">
    <span>∫ Re σ dω | 电导光谱权重</span>
    <strong data-spectral-integral>{defaultSum.conductivityWeight.toFixed(5)}</strong>
    <span>expected S/8 | 解析极限</span>
    <strong>{defaultSum.expectedConductivityWeight.toFixed(5)}</strong>
    <span>relative error | 相对误差</span>
    <strong data-spectral-error>{Math.abs(defaultSum.conductivityWeight / defaultSum.expectedConductivityWeight - 1).toExponential(2)}</strong>
  </div>

  <div class="spectral-weight__fallback">
    <p><strong>无 JavaScript 参考表 | No-JavaScript reference table</strong></p>
    <table>
      <thead><tr><th>low-frequency fraction</th><th>∫ Re σ dω</th><th>expected S/8</th></tr></thead>
      <tbody>
        {fallbackCases.map((entry) => (
          <tr>
            <td>{entry.fraction.toFixed(2)}</td>
            <td>{entry.conductivityWeight.toFixed(5)}</td>
            <td>{entry.expectedConductivityWeight.toFixed(5)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>Gaussian units 与 <code>e^(−iωt)</code>；两个 Lorentz oscillators 的总 strength 固定为 1.6，频率为 0.8 和 1.55，阻尼为 0.08，<code>Reσ=ω Imε/(4π)</code>。</p>
    <p lang="en"><strong>Model:</strong> Gaussian units with <code>e^(−iωt)</code>; two Lorentz oscillators have fixed total strength 1.6, frequencies 0.8 and 1.55, damping 0.08, and <code>Reσ=ω Imε/(4π)</code>.</p>
    <p><strong>验收：</strong>改变权重比例只重分配两个峰；<code>∫₀∞Reσ dω=S/8</code> 与 <code>∫₀∞ω Imε dω=πS/2</code> 不随比例改变。有限窗口结果必须报告截断误差。</p>
    <p lang="en"><strong>Acceptance:</strong> changing the fraction only redistributes the two peaks; <code>∫₀∞Reσ dω=S/8</code> and <code>∫₀∞ω Imε dω=πS/2</code> remain independent of the fraction. The finite-window result reports truncation error.</p>
    <p><strong>边界：</strong>该模型不把单个 peak 归因于某种真实 excitation；sum rule 约束总权重，不确定峰位置、matrix element 分解或 quasiparticle identity。</p>
    <p lang="en"><strong>Boundary:</strong> the model does not assign a real microscopic excitation to either peak; the sum rule constrains total weight, not peak positions, matrix-element decomposition, or quasiparticle identity.</p>
  </div>
</figure>

<script>
  import {
    dielectricModelDefaults,
    integrateFSum,
    lorentzDielectric,
    splitOscillatorStrength,
  } from '../../../data/part07/dielectricOpticsModel.mjs';

  document.querySelectorAll('[data-spectral-weight]').forEach((root) => {
    const input = root.querySelector('[data-spectral-fraction]');
    const output = root.querySelector('[data-spectral-fraction-output]');
    const path = root.querySelector('[data-spectral-path]');
    const integralOutput = root.querySelector('[data-spectral-integral]');
    const errorOutput = root.querySelector('[data-spectral-error]');
    if (!(input instanceof HTMLInputElement) || !(path instanceof SVGPathElement)) return;

    const left = 58;
    const right = 620;
    const top = 34;
    const bottom = 250;
    const maxOmega = 2.5;
    const xMap = (omega) => left + (right - left) * omega / maxOmega;
    const yMap = (value) => bottom - value * (bottom - top) / 1.8;

    const update = () => {
      const fraction = Number(input.value);
      const resonances = splitOscillatorStrength({
        totalStrength: dielectricModelDefaults.totalStrength,
        fraction,
        omega1: dielectricModelDefaults.omega1,
        omega2: dielectricModelDefaults.omega2,
      });
      const curve = Array.from({ length: 321 }, (_, index) => {
        const omega = maxOmega * index / 320;
        return {
          omega,
          sigma: lorentzDielectric({
            omega,
            epsilonInfinity: dielectricModelDefaults.epsilonInfinity,
            resonances,
            damping: dielectricModelDefaults.damping,
          }).conductivityReal,
        };
      }).map((point, index) => `${index === 0 ? 'M' : 'L'} ${xMap(point.omega).toFixed(2)} ${yMap(point.sigma).toFixed(2)}`).join(' ');
      const sum = integrateFSum({
        epsilonInfinity: dielectricModelDefaults.epsilonInfinity,
        resonances,
        damping: dielectricModelDefaults.damping,
        maxOmega: 10,
        intervals: 12000,
      });
      path.setAttribute('d', curve);
      if (output instanceof HTMLOutputElement) output.value = fraction.toFixed(2);
      if (integralOutput instanceof HTMLElement) integralOutput.textContent = sum.conductivityWeight.toFixed(5);
      if (errorOutput instanceof HTMLElement) errorOutput.textContent = Math.abs(sum.conductivityWeight / sum.expectedConductivityWeight - 1).toExponential(2);
    };
    input.addEventListener('input', update);
    update();
  });
</script>

<style>
  .spectral-weight { overflow-x: auto; }
  .spectral-weight svg { width: 100%; min-width: 38rem; }
  .spectral-weight text { fill: currentColor; font-size: 13px; }
  .spectral-weight__controls label { display: grid; gap: 0.35rem; }
  .spectral-weight__readout { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.4rem 1rem; }
  .spectral-weight__fallback { max-width: 38rem; }
</style>
