---
import { planeWavePartialExpansion, scatteringDefaults } from '../../../data/part07/scatteringPhaseModel.mjs';

const defaults = planeWavePartialExpansion();
const width = 760;
const height = 350;
const panel = { left: 70, right: 405, top: 45, bottom: 300 };
const scaleValue = 105;
const xMap = (value) => (panel.left + panel.right) / 2 + scaleValue * value;
const yMap = (value) => (panel.top + panel.bottom) / 2 - scaleValue * value;
const cumulativePath = defaults.terms
  .map(({ cumulative }, index) => `${index === 0 ? 'M' : 'L'} ${xMap(cumulative.re).toFixed(2)} ${yMap(cumulative.im).toFixed(2)}`)
  .join(' ');
const fallbackRows = [2, 4, 8, 12].map((lMax) => planeWavePartialExpansion({
  kr: scatteringDefaults.expansion.kr,
  theta: scatteringDefaults.expansion.theta,
  lMax,
}));
---

<figure class="chapter-visual partial-wave-expansion" data-partial-wave-expansion>
  <figcaption>
    <strong>原创交互模型：平面波的有限部分波重建</strong>
    <span lang="en">Original interactive model: finite partial-wave reconstruction of a plane wave</span>
  </figcaption>

  <div class="chapter-visual__controls partial-wave-expansion__controls">
    <label>
      <span>kr | 无量纲径向相位</span>
      <input type="range" min="0.2" max="12" step="0.1" value={scatteringDefaults.expansion.kr} data-partial-kr />
      <output data-partial-kr-output>{scatteringDefaults.expansion.kr.toFixed(1)}</output>
    </label>
    <label>
      <span>θ/π | 观察角</span>
      <input type="range" min="0" max="1" step="0.01" value={(scatteringDefaults.expansion.theta / Math.PI).toFixed(2)} data-partial-theta />
      <output data-partial-theta-output>{(scatteringDefaults.expansion.theta / Math.PI).toFixed(2)}</output>
    </label>
    <label>
      <span>l<sub>max</sub> | 截断角动量</span>
      <input type="range" min="0" max="16" step="1" value={scatteringDefaults.expansion.lMax} data-partial-lmax />
      <output data-partial-lmax-output>{scatteringDefaults.expansion.lMax}</output>
    </label>
  </div>

  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="partial-wave-title partial-wave-desc">
    <title id="partial-wave-title">Complex-plane convergence of the spherical partial-wave expansion</title>
    <desc id="partial-wave-desc">
      Successive angular-momentum terms reconstruct exp(i kr cos theta). The cumulative complex sum approaches the exact point as l max increases.
    </desc>
    <rect x="35" y="25" width="405" height="300" rx="12" class="partial-wave-expansion__panel" />
    <line x1={panel.left} y1={(panel.top + panel.bottom) / 2} x2={panel.right} y2={(panel.top + panel.bottom) / 2} class="plot-axis" />
    <line x1={(panel.left + panel.right) / 2} y1={panel.top} x2={(panel.left + panel.right) / 2} y2={panel.bottom} class="plot-axis" />
    <circle cx={(panel.left + panel.right) / 2} cy={(panel.top + panel.bottom) / 2} r={scaleValue} class="partial-wave-expansion__unit-circle" />
    <path d={cumulativePath} class="plot-curve" data-partial-path />
    <circle cx={xMap(defaults.exact.re)} cy={yMap(defaults.exact.im)} r="6" class="partial-wave-expansion__exact" data-partial-exact />
    <circle cx={xMap(defaults.partial.re)} cy={yMap(defaults.partial.im)} r="5" class="partial-wave-expansion__sum" data-partial-sum />
    <text x="238" y="43" text-anchor="middle">complex amplitude plane</text>
    <text x={panel.right} y={(panel.top + panel.bottom) / 2 - 8} text-anchor="end">Re</text>
    <text x={(panel.left + panel.right) / 2 + 8} y={panel.top + 15}>Im</text>

    <rect x="470" y="25" width="255" height="300" rx="12" class="partial-wave-expansion__panel" />
    <text x="598" y="52" text-anchor="middle">identity audit</text>
    <text x="495" y="92">exact Re</text><text x="690" y="92" text-anchor="end" data-partial-exact-re>{defaults.exact.re.toFixed(8)}</text>
    <text x="495" y="122">exact Im</text><text x="690" y="122" text-anchor="end" data-partial-exact-im>{defaults.exact.im.toFixed(8)}</text>
    <text x="495" y="166">sum Re</text><text x="690" y="166" text-anchor="end" data-partial-sum-re>{defaults.partial.re.toFixed(8)}</text>
    <text x="495" y="196">sum Im</text><text x="690" y="196" text-anchor="end" data-partial-sum-im>{defaults.partial.im.toFixed(8)}</text>
    <text x="495" y="240">absolute error</text><text x="690" y="240" text-anchor="end" data-partial-error>{defaults.absoluteError.toExponential(3)}</text>
    <text x="495" y="278">terms retained</text><text x="690" y="278" text-anchor="end" data-partial-terms>{defaults.terms.length}</text>
  </svg>

  <div class="partial-wave-expansion__fallback">
    <p><strong>无 JavaScript 参考表 | No-JavaScript reference table</strong></p>
    <table>
      <thead><tr><th>lmax</th><th>partial Re</th><th>partial Im</th><th>|error|</th></tr></thead>
      <tbody>
        {fallbackRows.map((entry) => (
          <tr>
            <td>{entry.lMax}</td>
            <td>{entry.partial.re.toFixed(7)}</td>
            <td>{entry.partial.im.toFixed(7)}</td>
            <td>{entry.absoluteError.toExponential(2)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong><code>exp(i kr cosθ)=Σ(2l+1)i^l j_l(kr)P_l(cosθ)</code>，按 J.1–J.2 的同一 <code>i^l</code> 约定截断到 <code>lmax</code>。</p>
    <p lang="en"><strong>Model:</strong> <code>exp(i kr cosθ)=Σ(2l+1)i^l j_l(kr)P_l(cosθ)</code>, truncated at <code>lmax</code> with the same <code>i^l</code> convention as J.1–J.2.</p>
    <p><strong>验收：</strong>提高 <code>lmax</code> 时复平面累积和趋近 exact point；在固定精度下，所需通道数随 <code>kr</code> 增长。</p>
    <p lang="en"><strong>Acceptance:</strong> the cumulative complex sum approaches the exact point as <code>lmax</code> grows; the number of channels required for fixed accuracy increases with <code>kr</code>.</p>
    <p><strong>边界：</strong>这是球谐/Legendre 恒等式，不是散射求解。不同 spherical-harmonic normalization、缺失 <code>i^l</code> 或把有限通道误当完备展开都会改变结果。</p>
    <p lang="en"><strong>Boundary:</strong> this is a spherical-harmonic and Legendre identity, not a scattering solution. Different harmonic normalization, a missing <code>i^l</code>, or treating a finite channel set as complete changes the result.</p>
  </div>
</figure>

<script>
  import { planeWavePartialExpansion } from '../../../data/part07/scatteringPhaseModel.mjs';

  document.querySelectorAll('[data-partial-wave-expansion]').forEach((root) => {
    const kr = root.querySelector('[data-partial-kr]');
    const theta = root.querySelector('[data-partial-theta]');
    const lMax = root.querySelector('[data-partial-lmax]');
    if (!(kr instanceof HTMLInputElement) || !(theta instanceof HTMLInputElement) || !(lMax instanceof HTMLInputElement)) return;
    const path = root.querySelector('[data-partial-path]');
    const exactCircle = root.querySelector('[data-partial-exact]');
    const sumCircle = root.querySelector('[data-partial-sum]');
    const outputs = {
      kr: root.querySelector('[data-partial-kr-output]'), theta: root.querySelector('[data-partial-theta-output]'), lMax: root.querySelector('[data-partial-lmax-output]'),
      exactRe: root.querySelector('[data-partial-exact-re]'), exactIm: root.querySelector('[data-partial-exact-im]'), sumRe: root.querySelector('[data-partial-sum-re]'), sumIm: root.querySelector('[data-partial-sum-im]'), error: root.querySelector('[data-partial-error]'), terms: root.querySelector('[data-partial-terms]'),
    };
    const centreX = 237.5; const centreY = 172.5; const scaleValue = 105;
    const xMap = (value) => centreX + scaleValue * value;
    const yMap = (value) => centreY - scaleValue * value;
    const setCircle = (element, value) => {
      if (!(element instanceof SVGCircleElement)) return;
      element.setAttribute('cx', xMap(value.re).toFixed(2));
      element.setAttribute('cy', yMap(value.im).toFixed(2));
    };
    const update = () => {
      const result = planeWavePartialExpansion({ kr: Number(kr.value), theta: Number(theta.value) * Math.PI, lMax: Number(lMax.value) });
      const curve = result.terms.map(({ cumulative }, index) => `${index === 0 ? 'M' : 'L'} ${xMap(cumulative.re).toFixed(2)} ${yMap(cumulative.im).toFixed(2)}`).join(' ');
      if (path instanceof SVGPathElement) path.setAttribute('d', curve);
      setCircle(exactCircle, result.exact); setCircle(sumCircle, result.partial);
      if (outputs.kr instanceof HTMLOutputElement) outputs.kr.value = result.kr.toFixed(1);
      if (outputs.theta instanceof HTMLOutputElement) outputs.theta.value = (result.theta / Math.PI).toFixed(2);
      if (outputs.lMax instanceof HTMLOutputElement) outputs.lMax.value = String(result.lMax);
      if (outputs.exactRe instanceof HTMLElement) outputs.exactRe.textContent = result.exact.re.toFixed(8);
      if (outputs.exactIm instanceof HTMLElement) outputs.exactIm.textContent = result.exact.im.toFixed(8);
      if (outputs.sumRe instanceof HTMLElement) outputs.sumRe.textContent = result.partial.re.toFixed(8);
      if (outputs.sumIm instanceof HTMLElement) outputs.sumIm.textContent = result.partial.im.toFixed(8);
      if (outputs.error instanceof HTMLElement) outputs.error.textContent = result.absoluteError.toExponential(3);
      if (outputs.terms instanceof HTMLElement) outputs.terms.textContent = String(result.terms.length);
    };
    [kr, theta, lMax].forEach((input) => input.addEventListener('input', update));
    update();
  });
</script>

<style>
  .partial-wave-expansion { overflow-x: auto; }
  .partial-wave-expansion svg { width: 100%; min-width: 44rem; }
  .partial-wave-expansion text { fill: currentColor; font-size: 13px; }
  .partial-wave-expansion__panel { fill: var(--sl-color-gray-6); stroke: var(--sl-color-gray-4); stroke-width: 2; }
  .partial-wave-expansion__unit-circle { fill: none; stroke: var(--sl-color-gray-3); stroke-dasharray: 5 5; }
  .partial-wave-expansion__exact { fill: var(--sl-color-accent-high); }
  .partial-wave-expansion__sum { fill: currentColor; }
  .partial-wave-expansion__controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 0.8rem; }
  .partial-wave-expansion__controls label { display: grid; gap: 0.35rem; }
  .partial-wave-expansion__fallback { max-width: 44rem; }
</style>
