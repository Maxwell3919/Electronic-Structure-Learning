---
import AppendixDContents from './AppendixDContents.astro';
import AppendixDOrientation from './AppendixDOrientation.mdx';
import AppendixDPerturbationStatic from './AppendixDPerturbationStatic.mdx';
import AppendixDDynamicGreen from './AppendixDDynamicGreen.mdx';
import AppendixDTwoNPlusOneReview from './AppendixDTwoNPlusOneReview.mdx';
---

<div class="appendix-d-root">
  <AppendixDContents />
  <AppendixDOrientation />
  <AppendixDPerturbationStatic />
  <AppendixDDynamicGreen />
  <AppendixDTwoNPlusOneReview />
</div>

<style is:global>
  .appendix-d-root,
  .appendix-d-root > *,
  .appendix-d-root .bilingual-section,
  .appendix-d-root .bilingual-section__grid,
  .appendix-d-root .bilingual-section__zh,
  .appendix-d-root .bilingual-section__en,
  .appendix-d-root .bilingual-callout,
  .appendix-d-root .bilingual-callout__grid {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .appendix-d-root .chapter-visual {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin-inline: 0;
    box-sizing: border-box;
  }

  .appendix-d-root .chapter-source-map,
  .appendix-d-root .katex-display,
  .appendix-d-root pre,
  .appendix-d-root table {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .appendix-d-root p,
  .appendix-d-root li,
  .appendix-d-root th,
  .appendix-d-root td,
  .appendix-d-root code {
    overflow-wrap: anywhere;
  }
</style>
