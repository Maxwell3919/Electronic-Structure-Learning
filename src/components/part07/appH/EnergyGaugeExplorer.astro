---
import { densityModelDefaults, periodicEnergyGauge } from '../../../data/part07/energyStressDensityModel.mjs';

const defaults = periodicEnergyGauge();
const width = 720;
const height = 330;
const left = 60;
const right = 680;
const top = 40;
const bottom = 260;
const xMap = (x) => left + (right - left) * x / (2 * Math.PI);
const yMin = 0.25;
const yMax = 2.1;
const yMap = (value) => bottom - (value - yMin) * (bottom - top) / (yMax - yMin);
const pathFor = (values) => values.map((value, index) => `${index === 0 ? 'M' : 'L'} ${xMap(defaults.grid[index]).toFixed(2)} ${yMap(value).toFixed(2)}`).join(' ');
const basePath = pathFor(defaults.base);
const transformedPath = pathFor(defaults.transformed);
const regionStart = defaults.grid.findIndex((x) => x >= densityModelDefaults.energyGauge.regionStart);
const regionEnd = defaults.grid.findIndex((x) => x >= densityModelDefaults.energyGauge.regionEnd);
const fallbackRows = [0, 0.3, 0.6].map((gaugeAmplitude) => ({
  gaugeAmplitude,
  ...periodicEnergyGauge({ gaugeAmplitude }),
}));
---

<figure class="chapter-visual energy-gauge" data-energy-gauge>
  <figcaption>
    <strong>原创交互模型：局域能量 gauge 与积分边界项</strong>
    <span lang="en">Original interactive model: local-energy gauge and integral boundary terms</span>
  </figcaption>

  <div class="chapter-visual__controls energy-gauge__controls">
    <label>
      <span>gauge amplitude λ | gauge 振幅</span>
      <input type="range" min="-0.8" max="0.8" step="0.05" value={densityModelDefaults.energyGauge.gaugeAmplitude} data-energy-gauge-amplitude />
      <output data-energy-gauge-amplitude-output>{densityModelDefaults.energyGauge.gaugeAmplitude.toFixed(2)}</output>
    </label>
    <label>
      <span>region end b/π | 子区域终点</span>
      <input type="range" min="0.45" max="1.85" step="0.05" value={(densityModelDefaults.energyGauge.regionEnd / Math.PI).toFixed(2)} data-energy-gauge-region />
      <output data-energy-gauge-region-output>{(densityModelDefaults.energyGauge.regionEnd / Math.PI).toFixed(2)}</output>
    </label>
  </div>

  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="energy-gauge-title energy-gauge-desc">
    <title id="energy-gauge-title">Two pointwise energy densities related by a periodic total derivative</title>
    <desc id="energy-gauge-desc">
      A base energy density and a gauge-transformed density differ pointwise by the derivative of lambda sine x. Their full-cell integrals agree, while the integral over a selected subregion changes by an endpoint term.
    </desc>
    <rect x={xMap(densityModelDefaults.energyGauge.regionStart)} y={top} width={xMap(densityModelDefaults.energyGauge.regionEnd) - xMap(densityModelDefaults.energyGauge.regionStart)} height={bottom - top} class="energy-gauge__region" data-energy-gauge-region-rect />
    <line x1={left} y1={bottom} x2={right} y2={bottom} class="plot-axis" />
    <line x1={left} y1={top} x2={left} y2={bottom} class="plot-axis" />
    <path d={basePath} class="energy-gauge__base" />
    <path d={transformedPath} class="plot-curve" data-energy-gauge-path />
    <line x1={xMap(densityModelDefaults.energyGauge.regionStart)} y1={top} x2={xMap(densityModelDefaults.energyGauge.regionStart)} y2={bottom} class="energy-gauge__boundary" />
    <line x1={xMap(densityModelDefaults.energyGauge.regionEnd)} y1={top} x2={xMap(densityModelDefaults.energyGauge.regionEnd)} y2={bottom} class="energy-gauge__boundary" data-energy-gauge-end />
    <text x={right} y="290" text-anchor="end">x</text>
    <text x="18" y="52">e(x)</text>
    <text x={right - 122} y="58" class="energy-gauge__base-label">base e</text>
    <text x={right - 122} y="80" class="energy-gauge__gauge-label">e + ∂x[λ sin x]</text>
    <text x={xMap(defaults.grid[regionStart])} y="310" text-anchor="middle">a</text>
    <text x={xMap(defaults.grid[regionEnd])} y="310" text-anchor="middle" data-energy-gauge-end-label>b</text>
  </svg>

  <div class="chapter-visual__readout energy-gauge__readout" aria-live="polite">
    <span>full-cell base integral</span><strong data-energy-gauge-total-base>{defaults.totalBase.toFixed(8)}</strong>
    <span>full-cell transformed</span><strong data-energy-gauge-total-transformed>{defaults.totalTransformed.toFixed(8)}</strong>
    <span>subregion shift</span><strong data-energy-gauge-region-shift>{defaults.regionShift.toFixed(8)}</strong>
    <span>endpoint prediction λ[sin b−sin a]</span><strong data-energy-gauge-boundary-shift>{defaults.analyticBoundaryShift.toFixed(8)}</strong>
  </div>

  <div class="energy-gauge__fallback">
    <p><strong>无 JavaScript 参考表 | No-JavaScript reference table</strong></p>
    <table>
      <thead><tr><th>λ</th><th>full base</th><th>full transformed</th><th>region shift</th></tr></thead>
      <tbody>
        {fallbackRows.map((entry) => (
          <tr>
            <td>{entry.gaugeAmplitude.toFixed(2)}</td>
            <td>{entry.totalBase.toFixed(7)}</td>
            <td>{entry.totalTransformed.toFixed(7)}</td>
            <td>{entry.regionShift.toFixed(7)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>周期区间 <code>[0,2π)</code> 上，<code>eλ(x)=e0(x)+∂x[λ sin x]=e0(x)+λ cos x</code>。阴影区域为 <code>[a,b)</code>。</p>
    <p lang="en"><strong>Model:</strong> on the periodic interval <code>[0,2π)</code>, <code>eλ(x)=e0(x)+∂x[λ sin x]=e0(x)+λ cos x</code>. The shaded region is <code>[a,b)</code>.</p>
    <p><strong>验收：</strong>完整周期积分对 λ 不变；子区域积分改变，且精确等于 endpoint flux <code>λ[sin b−sin a]</code>。令区域覆盖完整周期后该差异归零。</p>
    <p lang="en"><strong>Acceptance:</strong> the full-period integral is independent of λ. A subregion integral changes by the endpoint flux <code>λ[sin b−sin a]</code>, which vanishes when the region covers the full period.</p>
    <p><strong>边界：</strong>这是 divergence-gauge 的一维展示。真实 energy density 还含 Coulomb、kinetic、XC、ionic/self/reference 分组；只有满足相应 periodic、decaying 或 matched-bulk boundary 的积分才可声明 gauge invariant。</p>
    <p lang="en"><strong>Boundary:</strong> this is a one-dimensional divergence-gauge demonstration. A real energy density also contains Coulomb, kinetic, XC, ionic, self, and reference partitions. Gauge invariance applies only to integrals with the corresponding periodic, decaying, or matched-bulk boundary.</p>
  </div>
</figure>

<script>
  import { periodicEnergyGauge } from '../../../data/part07/energyStressDensityModel.mjs';

  document.querySelectorAll('[data-energy-gauge]').forEach((root) => {
    const amplitude = root.querySelector('[data-energy-gauge-amplitude]');
    const region = root.querySelector('[data-energy-gauge-region]');
    if (!(amplitude instanceof HTMLInputElement) || !(region instanceof HTMLInputElement)) return;
    const path = root.querySelector('[data-energy-gauge-path]');
    const rect = root.querySelector('[data-energy-gauge-region-rect]');
    const endLine = root.querySelector('[data-energy-gauge-end]');
    const endLabel = root.querySelector('[data-energy-gauge-end-label]');
    const outputs = {
      amplitude: root.querySelector('[data-energy-gauge-amplitude-output]'), region: root.querySelector('[data-energy-gauge-region-output]'),
      totalBase: root.querySelector('[data-energy-gauge-total-base]'), totalTransformed: root.querySelector('[data-energy-gauge-total-transformed]'), regionShift: root.querySelector('[data-energy-gauge-region-shift]'), boundaryShift: root.querySelector('[data-energy-gauge-boundary-shift]'),
    };
    const left = 60; const right = 680; const top = 40; const bottom = 260; const yMin = 0.25; const yMax = 2.1;
    const xMap = (x) => left + (right - left) * x / (2 * Math.PI);
    const yMap = (value) => bottom - (value - yMin) * (bottom - top) / (yMax - yMin);
    const update = () => {
      const gaugeAmplitude = Number(amplitude.value);
      const regionEnd = Number(region.value) * Math.PI;
      const result = periodicEnergyGauge({ gaugeAmplitude, regionEnd });
      const curve = result.transformed.map((value, index) => `${index === 0 ? 'M' : 'L'} ${xMap(result.grid[index]).toFixed(2)} ${yMap(value).toFixed(2)}`).join(' ');
      if (path instanceof SVGPathElement) path.setAttribute('d', curve);
      const startX = xMap(0.3 * Math.PI); const endX = xMap(regionEnd);
      if (rect instanceof SVGRectElement) rect.setAttribute('width', Math.max(0, endX - startX).toFixed(2));
      if (endLine instanceof SVGLineElement) { endLine.setAttribute('x1', endX.toFixed(2)); endLine.setAttribute('x2', endX.toFixed(2)); }
      if (endLabel instanceof SVGTextElement) endLabel.setAttribute('x', endX.toFixed(2));
      if (outputs.amplitude instanceof HTMLOutputElement) outputs.amplitude.value = gaugeAmplitude.toFixed(2);
      if (outputs.region instanceof HTMLOutputElement) outputs.region.value = (regionEnd / Math.PI).toFixed(2);
      if (outputs.totalBase instanceof HTMLElement) outputs.totalBase.textContent = result.totalBase.toFixed(8);
      if (outputs.totalTransformed instanceof HTMLElement) outputs.totalTransformed.textContent = result.totalTransformed.toFixed(8);
      if (outputs.regionShift instanceof HTMLElement) outputs.regionShift.textContent = result.regionShift.toFixed(8);
      if (outputs.boundaryShift instanceof HTMLElement) outputs.boundaryShift.textContent = result.analyticBoundaryShift.toFixed(8);
    };
    [amplitude, region].forEach((input) => input.addEventListener('input', update));
    update();
  });
</script>

<style>
  .energy-gauge { overflow-x: auto; }
  .energy-gauge svg { width: 100%; min-width: 42rem; }
  .energy-gauge text { fill: currentColor; font-size: 13px; }
  .energy-gauge__region { fill: var(--sl-color-accent-low); opacity: 0.35; }
  .energy-gauge__base { fill: none; stroke: currentColor; stroke-width: 2.2; stroke-dasharray: 8 5; }
  .energy-gauge__boundary { stroke: var(--sl-color-gray-3); stroke-width: 1.3; }
  .energy-gauge__base-label { fill: currentColor; }
  .energy-gauge__gauge-label { fill: var(--sl-color-accent-high); }
  .energy-gauge__controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1rem; }
  .energy-gauge__controls label { display: grid; gap: 0.35rem; }
  .energy-gauge__readout { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 0.4rem 1rem; }
  .energy-gauge__fallback { max-width: 46rem; }
</style>
