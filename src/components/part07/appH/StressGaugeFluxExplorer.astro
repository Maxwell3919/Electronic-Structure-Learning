---
import { densityModelDefaults, stressGaugeSurfaceFlux } from '../../../data/part07/energyStressDensityModel.mjs';

const defaults = stressGaugeSurfaceFlux();
const width = 760;
const height = 350;
const leftPanel = { left: 55, right: 355, top: 55, bottom: 270 };
const rightPanel = { left: 430, right: 720, top: 55, bottom: 270 };
const xMapLeft = (y) => leftPanel.left + (leftPanel.right - leftPanel.left) * y / (2 * Math.PI);
const yValues = defaults.samples.map((sample) => sample.tensor[0][0]);
const maxAbs = Math.max(...yValues.map(Math.abs), Math.abs(defaults.baseFlux[0] / (2 * Math.PI)), 1e-12);
const yMapLeft = (value) => (leftPanel.top + leftPanel.bottom) / 2 - value * (leftPanel.bottom - leftPanel.top) * 0.42 / maxAbs;
const transformedPath = yValues.map((value, index) => `${index === 0 ? 'M' : 'L'} ${xMapLeft(defaults.yGrid[index]).toFixed(2)} ${yMapLeft(value).toFixed(2)}`).join(' ');
const baseValue = densityModelDefaults.stressGauge.baseAmplitude * Math.sin(densityModelDefaults.stressGauge.surfaceX);
const basePath = `M ${leftPanel.left} ${yMapLeft(baseValue).toFixed(2)} L ${leftPanel.right} ${yMapLeft(baseValue).toFixed(2)}`;
const xMapRight = (x) => rightPanel.left + (rightPanel.right - rightPanel.left) * x / (2 * Math.PI);
const yMapRight = (value) => (rightPanel.top + rightPanel.bottom) / 2 - value * (rightPanel.bottom - rightPanel.top) * 0.42 / densityModelDefaults.stressGauge.baseAmplitude;
const forcePath = defaults.yGrid.map((x, index) => `${index === 0 ? 'M' : 'L'} ${xMapRight(x).toFixed(2)} ${yMapRight(densityModelDefaults.stressGauge.baseAmplitude * Math.cos(x)).toFixed(2)}`).join(' ');
const fallbackRows = [0, 0.55, 1.0].map((gaugeAmplitude) => ({ gaugeAmplitude, ...stressGaugeSurfaceFlux({ gaugeAmplitude }) }));
---

<figure class="chapter-visual stress-gauge-flux" data-stress-gauge-flux>
  <figcaption>
    <strong>原创交互模型：stress-density gauge、相同 force density 与表面通量</strong>
    <span lang="en">Original interactive model: stress-density gauge, identical force density, and surface flux</span>
  </figcaption>

  <div class="chapter-visual__controls stress-gauge-flux__controls">
    <label>
      <span>Airy gauge amplitude A | gauge 振幅</span>
      <input type="range" min="-1.2" max="1.2" step="0.1" value={densityModelDefaults.stressGauge.gaugeAmplitude} data-stress-gauge-amplitude />
      <output data-stress-gauge-amplitude-output>{densityModelDefaults.stressGauge.gaugeAmplitude.toFixed(2)}</output>
    </label>
    <label>
      <span>cut position x0/π | 截面位置</span>
      <input type="range" min="0.10" max="1.90" step="0.05" value={(densityModelDefaults.stressGauge.surfaceX / Math.PI).toFixed(2)} data-stress-gauge-surface />
      <output data-stress-gauge-surface-output>{(densityModelDefaults.stressGauge.surfaceX / Math.PI).toFixed(2)}</output>
    </label>
  </div>

  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="stress-gauge-title stress-gauge-desc">
    <title id="stress-gauge-title">Gauge-dependent local traction and gauge-invariant force density and integrated traction</title>
    <desc id="stress-gauge-desc">
      The left panel compares the local normal traction along a periodic cut before and after adding a divergence-free Airy stress gauge. The curves differ locally but have the same integral. The right panel shows the force density, which is unchanged by the gauge.
    </desc>
    <rect x="30" y="30" width="350" height="270" rx="12" class="stress-gauge-flux__panel" />
    <rect x="405" y="30" width="340" height="270" rx="12" class="stress-gauge-flux__panel" />
    <text x="205" y="52" text-anchor="middle">traction σxx(x0,y) on a full periodic cut</text>
    <line x1={leftPanel.left} y1={(leftPanel.top + leftPanel.bottom) / 2} x2={leftPanel.right} y2={(leftPanel.top + leftPanel.bottom) / 2} class="plot-guide" />
    <line x1={leftPanel.left} y1={leftPanel.bottom} x2={leftPanel.right} y2={leftPanel.bottom} class="plot-axis" />
    <line x1={leftPanel.left} y1={leftPanel.top} x2={leftPanel.left} y2={leftPanel.bottom} class="plot-axis" />
    <path d={basePath} class="stress-gauge-flux__base" data-stress-gauge-base-path />
    <path d={transformedPath} class="plot-curve" data-stress-gauge-path />
    <text x={leftPanel.right} y="292" text-anchor="end">y</text>
    <text x="42" y="70">traction</text>

    <text x="575" y="52" text-anchor="middle">force density f=∇·σ</text>
    <line x1={rightPanel.left} y1={(rightPanel.top + rightPanel.bottom) / 2} x2={rightPanel.right} y2={(rightPanel.top + rightPanel.bottom) / 2} class="plot-guide" />
    <line x1={rightPanel.left} y1={rightPanel.bottom} x2={rightPanel.right} y2={rightPanel.bottom} class="plot-axis" />
    <line x1={rightPanel.left} y1={rightPanel.top} x2={rightPanel.left} y2={rightPanel.bottom} class="plot-axis" />
    <path d={forcePath} class="stress-gauge-flux__force" />
    <line x1={xMapRight(densityModelDefaults.stressGauge.surfaceX)} y1={rightPanel.top} x2={xMapRight(densityModelDefaults.stressGauge.surfaceX)} y2={rightPanel.bottom} class="stress-gauge-flux__cut" data-stress-gauge-cut />
    <text x={rightPanel.right} y="292" text-anchor="end">x</text>
    <text x="415" y="70">fx</text>
  </svg>

  <div class="chapter-visual__readout stress-gauge-flux__readout" aria-live="polite">
    <span>base cut flux Fx</span><strong data-stress-gauge-base-flux>{defaults.baseFlux[0].toFixed(8)}</strong>
    <span>gauge-transformed Fx</span><strong data-stress-gauge-transformed-flux>{defaults.transformedFlux[0].toFixed(8)}</strong>
    <span>transverse flux Fy</span><strong data-stress-gauge-transverse-flux>{defaults.transformedFlux[1].toExponential(3)}</strong>
    <span>flux difference norm</span><strong data-stress-gauge-flux-error>{Math.hypot(...defaults.fluxDifference).toExponential(3)}</strong>
    <span>gauge divergence</span><strong>exactly zero</strong>
  </div>

  <div class="stress-gauge-flux__fallback">
    <p><strong>无 JavaScript 参考表 | No-JavaScript reference table</strong></p>
    <table>
      <thead><tr><th>A</th><th>base Fx</th><th>transformed Fx</th><th>Fy</th></tr></thead>
      <tbody>
        {fallbackRows.map((entry) => (
          <tr>
            <td>{entry.gaugeAmplitude.toFixed(2)}</td>
            <td>{entry.baseFlux[0].toFixed(7)}</td>
            <td>{entry.transformedFlux[0].toFixed(7)}</td>
            <td>{entry.transformedFlux[1].toExponential(2)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>二维 base stress <code>σxx=B sin x</code> 产生 <code>fx=B cos x</code>。加入 Airy function <code>χ=A sin x sin y</code> 生成的 symmetric、divergence-free tensor：<code>δσxx=∂yyχ</code>、<code>δσyy=∂xxχ</code>、<code>δσxy=−∂xyχ</code>。</p>
    <p lang="en"><strong>Model:</strong> a two-dimensional base stress <code>σxx=B sin x</code> produces <code>fx=B cos x</code>. A symmetric divergence-free tensor is added from the Airy function <code>χ=A sin x sin y</code>: <code>δσxx=∂yyχ</code>, <code>δσyy=∂xxχ</code>, and <code>δσxy=−∂xyχ</code>.</p>
    <p><strong>验收：</strong>改变 A 会改变局域 stress 与 traction curve，但不改变 <code>∇·σ</code>；对完整 periodic cut 的 traction integral 不变，gauge contribution 的 surface flux 为零。</p>
    <p lang="en"><strong>Acceptance:</strong> changing A changes the local stress and traction curve but not <code>∇·σ</code>. The traction integral over a complete periodic cut is invariant because the gauge contribution has zero surface flux.</p>
    <p><strong>边界：</strong>在多维空间，从 divergence 不能唯一恢复 stress。任意有限 patch、开放边界或不完整 surface 的 flux 可能保留 gauge/boundary term；只有声明的闭合或完整周期积分可接受为 invariant。</p>
    <p lang="en"><strong>Boundary:</strong> in more than one dimension, stress is not uniquely reconstructed from its divergence. A finite patch, open boundary, or incomplete surface can retain gauge or boundary terms. Only the declared closed or complete-periodic integral is accepted as invariant.</p>
  </div>
</figure>

<script>
  import { stressGaugeSurfaceFlux } from '../../../data/part07/energyStressDensityModel.mjs';

  document.querySelectorAll('[data-stress-gauge-flux]').forEach((root) => {
    const amplitude = root.querySelector('[data-stress-gauge-amplitude]');
    const surface = root.querySelector('[data-stress-gauge-surface]');
    if (!(amplitude instanceof HTMLInputElement) || !(surface instanceof HTMLInputElement)) return;
    const path = root.querySelector('[data-stress-gauge-path]');
    const basePath = root.querySelector('[data-stress-gauge-base-path]');
    const cut = root.querySelector('[data-stress-gauge-cut]');
    const outputs = {
      amplitude: root.querySelector('[data-stress-gauge-amplitude-output]'), surface: root.querySelector('[data-stress-gauge-surface-output]'),
      baseFlux: root.querySelector('[data-stress-gauge-base-flux]'), transformedFlux: root.querySelector('[data-stress-gauge-transformed-flux]'), transverseFlux: root.querySelector('[data-stress-gauge-transverse-flux]'), error: root.querySelector('[data-stress-gauge-flux-error]'),
    };
    const leftPanel = { left: 55, right: 355, top: 55, bottom: 270 };
    const rightPanel = { left: 430, right: 720, top: 55, bottom: 270 };
    const xMapLeft = (y) => leftPanel.left + (leftPanel.right - leftPanel.left) * y / (2 * Math.PI);
    const xMapRight = (x) => rightPanel.left + (rightPanel.right - rightPanel.left) * x / (2 * Math.PI);
    const update = () => {
      const gaugeAmplitude = Number(amplitude.value);
      const surfaceX = Number(surface.value) * Math.PI;
      const result = stressGaugeSurfaceFlux({ gaugeAmplitude, surfaceX });
      const values = result.samples.map((sample) => sample.tensor[0][0]);
      const baseValue = 0.7 * Math.sin(surfaceX);
      const maxAbs = Math.max(...values.map(Math.abs), Math.abs(baseValue), 1e-12);
      const yMap = (value) => (leftPanel.top + leftPanel.bottom) / 2 - value * (leftPanel.bottom - leftPanel.top) * 0.42 / maxAbs;
      const curve = values.map((value, index) => `${index === 0 ? 'M' : 'L'} ${xMapLeft(result.yGrid[index]).toFixed(2)} ${yMap(value).toFixed(2)}`).join(' ');
      if (path instanceof SVGPathElement) path.setAttribute('d', curve);
      if (basePath instanceof SVGPathElement) basePath.setAttribute('d', `M ${leftPanel.left} ${yMap(baseValue).toFixed(2)} L ${leftPanel.right} ${yMap(baseValue).toFixed(2)}`);
      if (cut instanceof SVGLineElement) { const x = xMapRight(surfaceX); cut.setAttribute('x1', x.toFixed(2)); cut.setAttribute('x2', x.toFixed(2)); }
      if (outputs.amplitude instanceof HTMLOutputElement) outputs.amplitude.value = gaugeAmplitude.toFixed(2);
      if (outputs.surface instanceof HTMLOutputElement) outputs.surface.value = (surfaceX / Math.PI).toFixed(2);
      if (outputs.baseFlux instanceof HTMLElement) outputs.baseFlux.textContent = result.baseFlux[0].toFixed(8);
      if (outputs.transformedFlux instanceof HTMLElement) outputs.transformedFlux.textContent = result.transformedFlux[0].toFixed(8);
      if (outputs.transverseFlux instanceof HTMLElement) outputs.transverseFlux.textContent = result.transformedFlux[1].toExponential(3);
      if (outputs.error instanceof HTMLElement) outputs.error.textContent = Math.hypot(...result.fluxDifference).toExponential(3);
    };
    [amplitude, surface].forEach((input) => input.addEventListener('input', update));
    update();
  });
</script>

<style>
  .stress-gauge-flux { overflow-x: auto; }
  .stress-gauge-flux svg { width: 100%; min-width: 44rem; }
  .stress-gauge-flux text { fill: currentColor; font-size: 12px; }
  .stress-gauge-flux__panel { fill: var(--sl-color-gray-6); stroke: var(--sl-color-gray-4); stroke-width: 2; }
  .stress-gauge-flux__base { fill: none; stroke: currentColor; stroke-width: 2.2; stroke-dasharray: 8 5; }
  .stress-gauge-flux__force { fill: none; stroke: var(--sl-color-gray-2); stroke-width: 2.5; }
  .stress-gauge-flux__cut { stroke: var(--sl-color-accent-high); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .stress-gauge-flux__controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1rem; }
  .stress-gauge-flux__controls label { display: grid; gap: 0.35rem; }
  .stress-gauge-flux__readout { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.4rem 1rem; }
  .stress-gauge-flux__fallback { max-width: 44rem; }
</style>
