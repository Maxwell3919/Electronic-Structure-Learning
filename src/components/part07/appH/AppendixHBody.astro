---
import AppendixHContents from './AppendixHContents.astro';
import AppendixHOrientation from './AppendixHOrientation.mdx';
import AppendixHEnergyDensity from './AppendixHEnergyDensity.mdx';
import AppendixHStressIntegrated from './AppendixHStressIntegrated.mdx';
import AppendixHElfReview from './AppendixHElfReview.mdx';
---

<div class="appendix-h-root">
  <AppendixHContents />
  <AppendixHOrientation />
  <AppendixHEnergyDensity />
  <AppendixHStressIntegrated />
  <AppendixHElfReview />
</div>

<style is:global>
  .appendix-h-root,
  .appendix-h-root > *,
  .appendix-h-root .bilingual-section,
  .appendix-h-root .bilingual-section__grid,
  .appendix-h-root .bilingual-section__zh,
  .appendix-h-root .bilingual-section__en,
  .appendix-h-root .bilingual-callout,
  .appendix-h-root .bilingual-callout__grid {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .appendix-h-root .chapter-visual {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin-inline: 0;
    box-sizing: border-box;
  }

  .appendix-h-root .chapter-source-map,
  .appendix-h-root .katex-display,
  .appendix-h-root pre,
  .appendix-h-root table {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .appendix-h-root p,
  .appendix-h-root li,
  .appendix-h-root th,
  .appendix-h-root td,
  .appendix-h-root code {
    overflow-wrap: anywhere;
  }
</style>
