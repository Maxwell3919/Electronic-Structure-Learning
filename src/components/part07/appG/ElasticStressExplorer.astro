---
import { cubicNormalElasticResponse } from '../../../data/part07/stressStrainModel.mjs';

const defaultC11 = 1.8;
const defaultC12 = 0.7;
const defaultAmplitude = 0.05;
const modeStrain = (mode, amplitude) => mode === 'hydrostatic'
  ? [amplitude, amplitude, amplitude]
  : mode === 'uniaxial'
    ? [amplitude, 0, 0]
    : [amplitude, -0.5 * amplitude, -0.5 * amplitude];
const defaults = cubicNormalElasticResponse({ C11: defaultC11, C12: defaultC12, strain: modeStrain('hydrostatic', defaultAmplitude) });
const fallback = ['hydrostatic', 'uniaxial', 'tetragonal'].map((mode) => ({
  mode,
  ...cubicNormalElasticResponse({ C11: defaultC11, C12: defaultC12, strain: modeStrain(mode, defaultAmplitude) }),
}));
const width = 720;
const height = 320;
const left = 62;
const right = 680;
const top = 42;
const bottom = 250;
const xMap = (value) => left + (right - left) * (value + 0.1) / 0.2;
const yMap = (value) => bottom - Math.min(0.04, Math.max(0, value)) * (bottom - top) / 0.04;
const energyPath = Array.from({ length: 101 }, (_, index) => {
  const amplitude = -0.1 + 0.2 * index / 100;
  const value = cubicNormalElasticResponse({ C11: defaultC11, C12: defaultC12, strain: modeStrain('hydrostatic', amplitude) }).energyDensity;
  return `${index === 0 ? 'M' : 'L'} ${xMap(amplitude).toFixed(2)} ${yMap(value).toFixed(2)}`;
}).join(' ');
---

<figure class="chapter-visual elastic-stress" data-elastic-stress>
  <figcaption>
    <strong>原创交互模型：能量曲率、内部应力与压力符号</strong>
    <span lang="en">Original interactive model: energy curvature, internal stress, and pressure sign</span>
  </figcaption>

  <div class="chapter-visual__controls elastic-stress__controls">
    <label>
      <span>strain path | 应变路径</span>
      <select data-elastic-mode>
        <option value="hydrostatic">hydrostatic: (η,η,η)</option>
        <option value="uniaxial">uniaxial: (η,0,0)</option>
        <option value="tetragonal">volume-preserving first order: (η,-η/2,-η/2)</option>
      </select>
    </label>
    <label>
      <span>amplitude η</span>
      <input type="range" min="-0.10" max="0.10" step="0.005" value={defaultAmplitude} data-elastic-amplitude />
      <output data-elastic-amplitude-output>{defaultAmplitude.toFixed(3)}</output>
    </label>
    <label>
      <span>C11</span>
      <input type="range" min="0.8" max="3.0" step="0.1" value={defaultC11} data-elastic-c11 />
      <output data-elastic-c11-output>{defaultC11.toFixed(1)}</output>
    </label>
    <label>
      <span>C12</span>
      <input type="range" min="-0.2" max="1.2" step="0.1" value={defaultC12} data-elastic-c12 />
      <output data-elastic-c12-output>{defaultC12.toFixed(1)}</output>
    </label>
  </div>

  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="elastic-title elastic-desc">
    <title id="elastic-title">Elastic energy density along a strain path and the conjugate Martin internal stress</title>
    <desc id="elastic-desc">
      A stable cubic normal-strain energy is plotted as a quadratic function of strain amplitude. The selected point reports the negative energy derivative used by Martin as internal stress and the associated pressure.
    </desc>
    <line x1={left} y1={bottom} x2={right} y2={bottom} class="plot-axis" />
    <line x1={left} y1={top} x2={left} y2={bottom} class="plot-axis" />
    <line x1={xMap(0)} y1={top} x2={xMap(0)} y2={bottom} class="plot-guide" />
    <path d={energyPath} class="plot-curve" data-elastic-energy-path />
    <circle cx={xMap(defaultAmplitude)} cy={yMap(defaults.energyDensity)} r="6" class="elastic-stress__probe" data-elastic-probe />
    <text x={right} y="282" text-anchor="end">η</text>
    <text x="18" y="54">E/Ω</text>
    <text x={xMap(-0.1)} y="275" text-anchor="middle">−0.10</text>
    <text x={xMap(0)} y="275" text-anchor="middle">0</text>
    <text x={xMap(0.1)} y="275" text-anchor="middle">0.10</text>
  </svg>

  <div class="chapter-visual__readout elastic-stress__readout" aria-live="polite">
    <span>energy density</span><strong data-elastic-energy>{defaults.energyDensity.toFixed(6)}</strong>
    <span>σxx internal</span><strong data-elastic-sxx>{defaults.internalStress[0].toFixed(6)}</strong>
    <span>σyy internal</span><strong data-elastic-syy>{defaults.internalStress[1].toFixed(6)}</strong>
    <span>pressure −Trσ/3</span><strong data-elastic-pressure>{defaults.pressure.toFixed(6)}</strong>
    <span>bulk modulus B</span><strong data-elastic-bulk>{defaults.bulkModulus.toFixed(6)}</strong>
    <span>C11−C12</span><strong data-elastic-tetragonal>{defaults.tetragonalModulus.toFixed(6)}</strong>
  </div>

  <div class="elastic-stress__fallback">
    <p><strong>无 JavaScript 参考表 | No-JavaScript reference table</strong></p>
    <table>
      <thead><tr><th>path at η=0.05</th><th>E/Ω</th><th>σxx</th><th>pressure</th></tr></thead>
      <tbody>
        {fallback.map((entry) => (
          <tr>
            <td>{entry.mode}</td>
            <td>{entry.energyDensity.toFixed(6)}</td>
            <td>{entry.internalStress[0].toFixed(6)}</td>
            <td>{entry.pressure.toFixed(6)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>cubic crystal 的 normal-strain energy density：<code>U=½C11Σuᵢ²+C12Σᵢ&lt;ⱼuᵢuⱼ</code>。内部应力严格按 Martin G.4 取 <code>σᵢ=−∂U/∂uᵢ</code>。</p>
    <p lang="en"><strong>Model:</strong> the normal-strain energy density of a cubic crystal is <code>U=½C11Σuᵢ²+C12Σᵢ&lt;ⱼuᵢuⱼ</code>. Internal stress follows Martin G.4 exactly: <code>σᵢ=−∂U/∂uᵢ</code>.</p>
    <p><strong>验收：</strong>能量在零应变处为极小；应力是能量斜率的负值；hydrostatic path 满足 <code>B=(C11+2C12)/3</code> 和 <code>P=3Bη</code>。正膨胀产生负的 restoring internal stress。</p>
    <p lang="en"><strong>Acceptance:</strong> energy is minimized at zero strain; stress is the negative energy slope; the hydrostatic path obeys <code>B=(C11+2C12)/3</code> and <code>P=3Bη</code>. Positive expansion produces a negative restoring internal stress.</p>
    <p><strong>边界：</strong>只含小 normal strain 与 clamped-ion harmonic energy，不含 shear convention、finite-strain stress measure、温度、零点振动、Pulay stress 或 internal relaxation。</p>
    <p lang="en"><strong>Boundary:</strong> only small normal strain and clamped-ion harmonic energy are included. Shear conventions, finite-strain stress measures, temperature, zero-point motion, Pulay stress, and internal relaxation are omitted.</p>
  </div>
</figure>

<script>
  import { cubicNormalElasticResponse } from '../../../data/part07/stressStrainModel.mjs';

  document.querySelectorAll('[data-elastic-stress]').forEach((root) => {
    const mode = root.querySelector('[data-elastic-mode]');
    const amplitude = root.querySelector('[data-elastic-amplitude]');
    const c11 = root.querySelector('[data-elastic-c11]');
    const c12 = root.querySelector('[data-elastic-c12]');
    if (!(mode instanceof HTMLSelectElement) || !(amplitude instanceof HTMLInputElement)
      || !(c11 instanceof HTMLInputElement) || !(c12 instanceof HTMLInputElement)) return;
    const path = root.querySelector('[data-elastic-energy-path]');
    const probe = root.querySelector('[data-elastic-probe]');
    const values = {
      amplitude: root.querySelector('[data-elastic-amplitude-output]'), c11: root.querySelector('[data-elastic-c11-output]'), c12: root.querySelector('[data-elastic-c12-output]'),
      energy: root.querySelector('[data-elastic-energy]'), sxx: root.querySelector('[data-elastic-sxx]'), syy: root.querySelector('[data-elastic-syy]'), pressure: root.querySelector('[data-elastic-pressure]'), bulk: root.querySelector('[data-elastic-bulk]'), tetragonal: root.querySelector('[data-elastic-tetragonal]'),
    };
    const left = 62; const right = 680; const top = 42; const bottom = 250;
    const xMap = (value) => left + (right - left) * (value + 0.1) / 0.2;
    const yMap = (value) => bottom - Math.min(0.08, Math.max(0, value)) * (bottom - top) / 0.08;
    const strainFor = (selected, eta) => selected === 'hydrostatic' ? [eta, eta, eta] : selected === 'uniaxial' ? [eta, 0, 0] : [eta, -0.5 * eta, -0.5 * eta];
    const update = () => {
      const selected = mode.value;
      const eta = Number(amplitude.value);
      const C11 = Number(c11.value);
      const C12 = Number(c12.value);
      let result;
      try { result = cubicNormalElasticResponse({ C11, C12, strain: strainFor(selected, eta) }); }
      catch { return; }
      const samples = Array.from({ length: 101 }, (_, index) => {
        const sample = -0.1 + 0.2 * index / 100;
        const response = cubicNormalElasticResponse({ C11, C12, strain: strainFor(selected, sample) });
        return `${index === 0 ? 'M' : 'L'} ${xMap(sample).toFixed(2)} ${yMap(response.energyDensity).toFixed(2)}`;
      }).join(' ');
      if (path instanceof SVGPathElement) path.setAttribute('d', samples);
      if (probe instanceof SVGCircleElement) { probe.setAttribute('cx', xMap(eta).toFixed(2)); probe.setAttribute('cy', yMap(result.energyDensity).toFixed(2)); }
      if (values.amplitude instanceof HTMLOutputElement) values.amplitude.value = eta.toFixed(3);
      if (values.c11 instanceof HTMLOutputElement) values.c11.value = C11.toFixed(1);
      if (values.c12 instanceof HTMLOutputElement) values.c12.value = C12.toFixed(1);
      if (values.energy instanceof HTMLElement) values.energy.textContent = result.energyDensity.toFixed(6);
      if (values.sxx instanceof HTMLElement) values.sxx.textContent = result.internalStress[0].toFixed(6);
      if (values.syy instanceof HTMLElement) values.syy.textContent = result.internalStress[1].toFixed(6);
      if (values.pressure instanceof HTMLElement) values.pressure.textContent = result.pressure.toFixed(6);
      if (values.bulk instanceof HTMLElement) values.bulk.textContent = result.bulkModulus.toFixed(6);
      if (values.tetragonal instanceof HTMLElement) values.tetragonal.textContent = result.tetragonalModulus.toFixed(6);
    };
    [mode, amplitude, c11, c12].forEach((input) => input.addEventListener('input', update));
    update();
  });
</script>

<style>
  .elastic-stress { overflow-x: auto; }
  .elastic-stress svg { width: 100%; min-width: 42rem; }
  .elastic-stress text { fill: currentColor; font-size: 13px; }
  .elastic-stress__probe { fill: var(--sl-color-accent-high); stroke: var(--sl-color-gray-7); stroke-width: 2; }
  .elastic-stress__controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 0.8rem; }
  .elastic-stress__controls label { display: grid; gap: 0.3rem; }
  .elastic-stress__readout { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 0.4rem 1rem; }
  .elastic-stress__fallback { max-width: 45rem; }
</style>
