---
import { pairVirialStress, hartreeModeStress, kineticModeStress } from '../../../data/part07/stressStrainModel.mjs';

const vectorFromAngle = (angleDegrees, magnitude = 1.4) => {
  const angle = angleDegrees * Math.PI / 180;
  return [magnitude * Math.cos(angle), magnitude * Math.sin(angle), 0];
};
const defaults = pairVirialStress({ vector: vectorFromAngle(32), dVdr: 0.9, volume: 2.5 });
const modeRows = [
  { mode: 'pair virial', result: pairVirialStress({ vector: [1.2, 0.8, 0], dVdr: 0.9, volume: 2.5 }) },
  { mode: 'Hartree G mode', result: hartreeModeStress({ wavevector: [1.2, 0.8, 0], densityAmplitude: 0.35 }) },
  { mode: 'kinetic p mode', result: kineticModeStress({ momentum: [1.2, 0.8, 0], occupationWeight: 0.7 }) },
];
const cellX = (column) => 390 + column * 72;
const cellY = (row) => 72 + row * 72;
const opacityFor = (value, maxValue) => Math.min(0.9, 0.15 + 0.75 * Math.abs(value) / Math.max(maxValue, 1e-12));
const maxDefault = Math.max(...defaults.tensor.flat().map(Math.abs));
---

<figure class="chapter-visual stress-contribution" data-stress-contribution>
  <figcaption>
    <strong>原创交互模型：pair、Hartree 与 kinetic stress 的 dyadic 结构</strong>
    <span lang="en">Original interactive model: dyadic structure of pair, Hartree, and kinetic stress</span>
  </figcaption>

  <div class="chapter-visual__controls stress-contribution__controls">
    <label>
      <span>contribution | 贡献类型</span>
      <select data-stress-mode>
        <option value="pair">central pair virial</option>
        <option value="hartree">single Hartree G mode</option>
        <option value="kinetic">single kinetic momentum mode</option>
      </select>
    </label>
    <label>
      <span>orientation φ | 方向</span>
      <input type="range" min="0" max="180" step="2" value="32" data-stress-angle />
      <output data-stress-angle-output>32°</output>
    </label>
    <label>
      <span>magnitude | 向量长度</span>
      <input type="range" min="0.5" max="2.2" step="0.1" value="1.4" data-stress-magnitude />
      <output data-stress-magnitude-output>1.4</output>
    </label>
    <label>
      <span>weight | 权重</span>
      <input type="range" min="-1.2" max="1.2" step="0.1" value="0.9" data-stress-weight />
      <output data-stress-weight-output>0.9</output>
    </label>
  </div>

  <svg viewBox="0 0 700 330" role="img" aria-labelledby="stress-contribution-title stress-contribution-desc">
    <title id="stress-contribution-title">Directional vector and the corresponding three by three stress tensor</title>
    <desc id="stress-contribution-desc">
      The left panel shows the orientation of a pair separation, reciprocal vector, or momentum. The right panel shows the tensor components. Pair and kinetic modes are rank-one dyadics; a Hartree mode has one longitudinal and two transverse eigenvalues.
    </desc>
    <rect x="28" y="40" width="285" height="240" rx="12" class="stress-contribution__panel" />
    <rect x="350" y="40" width="320" height="240" rx="12" class="stress-contribution__panel" />
    <text x="170" y="70" text-anchor="middle">direction in x-y plane</text>
    <line x1="70" y1="205" x2="275" y2="205" class="plot-axis" />
    <line x1="170" y1="265" x2="170" y2="92" class="plot-axis" />
    <line x1="170" y1="205" x2="276" y2="138" class="stress-contribution__vector" data-stress-vector />
    <circle cx="170" cy="205" r="5" class="stress-contribution__origin" />
    <text x="286" y="221">x</text>
    <text x="157" y="92">y</text>
    <text x="170" y="252" text-anchor="middle" data-stress-mode-label>pair virial</text>

    <text x="510" y="69" text-anchor="middle">σ or contribution tensor</text>
    {[0, 1, 2].map((row) => [0, 1, 2].map((column) => {
      const value = defaults.tensor[row][column];
      return (
        <g>
          <rect
            x={cellX(column)} y={cellY(row)} width="62" height="62" rx="6"
            class={value >= 0 ? 'stress-contribution__cell-positive' : 'stress-contribution__cell-negative'}
            style={`opacity:${opacityFor(value, maxDefault)}`}
            data-stress-cell={`${row}-${column}`}
          />
          <text x={cellX(column) + 31} y={cellY(row) + 37} text-anchor="middle" data-stress-cell-text={`${row}-${column}`}>{value.toFixed(3)}</text>
        </g>
      );
    }))}
    <text x="379" y="113">x</text><text x="379" y="185">y</text><text x="379" y="257">z</text>
    <text x="421" y="292">x</text><text x="493" y="292">y</text><text x="565" y="292">z</text>
  </svg>

  <div class="chapter-visual__readout stress-contribution__readout" aria-live="polite">
    <span>trace</span><strong data-stress-trace>{defaults.trace.toFixed(6)}</strong>
    <span>pressure −Tr/3</span><strong data-stress-pressure>{defaults.pressure.toFixed(6)}</strong>
    <span>symmetry error</span><strong data-stress-symmetry>0.000000</strong>
    <span>tensor character</span><strong data-stress-character>rank-one longitudinal</strong>
  </div>

  <div class="stress-contribution__fallback">
    <p><strong>无 JavaScript 参考表 | No-JavaScript reference table</strong></p>
    <table>
      <thead><tr><th>mode</th><th>trace</th><th>xx</th><th>xy</th><th>yy</th></tr></thead>
      <tbody>
        {modeRows.map((entry) => (
          <tr>
            <td>{entry.mode}</td>
            <td>{entry.result.trace.toFixed(5)}</td>
            <td>{entry.result.tensor[0][0].toFixed(5)}</td>
            <td>{entry.result.tensor[0][1].toFixed(5)}</td>
            <td>{entry.result.tensor[1][1].toFixed(5)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>三种单贡献 tensor：central pair 的 <code>(dV/dr) r⊗r/(Ωr)</code>；Martin G.8 的单个 nonzero Hartree mode <code>A(2ĝ⊗ĝ−I)</code>；Martin G.10 的 normalized kinetic mode <code>B p⊗p</code>。</p>
    <p lang="en"><strong>Model:</strong> three single-contribution tensors are compared: a central pair <code>(dV/dr) r⊗r/(Ωr)</code>; one nonzero Hartree mode from Martin G.8, <code>A(2ĝ⊗ĝ−I)</code>; and a normalized kinetic mode from Martin G.10, <code>B p⊗p</code>.</p>
    <p><strong>验收：</strong>所有 tensor 均对称；pair 与 kinetic 为 rank-one dyadic；Hartree mode 沿 G 的 eigenvalue 为 <code>+A</code>，两个横向 eigenvalues 为 <code>−A</code>。转动向量只旋转 tensor，不改变其 invariants。</p>
    <p lang="en"><strong>Acceptance:</strong> every tensor is symmetric; pair and kinetic contributions are rank-one dyadics; the Hartree mode has eigenvalue <code>+A</code> along G and two transverse eigenvalues <code>−A</code>. Rotating the vector rotates the tensor without changing its invariants.</p>
    <p><strong>边界：</strong>这是单项结构展示，不是完整 DFT stress decomposition。完整结果还需 ionic、Hartree、XC、nonlocal pseudopotential、Ewald、basis/Pulay 等与所用 total-energy representation 一致的全部项。</p>
    <p lang="en"><strong>Boundary:</strong> this displays the structure of single terms, not a complete DFT stress decomposition. A full result requires every ionic, Hartree, XC, nonlocal-pseudopotential, Ewald, basis/Pulay, and representation-specific term.</p>
  </div>
</figure>

<script>
  import { pairVirialStress, hartreeModeStress, kineticModeStress } from '../../../data/part07/stressStrainModel.mjs';

  document.querySelectorAll('[data-stress-contribution]').forEach((root) => {
    const mode = root.querySelector('[data-stress-mode]');
    const angle = root.querySelector('[data-stress-angle]');
    const magnitude = root.querySelector('[data-stress-magnitude]');
    const weight = root.querySelector('[data-stress-weight]');
    if (!(mode instanceof HTMLSelectElement) || !(angle instanceof HTMLInputElement)
      || !(magnitude instanceof HTMLInputElement) || !(weight instanceof HTMLInputElement)) return;
    const vectorLine = root.querySelector('[data-stress-vector]');
    const modeLabel = root.querySelector('[data-stress-mode-label]');
    const outputs = {
      angle: root.querySelector('[data-stress-angle-output]'), magnitude: root.querySelector('[data-stress-magnitude-output]'), weight: root.querySelector('[data-stress-weight-output]'),
      trace: root.querySelector('[data-stress-trace]'), pressure: root.querySelector('[data-stress-pressure]'), symmetry: root.querySelector('[data-stress-symmetry]'), character: root.querySelector('[data-stress-character]'),
    };
    const update = () => {
      const phi = Number(angle.value) * Math.PI / 180;
      const length = Number(magnitude.value);
      const scalar = Number(weight.value);
      const vector = [length * Math.cos(phi), length * Math.sin(phi), 0];
      let result;
      let label;
      let character;
      if (mode.value === 'pair') {
        result = pairVirialStress({ vector, dVdr: scalar, volume: 2.5 });
        label = 'pair virial'; character = 'rank-one longitudinal';
      } else if (mode.value === 'hartree') {
        result = hartreeModeStress({ wavevector: vector, densityAmplitude: Math.abs(scalar) });
        label = 'Hartree G mode'; character = 'one longitudinal, two transverse';
      } else {
        result = kineticModeStress({ momentum: vector, occupationWeight: scalar });
        label = 'kinetic p mode'; character = 'rank-one longitudinal';
      }
      const tensor = result.tensor;
      const maxValue = Math.max(...tensor.flat().map(Math.abs), 1e-12);
      tensor.forEach((row, i) => row.forEach((entry, j) => {
        const cell = root.querySelector(`[data-stress-cell="${i}-${j}"]`);
        const text = root.querySelector(`[data-stress-cell-text="${i}-${j}"]`);
        if (cell instanceof SVGRectElement) {
          cell.setAttribute('class', entry >= 0 ? 'stress-contribution__cell-positive' : 'stress-contribution__cell-negative');
          cell.setAttribute('style', `opacity:${Math.min(0.9, 0.15 + 0.75 * Math.abs(entry) / maxValue)}`);
        }
        if (text instanceof SVGTextElement) text.textContent = entry.toFixed(3);
      }));
      if (vectorLine instanceof SVGLineElement) {
        vectorLine.setAttribute('x2', (170 + 95 * Math.cos(phi)).toFixed(2));
        vectorLine.setAttribute('y2', (205 - 95 * Math.sin(phi)).toFixed(2));
      }
      if (modeLabel instanceof SVGTextElement) modeLabel.textContent = label;
      if (outputs.angle instanceof HTMLOutputElement) outputs.angle.value = `${Number(angle.value).toFixed(0)}°`;
      if (outputs.magnitude instanceof HTMLOutputElement) outputs.magnitude.value = length.toFixed(1);
      if (outputs.weight instanceof HTMLOutputElement) outputs.weight.value = scalar.toFixed(1);
      if (outputs.trace instanceof HTMLElement) outputs.trace.textContent = result.trace.toFixed(6);
      if (outputs.pressure instanceof HTMLElement) outputs.pressure.textContent = (-(result.trace) / 3).toFixed(6);
      const symmetryError = Math.max(Math.abs(tensor[0][1] - tensor[1][0]), Math.abs(tensor[0][2] - tensor[2][0]), Math.abs(tensor[1][2] - tensor[2][1]));
      if (outputs.symmetry instanceof HTMLElement) outputs.symmetry.textContent = symmetryError.toFixed(6);
      if (outputs.character instanceof HTMLElement) outputs.character.textContent = character;
    };
    [mode, angle, magnitude, weight].forEach((input) => input.addEventListener('input', update));
    update();
  });
</script>

<style>
  .stress-contribution { overflow-x: auto; }
  .stress-contribution svg { width: 100%; min-width: 42rem; }
  .stress-contribution text { fill: currentColor; font-size: 13px; }
  .stress-contribution__panel { fill: var(--sl-color-gray-6); stroke: var(--sl-color-gray-4); stroke-width: 2; }
  .stress-contribution__vector { stroke: var(--sl-color-accent-high); stroke-width: 4; }
  .stress-contribution__origin { fill: currentColor; }
  .stress-contribution__cell-positive { fill: var(--sl-color-accent-high); stroke: var(--sl-color-gray-4); }
  .stress-contribution__cell-negative { fill: var(--sl-color-gray-2); stroke: var(--sl-color-gray-4); }
  .stress-contribution__controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 0.8rem; }
  .stress-contribution__controls label { display: grid; gap: 0.3rem; }
  .stress-contribution__readout { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.4rem 1rem; }
  .stress-contribution__fallback { max-width: 46rem; }
</style>
