---
import { alternativeForceDefaults, rectangularStressFlux } from '../../../data/part07/alternativeForceModel.mjs';

const defaults = alternativeForceDefaults.surface;
const initial = rectangularStressFlux(defaults);
const fallback = [0.2, 0.35, 0.6].map((crossingShear) => ({ crossingShear, ...rectangularStressFlux({ ...defaults, crossingShear }) }));
const x0 = 155; const x1 = 565; const y0 = 72; const y1 = 270;
const centreX = (x0 + x1) / 2; const centreY = (y0 + y1) / 2;
const scale = 42;
const arrow = (x, y, fx, fy) => ({ x1: x, y1: y, x2: x + scale * fx, y2: y - scale * fy });
const arrows = {
  right: arrow(x1, centreY, initial.faceFluxes.right[0] / initial.height, initial.faceFluxes.right[1] / initial.height),
  left: arrow(x0, centreY, initial.faceFluxes.left[0] / initial.height, initial.faceFluxes.left[1] / initial.height),
  top: arrow(centreX, y0, initial.faceFluxes.top[0] / initial.width, initial.faceFluxes.top[1] / initial.width),
  bottom: arrow(centreX, y1, initial.faceFluxes.bottom[0] / initial.width, initial.faceFluxes.bottom[1] / initial.width),
};
---

<figure class="chapter-visual surface-force" data-surface-force>
  <figcaption>
    <strong>原创交互模型：闭合曲面 traction 与体力积分</strong>
    <span lang="en">Original interactive model: closed-surface traction and the volume integral of force density</span>
  </figcaption>

  <div class="chapter-visual__controls surface-force__controls">
    <label>
      <span>normal gradient a | 法向梯度</span>
      <input type="range" min="-0.2" max="1.4" step="0.05" value={defaults.normalGradient} data-i-surface-normal />
      <output data-i-surface-normal-output>{defaults.normalGradient.toFixed(2)}</output>
    </label>
    <label>
      <span>crossing shear c | 交叉剪切</span>
      <input type="range" min="-0.7" max="0.9" step="0.05" value={defaults.crossingShear} data-i-surface-shear />
      <output data-i-surface-shear-output>{defaults.crossingShear.toFixed(2)}</output>
    </label>
  </div>

  <svg viewBox="0 0 720 350" role="img" aria-labelledby="surface-force-title surface-force-desc">
    <title id="surface-force-title">Traction fluxes through a rectangular closed surface</title>
    <desc id="surface-force-desc">Four face flux arrows sum to the volume integral of the divergence of a symmetric stress field; omitting one face leaves an edge error.</desc>
    <defs>
      <marker id="surface-force-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 0 0 L 10 5 L 0 10 z" /></marker>
    </defs>
    <rect x={x0} y={y0} width={x1 - x0} height={y1 - y0} class="surface-force__box" />
    <line {...arrows.right} class="surface-force__arrow" marker-end="url(#surface-force-arrow)" data-i-surface-right />
    <line {...arrows.left} class="surface-force__arrow" marker-end="url(#surface-force-arrow)" data-i-surface-left />
    <line {...arrows.top} class="surface-force__arrow" marker-end="url(#surface-force-arrow)" data-i-surface-top />
    <line {...arrows.bottom} class="surface-force__arrow" marker-end="url(#surface-force-arrow)" data-i-surface-bottom />
    <text x={centreX} y="42" text-anchor="middle">complete closed surface S</text>
    <text x={centreX} y="315" text-anchor="middle">∮S σ·n dS = ∫V div σ dV</text>
    <text x={x1 + 28} y={centreY}>right</text>
    <text x={x0 - 28} y={centreY} text-anchor="end">left</text>
  </svg>

  <div class="chapter-visual__readout" aria-live="polite">
    <span>closed flux Fx</span><strong data-i-surface-closed-x>{initial.closedSurfaceFlux[0].toFixed(7)}</strong>
    <span>volume force Fx</span><strong data-i-surface-volume-x>{initial.volumeForce[0].toFixed(7)}</strong>
    <span>closed error</span><strong data-i-surface-closed-error>{Math.max(...initial.closedDifference.map(Math.abs)).toExponential(3)}</strong>
    <span>open-boundary error</span><strong data-i-surface-open-error>{Math.hypot(...initial.omittedBottomFlux).toExponential(3)}</strong>
  </div>

  <div class="surface-force__fallback">
    <p><strong>无 JavaScript 参考表 | No-JavaScript reference table</strong></p>
    <table>
      <thead><tr><th>c</th><th>closed Fx</th><th>volume Fx</th><th>omitted-bottom norm</th></tr></thead>
      <tbody>{fallback.map((row) => <tr><td>{row.crossingShear.toFixed(2)}</td><td>{row.closedSurfaceFlux[0].toFixed(6)}</td><td>{row.volumeForce[0].toFixed(6)}</td><td>{Math.hypot(...row.omittedBottomFlux).toExponential(2)}</td></tr>)}</tbody>
    </table>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>二维对称 stress field <code>σxx=ax</code>、<code>σxy=σyx=cy</code>、<code>σyy=by</code>，因此 <code>div σ=(a+c,b)</code> 为常数。</p>
    <p lang="en"><strong>Model:</strong> a symmetric two-dimensional stress field <code>σxx=ax</code>, <code>σxy=σyx=cy</code>, and <code>σyy=by</code>, giving constant <code>div σ=(a+c,b)</code>.</p>
    <p><strong>验收：</strong>四个完整 face flux 的向量和严格等于 <code>area × div σ</code>；若漏掉 bottom face，差值恰等于被省略的 boundary flux。</p>
    <p lang="en"><strong>Acceptance:</strong> the vector sum of all four face fluxes equals <code>area × div σ</code>; omitting the bottom face leaves exactly the omitted boundary flux.</p>
    <p><strong>边界：</strong>真实电子结构 force 需要完整 kinetic、electrostatic、XC、nonlocal、core 与 basis-boundary flux。只积分一项或一个 open patch 不能称为总原子力。</p>
    <p lang="en"><strong>Boundary:</strong> a real electronic-structure force requires the complete kinetic, electrostatic, XC, nonlocal, core, and basis-boundary flux. One term or an open patch is not a total atomic force.</p>
  </div>
</figure>

<script>
  import { alternativeForceDefaults, rectangularStressFlux } from '../../../data/part07/alternativeForceModel.mjs';
  document.querySelectorAll('[data-surface-force]').forEach((root) => {
    const normalInput = root.querySelector('[data-i-surface-normal]'); const shearInput = root.querySelector('[data-i-surface-shear]');
    if (!(normalInput instanceof HTMLInputElement) || !(shearInput instanceof HTMLInputElement)) return;
    const normalOut = root.querySelector('[data-i-surface-normal-output]'); const shearOut = root.querySelector('[data-i-surface-shear-output]');
    const lines = { right: root.querySelector('[data-i-surface-right]'), left: root.querySelector('[data-i-surface-left]'), top: root.querySelector('[data-i-surface-top]'), bottom: root.querySelector('[data-i-surface-bottom]') };
    const outputs = { closed: root.querySelector('[data-i-surface-closed-x]'), volume: root.querySelector('[data-i-surface-volume-x]'), error: root.querySelector('[data-i-surface-closed-error]'), open: root.querySelector('[data-i-surface-open-error]') };
    const x0 = 155; const x1 = 565; const y0 = 72; const y1 = 270; const centreX = (x0 + x1) / 2; const centreY = (y0 + y1) / 2; const scale = 42;
    const apply = (element, x, y, fx, fy) => { if (element instanceof SVGLineElement) { element.setAttribute('x1', String(x)); element.setAttribute('y1', String(y)); element.setAttribute('x2', String(x + scale * fx)); element.setAttribute('y2', String(y - scale * fy)); } };
    const update = () => {
      const normalGradient = Number(normalInput.value); const crossingShear = Number(shearInput.value);
      const result = rectangularStressFlux({ ...alternativeForceDefaults.surface, normalGradient, crossingShear });
      apply(lines.right, x1, centreY, result.faceFluxes.right[0] / result.height, result.faceFluxes.right[1] / result.height);
      apply(lines.left, x0, centreY, result.faceFluxes.left[0] / result.height, result.faceFluxes.left[1] / result.height);
      apply(lines.top, centreX, y0, result.faceFluxes.top[0] / result.width, result.faceFluxes.top[1] / result.width);
      apply(lines.bottom, centreX, y1, result.faceFluxes.bottom[0] / result.width, result.faceFluxes.bottom[1] / result.width);
      if (normalOut instanceof HTMLOutputElement) normalOut.value = normalGradient.toFixed(2);
      if (shearOut instanceof HTMLOutputElement) shearOut.value = crossingShear.toFixed(2);
      if (outputs.closed instanceof HTMLElement) outputs.closed.textContent = result.closedSurfaceFlux[0].toFixed(7);
      if (outputs.volume instanceof HTMLElement) outputs.volume.textContent = result.volumeForce[0].toFixed(7);
      if (outputs.error instanceof HTMLElement) outputs.error.textContent = Math.max(...result.closedDifference.map(Math.abs)).toExponential(3);
      if (outputs.open instanceof HTMLElement) outputs.open.textContent = Math.hypot(...result.omittedBottomFlux).toExponential(3);
    };
    normalInput.addEventListener('input', update); shearInput.addEventListener('input', update); update();
  });
</script>

<style>
  .surface-force { overflow-x: auto; }
  .surface-force svg { width: 100%; min-width: 42rem; }
  .surface-force text { fill: currentColor; font-size: 13px; }
  .surface-force__box { fill: color-mix(in srgb, var(--sl-color-accent-low) 25%, transparent); stroke: currentColor; stroke-width: 2; }
  .surface-force__arrow { stroke: var(--sl-color-accent-high); stroke-width: 3; }
  .surface-force__arrow + marker path, #surface-force-arrow path { fill: var(--sl-color-accent-high); }
  .surface-force__controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 0.8rem; }
  .surface-force__controls label { display: grid; gap: 0.35rem; }
</style>
