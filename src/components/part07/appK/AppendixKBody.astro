---
import AppendixKContents from './AppendixKContents.astro';
import AppendixKOrientation from './AppendixKOrientation.mdx';
import AppendixKFunctionsHarmonics from './AppendixKFunctionsHarmonics.mdx';
import AppendixKCouplingChebyshevReview from './AppendixKCouplingChebyshevReview.mdx';
---

<div class="appendix-k-root" data-appendix-k-root>
  <AppendixKContents />
  <AppendixKOrientation />
  <AppendixKFunctionsHarmonics />
  <AppendixKCouplingChebyshevReview />
</div>

<style is:global>
  .appendix-k-root,
  .appendix-k-root > *,
  .appendix-k-root .bilingual-section,
  .appendix-k-root .bilingual-section__grid,
  .appendix-k-root .bilingual-section__zh,
  .appendix-k-root .bilingual-section__en,
  .appendix-k-root .derivation-block,
  .appendix-k-root .bilingual-callout {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .appendix-k-root .chapter-visual {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin-inline: 0;
    box-sizing: border-box;
  }

  .appendix-k-root .chapter-source-map,
  .appendix-k-root .katex-display,
  .appendix-k-root pre,
  .appendix-k-root table {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .appendix-k-root p,
  .appendix-k-root li,
  .appendix-k-root th,
  .appendix-k-root td {
    overflow-wrap: anywhere;
  }
</style>
