---
interface Props {
  titleZh: string;
  titleEn: string;
  kind?: 'source' | 'derivation' | 'boundary' | 'practice';
}

const {
  titleZh,
  titleEn,
  kind = 'source',
} = Astro.props;
const layer = kind === 'derivation' ? 'supplemental-derivation'
  : kind === 'practice' ? 'practical-mapping'
    : kind === 'boundary' ? 'numerical-interpretation' : 'original-exposition';
---

<aside class:list={['bilingual-callout', `bilingual-callout--${kind}`]} data-content-layer={layer}>
  <header>
    <strong>{titleZh}</strong>
    <span lang="en">{titleEn}</span>
  </header>
  <div class="bilingual-callout__grid">
    <slot />
  </div>
</aside>
