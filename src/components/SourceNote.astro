---
type PageStatus = 'outline' | 'draft' | 'review' | 'validated';
type LegacyCompleteStatus = `${string}-complete`;
type DeclaredStatus = PageStatus | LegacyCompleteStatus;

interface Props {
  source: string;
  locator: string;
  status?: DeclaredStatus;
}

const canonicalStatuses = new Set<PageStatus>(['outline', 'draft', 'review', 'validated']);
const rawStatus = Astro.props.status ?? 'outline';

let status: PageStatus;
if (canonicalStatuses.has(rawStatus as PageStatus)) {
  status = rawStatus as PageStatus;
} else if (rawStatus.endsWith('-complete')) {
  status = 'validated';
} else {
  throw new Error(`Invalid SourceNote status: ${rawStatus}`);
}

const { source, locator } = Astro.props;
---

<aside class="source-note" aria-label="来源定位 / Source locator">
  <div class="source-note__header">
    <strong>来源定位 / Source locator</strong>
    <span class="source-note__status" aria-label={`页面状态 / Page status: ${status}`}>{status}</span>
  </div>
  <div>{source}</div>
  <div>{locator}</div>
</aside>
