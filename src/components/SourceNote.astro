---
type PageStatus = 'outline' | 'draft' | 'review' | 'validated';
type DeclaredStatus = PageStatus | 'chapter-complete';

interface Props {
  source: string;
  locator: string;
  status?: DeclaredStatus;
}

const statusAliases: Record<DeclaredStatus, PageStatus> = {
  outline: 'outline',
  draft: 'draft',
  review: 'review',
  validated: 'validated',
  'chapter-complete': 'validated',
};

const rawStatus = Astro.props.status ?? 'outline';

if (!(rawStatus in statusAliases)) {
  throw new Error(`Invalid SourceNote status: ${rawStatus}`);
}

const { source, locator } = Astro.props;
const status = statusAliases[rawStatus];
---

<aside class="source-note" aria-label="来源定位 / Source locator">
  <div class="source-note__header">
    <strong>来源定位 / Source locator</strong>
    <span class="source-note__status" aria-label={`页面状态 / Page status: ${status}`}>{status}</span>
  </div>
  <div>{source}</div>
  <div>{locator}</div>
</aside>
