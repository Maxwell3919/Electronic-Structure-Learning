---
interface Props {
  id?: string;
}

const { id = 'scf-iteration-visualizer' } = Astro.props;
---

<section id={id} class="scf-visualizer" data-scf-visualizer>
  <header class="scf-header">
    <div>
      <p class="scf-eyebrow">交互教学模型</p>
      <h3>SCF 固定点与线性混合</h3>
    </div>
    <div class="scf-presets" aria-label="预设参数">
      <button type="button" data-preset="stable">单调收敛</button>
      <button type="button" data-preset="oscillatory">振荡收敛</button>
      <button type="button" data-preset="divergent">发散</button>
    </div>
  </header>

  <div class="scf-controls" aria-label="模型参数">
    <label>
      <span>响应斜率 <code>s</code></span>
      <output data-slope-output for={`${id}-slope`}>0.35</output>
      <input
        id={`${id}-slope`}
        data-slope
        type="range"
        min="-2.5"
        max="1.5"
        step="0.05"
        value="0.35"
      />
    </label>

    <label>
      <span>混合参数 <code>α</code></span>
      <output data-mixing-output for={`${id}-mixing`}>0.45</output>
      <input
        id={`${id}-mixing`}
        data-mixing
        type="range"
        min="0.05"
        max="1.2"
        step="0.05"
        value="0.45"
      />
    </label>

    <label>
      <span>初始输入 <code>x₀</code></span>
      <output data-initial-output for={`${id}-initial`}>-0.80</output>
      <input
        id={`${id}-initial`}
        data-initial
        type="range"
        min="-2"
        max="3"
        step="0.1"
        value="-0.8"
      />
    </label>

    <label>
      <span>最大迭代数</span>
      <output data-max-output for={`${id}-max`}>24</output>
      <input
        id={`${id}-max`}
        data-max
        type="range"
        min="6"
        max="50"
        step="1"
        value="24"
      />
    </label>

    <label class="scf-select-label">
      <span>残差阈值</span>
      <select id={`${id}-tolerance`} data-tolerance>
        <option value="0.01">10⁻²</option>
        <option value="0.0001">10⁻⁴</option>
        <option value="0.000001" selected>10⁻⁶</option>
        <option value="0.00000001">10⁻⁸</option>
      </select>
    </label>
  </div>

  <div class="scf-metrics" aria-live="polite">
    <div>
      <span>误差传播因子</span>
      <strong data-q>—</strong>
    </div>
    <div>
      <span>线性判定</span>
      <strong data-mode>—</strong>
    </div>
    <div>
      <span>停止位置</span>
      <strong data-iteration>—</strong>
    </div>
    <div>
      <span>最终残差</span>
      <strong data-residual>—</strong>
    </div>
  </div>

  <p class="scf-status" data-status aria-live="polite">
    正在初始化模型……
  </p>

  <figure class="scf-figure">
    <svg
      data-plot
      viewBox="0 0 720 320"
      role="img"
      aria-labelledby={`${id}-plot-title ${id}-plot-description`}
    >
      <title id={`${id}-plot-title`}>SCF 输入量随迭代次数的变化</title>
      <desc id={`${id}-plot-description`}>
        折线表示每一步的混合输入，虚线表示固定点 x*=1。
      </desc>
      <line class="axis" x1="58" x2="700" y1="276" y2="276"></line>
      <line class="axis" x1="58" x2="58" y1="22" y2="276"></line>
      <line class="target" data-target-line x1="58" x2="700"></line>
      <path class="series" data-input-path d=""></path>
      <g data-points></g>
      <text class="axis-label" x="380" y="312" text-anchor="middle">迭代 k</text>
      <text class="axis-label" x="16" y="150" text-anchor="middle" transform="rotate(-90 16 150)">
        标量密度模 xₖ
      </text>
      <text class="tick-label" x="58" y="298">0</text>
      <text class="tick-label" data-x-max x="700" y="298" text-anchor="end">—</text>
      <text class="tick-label" data-y-max x="52" y="30" text-anchor="end">—</text>
      <text class="tick-label" data-y-min x="52" y="276" text-anchor="end">—</text>
      <text class="target-label" data-target-label x="694" text-anchor="end">x*=1</text>
    </svg>
    <figcaption>
      本图只展示单个线性化“密度模”的固定点迭代；它不是实际电荷密度、能量或真实电子结构程序的收敛轨迹。
    </figcaption>
  </figure>

  <div class="scf-table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">k</th>
          <th scope="col">输入 xₖ</th>
          <th scope="col">输出 F(xₖ)</th>
          <th scope="col">残差 F(xₖ)-xₖ</th>
          <th scope="col">误差 xₖ-x*</th>
        </tr>
      </thead>
      <tbody data-rows>
        <tr><td colspan="5">需要 JavaScript 才能生成迭代表。</td></tr>
      </tbody>
    </table>
  </div>

  <aside class="scf-boundary">
    <strong>模型边界：</strong>
    实际 Kohn–Sham SCF 的变量是高维密度或势，响应算符具有多个模，并可能使用预条件、Pulay/Broyden mixing、占据展宽和更复杂的收敛判据。本组件只能说明线性混合为何可能单调收敛、振荡或发散。
  </aside>
</section>

<script>
  import { iterateScf } from '../lib/scfToyModel.mjs';

  const presets = {
    stable: { slope: 0.35, mixing: 0.45, initial: -0.8 },
    oscillatory: { slope: -1, mixing: 0.75, initial: -0.8 },
    divergent: { slope: -1.5, mixing: 1, initial: 0.2 },
  };

  const formatNumber = (value, digits = 4) => {
    if (!Number.isFinite(value)) return '—';
    const magnitude = Math.abs(value);
    if ((magnitude !== 0 && magnitude < 1e-3) || magnitude >= 1e4) {
      return value.toExponential(2);
    }
    return value.toFixed(digits).replace(/\.?0+$/, '');
  };

  const requireElement = (root, selector) => {
    const element = root.querySelector(selector);
    if (!element) throw new Error(`Missing SCF visualizer element: ${selector}`);
    return element;
  };

  const renderPlot = (root, rows, fixedPoint) => {
    const width = 720;
    const height = 320;
    const left = 58;
    const right = 20;
    const top = 22;
    const bottom = 44;
    const plotWidth = width - left - right;
    const plotHeight = height - top - bottom;
    const lastIteration = Math.max(rows.at(-1)?.iteration ?? 1, 1);

    const values = rows.map((row) => row.input);
    values.push(fixedPoint);
    let minimum = Math.min(...values);
    let maximum = Math.max(...values);
    const rawRange = maximum - minimum;
    const padding = Math.max(rawRange * 0.12, 0.25);
    minimum -= padding;
    maximum += padding;

    const xScale = (iteration) => left + (iteration / lastIteration) * plotWidth;
    const yScale = (value) => top + ((maximum - value) / (maximum - minimum)) * plotHeight;

    const path = rows
      .map((row, index) => {
        const command = index === 0 ? 'M' : 'L';
        return `${command}${xScale(row.iteration).toFixed(2)},${yScale(row.input).toFixed(2)}`;
      })
      .join(' ');

    requireElement(root, '[data-input-path]').setAttribute('d', path);

    const targetY = yScale(fixedPoint);
    const targetLine = requireElement(root, '[data-target-line]');
    targetLine.setAttribute('y1', targetY.toFixed(2));
    targetLine.setAttribute('y2', targetY.toFixed(2));

    const targetLabel = requireElement(root, '[data-target-label]');
    targetLabel.setAttribute('y', Math.max(targetY - 7, 14).toFixed(2));

    requireElement(root, '[data-points]').innerHTML = rows
      .map(
        (row) =>
          `<circle cx="${xScale(row.iteration).toFixed(2)}" cy="${yScale(row.input).toFixed(2)}" r="3.4"></circle>`,
      )
      .join('');

    requireElement(root, '[data-x-max]').textContent = String(lastIteration);
    requireElement(root, '[data-y-max]').textContent = formatNumber(maximum, 2);
    requireElement(root, '[data-y-min]').textContent = formatNumber(minimum, 2);
  };

  const renderTable = (root, rows) => {
    const visibleRows =
      rows.length <= 15
        ? rows
        : [...rows.slice(0, 10), null, ...rows.slice(-4)];

    requireElement(root, '[data-rows]').innerHTML = visibleRows
      .map((row) => {
        if (row === null) {
          return '<tr class="ellipsis"><td colspan="5">…</td></tr>';
        }
        return `<tr>
          <td>${row.iteration}</td>
          <td>${formatNumber(row.input)}</td>
          <td>${formatNumber(row.output)}</td>
          <td>${formatNumber(row.residual)}</td>
          <td>${formatNumber(row.error)}</td>
        </tr>`;
      })
      .join('');
  };

  document.querySelectorAll('[data-scf-visualizer]').forEach((node) => {
    const root = node;
    const slopeInput = requireElement(root, '[data-slope]');
    const mixingInput = requireElement(root, '[data-mixing]');
    const initialInput = requireElement(root, '[data-initial]');
    const maxInput = requireElement(root, '[data-max]');
    const toleranceInput = requireElement(root, '[data-tolerance]');

    const update = () => {
      const responseSlope = Number.parseFloat(slopeInput.value);
      const mixing = Number.parseFloat(mixingInput.value);
      const initialValue = Number.parseFloat(initialInput.value);
      const maxIterations = Number.parseInt(maxInput.value, 10);
      const tolerance = Number.parseFloat(toleranceInput.value);

      requireElement(root, '[data-slope-output]').textContent = responseSlope.toFixed(2);
      requireElement(root, '[data-mixing-output]').textContent = mixing.toFixed(2);
      requireElement(root, '[data-initial-output]').textContent = initialValue.toFixed(2);
      requireElement(root, '[data-max-output]').textContent = String(maxIterations);

      const result = iterateScf({
        responseSlope,
        mixing,
        initialValue,
        fixedPoint: 1,
        tolerance,
        maxIterations,
      });

      const lastRow = result.rows.at(-1);
      requireElement(root, '[data-q]').textContent = formatNumber(result.q, 3);
      requireElement(root, '[data-mode]').textContent = result.label;
      requireElement(root, '[data-iteration]').textContent = result.converged
        ? `k=${result.convergenceIteration}`
        : `k=${lastRow?.iteration ?? 0}`;
      requireElement(root, '[data-residual]').textContent = formatNumber(
        Math.abs(lastRow?.residual ?? Number.NaN),
      );

      const status = requireElement(root, '[data-status]');
      status.dataset.kind = result.kind;
      if (result.kind === 'degenerate') {
        status.textContent = result.explanation;
      } else if (result.converged) {
        status.textContent = `${result.explanation} 残差在 k=${result.convergenceIteration} 首次不大于 ${tolerance.toExponential(0)}。`;
      } else if (result.stoppedReason === 'absolute-limit') {
        status.textContent = `${result.explanation} 迭代值超过教学模型的绝对值保护上限，计算提前停止。`;
      } else {
        status.textContent = `${result.explanation} 在 ${maxIterations} 次更新内没有达到 ${tolerance.toExponential(0)} 的残差阈值。`;
      }

      renderPlot(root, result.rows, result.fixedPoint);
      renderTable(root, result.rows);
    };

    [slopeInput, mixingInput, initialInput, maxInput, toleranceInput].forEach(
      (control) => {
        control.addEventListener('input', update);
        control.addEventListener('change', update);
      },
    );

    root.querySelectorAll('[data-preset]').forEach((button) => {
      button.addEventListener('click', () => {
        const preset = presets[button.dataset.preset];
        if (!preset) return;
        slopeInput.value = String(preset.slope);
        mixingInput.value = String(preset.mixing);
        initialInput.value = String(preset.initial);
        update();
      });
    });

    update();
  });
</script>

<style>
  .scf-visualizer {
    margin-block: 1.5rem;
    padding: 1.1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.8rem;
    background: var(--sl-color-bg);
  }

  .scf-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .scf-header h3,
  .scf-header p {
    margin: 0;
  }

  .scf-eyebrow {
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .scf-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .scf-presets button {
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-text);
    cursor: pointer;
  }

  .scf-presets button:hover {
    border-color: var(--sl-color-accent);
  }

  .scf-controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.9rem;
    margin-block: 1rem;
  }

  .scf-controls label {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35rem 0.6rem;
    align-items: center;
    padding: 0.7rem;
    border: 1px solid var(--sl-color-gray-6);
    border-radius: 0.55rem;
  }

  .scf-controls input[type='range'] {
    grid-column: 1 / -1;
    width: 100%;
    accent-color: var(--sl-color-accent);
  }

  .scf-controls output {
    font-variant-numeric: tabular-nums;
  }

  .scf-select-label select {
    grid-column: 1 / -1;
    width: 100%;
    padding: 0.35rem;
  }

  .scf-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 0.6rem;
  }

  .scf-metrics div {
    padding: 0.7rem;
    border-radius: 0.55rem;
    background: var(--sl-color-bg-nav);
  }

  .scf-metrics span,
  .scf-metrics strong {
    display: block;
  }

  .scf-metrics span {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
  }

  .scf-metrics strong {
    margin-top: 0.2rem;
    font-variant-numeric: tabular-nums;
  }

  .scf-status {
    margin-block: 0.9rem;
    padding: 0.7rem 0.8rem;
    border-inline-start: 0.25rem solid var(--sl-color-accent);
    background: var(--sl-color-bg-inline-code);
  }

  .scf-status[data-kind='divergent'],
  .scf-status[data-kind='marginal'] {
    border-inline-start-color: var(--sl-color-orange);
  }

  .scf-figure {
    margin: 1rem 0;
  }

  .scf-figure svg {
    display: block;
    width: 100%;
    height: auto;
    color: var(--sl-color-text);
  }

  .axis {
    stroke: var(--sl-color-gray-4);
    stroke-width: 1;
  }

  .target {
    stroke: var(--sl-color-orange);
    stroke-width: 1.5;
    stroke-dasharray: 7 5;
  }

  .series {
    fill: none;
    stroke: var(--sl-color-accent-high);
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  [data-points] circle {
    fill: var(--sl-color-accent-high);
    stroke: var(--sl-color-bg);
    stroke-width: 1.5;
  }

  .axis-label,
  .tick-label,
  .target-label {
    fill: currentColor;
    font-family: system-ui, sans-serif;
  }

  .axis-label {
    font-size: 13px;
  }

  .tick-label,
  .target-label {
    font-size: 12px;
  }

  .target-label {
    fill: var(--sl-color-orange-high);
  }

  .scf-figure figcaption,
  .scf-boundary {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .scf-table-wrap {
    overflow-x: auto;
  }

  .scf-table-wrap table {
    width: 100%;
    font-variant-numeric: tabular-nums;
  }

  .scf-table-wrap th,
  .scf-table-wrap td {
    white-space: nowrap;
    text-align: right;
  }

  .scf-table-wrap th:first-child,
  .scf-table-wrap td:first-child {
    text-align: center;
  }

  .ellipsis td {
    text-align: center;
  }

  .scf-boundary {
    margin-top: 1rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--sl-color-gray-6);
  }
</style>
