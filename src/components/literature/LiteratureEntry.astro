---
import ReadingStatusBadge from './ReadingStatusBadge.astro';
const { entry } = Astro.props;
---
<article class="esl-literature-entry" data-literature-id={entry.id} data-content-layer="later-literature">
  <header><h2>{entry.title}</h2><ReadingStatusBadge status={entry.readingStatus} /></header>
  <p>{entry.authors.join(', ')} · {entry.year} · {entry.venue}</p>
  <p>Evidence role: {entry.evidenceRole}. Bibliographic registration does not by itself validate a scientific claim.</p>
</article>
