<figure class="chapter-visual ch04-reciprocal" data-ch04-reciprocal>
  <figcaption>
    <strong>原创交互模型：二维 direct/reciprocal lattice 对偶</strong>
    <span lang="en">Original interactive model: two-dimensional direct/reciprocal lattice duality</span>
  </figcaption>

  <div class="chapter-visual__controls">
    <label>
      <span>长度比 |a₂|/|a₁| | Length ratio</span>
      <input type="range" min="0.60" max="1.60" step="0.05" value="1.00" data-ch04-ratio />
      <output data-ch04-ratio-output>1.00</output>
    </label>
    <label>
      <span>夹角 θ | Primitive-vector angle</span>
      <input type="range" min="35" max="145" step="1" value="60" data-ch04-angle />
      <output data-ch04-angle-output>60°</output>
    </label>
  </div>

  <svg viewBox="0 0 900 390" role="img" aria-labelledby="ch04-rec-title ch04-rec-desc">
    <title id="ch04-rec-title">Direct and reciprocal primitive cells</title>
    <desc id="ch04-rec-desc">The left panel shows direct primitive vectors and the right panel shows reciprocal vectors satisfying ai dot bj equals two pi delta ij.</desc>

    <g transform="translate(225 205)">
      <text x="0" y="-160" text-anchor="middle" class="plot-title">direct lattice</text>
      <line x1="-175" y1="0" x2="175" y2="0" class="plot-axis" />
      <line x1="0" y1="145" x2="0" y2="-145" class="plot-axis" />
      <path d="M 0 0 L 120 0 L 180 -103.9 L 60 -103.9 Z" class="ch04-reciprocal__cell" data-ch04-direct-cell />
      <line x1="0" y1="0" x2="120" y2="0" class="plot-curve" data-ch04-a1 />
      <line x1="0" y1="0" x2="60" y2="-103.9" class="plot-curve ch04-reciprocal__second" data-ch04-a2 />
      <circle cx="0" cy="0" r="5" />
      <text x="125" y="20">a₁</text>
      <text x="66" y="-108" data-ch04-a2-label>a₂</text>
    </g>

    <g transform="translate(675 205)">
      <text x="0" y="-160" text-anchor="middle" class="plot-title">reciprocal lattice</text>
      <line x1="-175" y1="0" x2="175" y2="0" class="plot-axis" />
      <line x1="0" y1="145" x2="0" y2="-145" class="plot-axis" />
      <path d="M 0 0 L 120 69.3 L 120 -69.3 L 0 -138.6 Z" class="ch04-reciprocal__cell" data-ch04-recip-cell />
      <line x1="0" y1="0" x2="120" y2="69.3" class="plot-curve" data-ch04-b1 />
      <line x1="0" y1="0" x2="0" y2="-138.6" class="plot-curve ch04-reciprocal__second" data-ch04-b2 />
      <circle cx="0" cy="0" r="5" />
      <text x="125" y="80" data-ch04-b1-label>b₁</text>
      <text x="8" y="-143">b₂</text>
    </g>
  </svg>

  <div class="chapter-visual__readout" aria-live="polite">
    <strong data-ch04-duality>aᵢ·bⱼ = 2πδᵢⱼ</strong>
    <span data-ch04-areas>Acell = 0.866; ABZ = 45.586</span>
    <span data-ch04-product>Acell ABZ = 39.478 = (2π)²</span>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong><code>b = 2π A⁻ᵀ</code>，其中 A 的 columns 是 a₁、a₂。</p>
    <p lang="en"><strong>Model:</strong> <code>b = 2π A⁻ᵀ</code>, where the columns of A are a₁ and a₂.</p>
    <p><strong>验收：</strong>任意非共线 primitive vectors 均满足 <code>aᵢ·bⱼ = 2πδᵢⱼ</code> 与 <code>Acell ABZ = (2π)²</code>。</p>
    <p lang="en"><strong>Acceptance:</strong> any non-collinear primitive vectors obey the duality relation and the two-dimensional cell-area product.</p>
    <p><strong>边界：</strong>图只显示 primitive parallelograms，不构造完整 Wigner–Seitz cell、第一 BZ、basis atoms 或 space-group operations。</p>
    <p lang="en"><strong>Boundary:</strong> the diagram shows primitive parallelograms only; it does not construct Wigner–Seitz cells, the first BZ, basis atoms, or a space group.</p>
  </div>
</figure>

<script>
  import { latticeFromShape2D, reciprocalLattice2D } from '../lib/chapter04Models.mjs';

  document.querySelectorAll('[data-ch04-reciprocal]').forEach((root) => {
    const ratioInput = root.querySelector('[data-ch04-ratio]');
    const angleInput = root.querySelector('[data-ch04-angle]');
    const ratioOutput = root.querySelector('[data-ch04-ratio-output]');
    const angleOutput = root.querySelector('[data-ch04-angle-output]');
    const a1Line = root.querySelector('[data-ch04-a1]');
    const a2Line = root.querySelector('[data-ch04-a2]');
    const b1Line = root.querySelector('[data-ch04-b1]');
    const b2Line = root.querySelector('[data-ch04-b2]');
    const directCell = root.querySelector('[data-ch04-direct-cell]');
    const reciprocalCell = root.querySelector('[data-ch04-recip-cell]');
    const a2Label = root.querySelector('[data-ch04-a2-label]');
    const b1Label = root.querySelector('[data-ch04-b1-label]');
    const duality = root.querySelector('[data-ch04-duality]');
    const areas = root.querySelector('[data-ch04-areas]');
    const product = root.querySelector('[data-ch04-product]');
    if (!(ratioInput instanceof HTMLInputElement) || !(angleInput instanceof HTMLInputElement)) return;
    if (!(a1Line instanceof SVGLineElement) || !(a2Line instanceof SVGLineElement)) return;
    if (!(b1Line instanceof SVGLineElement) || !(b2Line instanceof SVGLineElement)) return;
    if (!(directCell instanceof SVGPathElement) || !(reciprocalCell instanceof SVGPathElement)) return;

    const setLine = (line, vector, scale) => {
      line.setAttribute('x2', String(scale * vector[0]));
      line.setAttribute('y2', String(-scale * vector[1]));
    };
    const cellPath = (first, second, scale) => {
      const x1 = scale * first[0];
      const y1 = -scale * first[1];
      const x2 = scale * second[0];
      const y2 = -scale * second[1];
      return `M 0 0 L ${x1} ${y1} L ${x1 + x2} ${y1 + y2} L ${x2} ${y2} Z`;
    };

    const update = () => {
      const ratio = Number(ratioInput.value);
      const angleDegrees = Number(angleInput.value);
      const direct = latticeFromShape2D({ length: 1, ratio, angleDegrees });
      const lattice = reciprocalLattice2D(direct);
      const directScale = 115 / Math.max(1, ratio);
      const reciprocalMax = Math.max(Math.hypot(...lattice.b1), Math.hypot(...lattice.b2));
      const reciprocalScale = 135 / reciprocalMax;
      setLine(a1Line, lattice.a1, directScale);
      setLine(a2Line, lattice.a2, directScale);
      setLine(b1Line, lattice.b1, reciprocalScale);
      setLine(b2Line, lattice.b2, reciprocalScale);
      directCell.setAttribute('d', cellPath(lattice.a1, lattice.a2, directScale));
      reciprocalCell.setAttribute('d', cellPath(lattice.b1, lattice.b2, reciprocalScale));
      if (a2Label instanceof SVGTextElement) {
        a2Label.setAttribute('x', String(directScale * lattice.a2[0] + 8));
        a2Label.setAttribute('y', String(-directScale * lattice.a2[1] - 6));
      }
      if (b1Label instanceof SVGTextElement) {
        b1Label.setAttribute('x', String(reciprocalScale * lattice.b1[0] + 8));
        b1Label.setAttribute('y', String(-reciprocalScale * lattice.b1[1] - 6));
      }
      if (ratioOutput instanceof HTMLOutputElement) ratioOutput.value = ratio.toFixed(2);
      if (angleOutput instanceof HTMLOutputElement) angleOutput.value = `${angleDegrees.toFixed(0)}°`;
      if (duality instanceof HTMLElement) {
        duality.textContent = `a1·b1 = ${lattice.dualityMatrix[0][0].toFixed(3)}; a1·b2 = ${lattice.dualityMatrix[0][1].toFixed(3)}; a2·b1 = ${lattice.dualityMatrix[1][0].toFixed(3)}; a2·b2 = ${lattice.dualityMatrix[1][1].toFixed(3)}`;
      }
      if (areas instanceof HTMLElement) areas.textContent = `Acell = ${lattice.directArea.toFixed(3)}; ABZ = ${lattice.reciprocalArea.toFixed(3)}`;
      if (product instanceof HTMLElement) product.textContent = `Acell ABZ = ${lattice.areaProduct.toFixed(3)} = (2π)²`;
    };

    ratioInput.addEventListener('input', update);
    angleInput.addEventListener('input', update);
    update();
  });
</script>
