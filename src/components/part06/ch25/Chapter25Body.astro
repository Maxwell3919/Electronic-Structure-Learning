---
import Chapter25Contents from './Chapter25Contents.astro';
import Chapter25Content from './Chapter25Content.astro';
---

<div class="chapter25-root">
  <Chapter25Contents />
  <Chapter25Content />
</div>

<style is:global>
  .chapter25-root,
  .chapter25-root > *,
  .chapter25-root .bilingual-section,
  .chapter25-root .bilingual-section__grid,
  .chapter25-root .bilingual-section__zh,
  .chapter25-root .bilingual-section__en,
  .chapter25-root .derivation-block,
  .chapter25-root .bilingual-callout {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .chapter25-root .chapter-visual {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin-inline: 0;
    box-sizing: border-box;
  }

  .chapter25-root .chapter-source-map,
  .chapter25-root .table-scroll,
  .chapter25-root .katex-display,
  .chapter25-root pre,
  .chapter25-root table {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .chapter25-root p,
  .chapter25-root li,
  .chapter25-root th,
  .chapter25-root td,
  .chapter25-root code {
    overflow-wrap: anywhere;
  }
</style>
