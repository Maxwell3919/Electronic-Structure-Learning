---
import Chapter26Contents from './Chapter26Contents.astro';
import Chapter26Content from './Chapter26Content.astro';
---

<div class="chapter26-root">
  <Chapter26Contents />
  <Chapter26Content />
</div>

<style is:global>
  .chapter26-root,
  .chapter26-root > *,
  .chapter26-root .bilingual-section,
  .chapter26-root .bilingual-section__grid,
  .chapter26-root .bilingual-section__zh,
  .chapter26-root .bilingual-section__en,
  .chapter26-root .derivation-block,
  .chapter26-root .bilingual-callout {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .chapter26-root .chapter-visual {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    margin-inline: 0;
    box-sizing: border-box;
  }

  .chapter26-root .chapter-source-map,
  .chapter26-root .table-scroll,
  .chapter26-root .katex-display,
  .chapter26-root pre,
  .chapter26-root table {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
  }

  .chapter26-root p,
  .chapter26-root li,
  .chapter26-root th,
  .chapter26-root td,
  .chapter26-root code {
    overflow-wrap: anywhere;
  }

  .chapter26-root .chapter-visual__controls {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .chapter26-root .chapter-visual__controls label {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .chapter26-root .chapter-visual__readout,
  .chapter26-root .chapter-visual__contract {
    display: grid;
    gap: 0.45rem;
  }

  @media (max-width: 50rem) {
    .chapter26-root .chapter-visual__controls {
      grid-template-columns: 1fr;
    }
  }
</style>
