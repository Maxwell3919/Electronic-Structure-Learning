<figure class="chapter-visual ch04-folding" data-ch04-folding>
  <figcaption>
    <strong>原创交互模型：一维 free-electron zone folding</strong>
    <span lang="en">Original interactive model: one-dimensional free-electron zone folding</span>
  </figcaption>

  <div class="chapter-visual__controls">
    <label>
      <span>reduced k = ka/π</span>
      <input type="range" min="-1" max="1" step="0.02" value="0.35" data-ch04-k />
      <output data-ch04-k-output>0.35</output>
    </label>
    <label>
      <span>folded branch m | Band label</span>
      <input type="range" min="-2" max="2" step="1" value="0" data-ch04-band />
      <output data-ch04-band-output>0</output>
    </label>
  </div>

  <svg viewBox="0 0 820 420" role="img" aria-labelledby="ch04-fold-title ch04-fold-desc">
    <title id="ch04-fold-title">Free-electron parabolas folded into the first Brillouin zone</title>
    <desc id="ch04-fold-desc">Five branches with energies proportional to the square of reduced k plus twice an integer are shown between minus one and one.</desc>
    <line x1="85" y1="350" x2="750" y2="350" class="plot-axis" />
    <line x1="417.5" y1="45" x2="417.5" y2="365" class="plot-guide" />
    <line x1="85" y1="45" x2="85" y2="350" class="plot-guide ch04-folding__boundary" />
    <line x1="750" y1="45" x2="750" y2="350" class="plot-guide ch04-folding__boundary" />
    <text x="78" y="382">−π/a</text>
    <text x="409" y="382">0</text>
    <text x="738" y="382">π/a</text>
    <text x="24" y="50">E/E₀</text>
    <path d="M 85 63 Q 417.5 326 750 63" class="plot-curve ch04-folding__band" data-ch04-fold-band="0" />
    <path d="M 85 326 Q 417.5 63 750 326" class="plot-curve ch04-folding__band" data-ch04-fold-band="-1" />
    <path d="M 85 326 Q 417.5 63 750 45" class="plot-curve ch04-folding__band ch04-folding__muted" data-ch04-fold-band="1" />
    <path d="M 85 45 Q 417.5 63 750 326" class="plot-curve ch04-folding__band ch04-folding__muted" data-ch04-fold-band="-2" />
    <path d="M 85 45 Q 417.5 45 750 45" class="plot-curve ch04-folding__band ch04-folding__muted" data-ch04-fold-band="2" />
    <line x1="534" y1="45" x2="534" y2="350" class="ch04-folding__cursor" data-ch04-fold-cursor />
    <circle cx="534" cy="338" r="7" data-ch04-fold-point="-2" />
    <circle cx="534" cy="260" r="7" data-ch04-fold-point="-1" />
    <circle cx="534" cy="338" r="7" data-ch04-fold-point="0" />
    <circle cx="534" cy="115" r="7" data-ch04-fold-point="1" />
    <circle cx="534" cy="55" r="7" data-ch04-fold-point="2" />
  </svg>

  <div class="chapter-visual__readout" aria-live="polite">
    <strong data-ch04-fold-energy>m = 0: E/E₀ = 0.123</strong>
    <span data-ch04-fold-unfolded>unfolded reduced wavevector = 0.350</span>
    <span data-ch04-fold-periodicity>Eₘ(k+G) = Eₘ₊₁(k)</span>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>在第一 BZ <code>−1 ≤ ka/π ≤ 1</code> 内，free-electron branches 为 <code>Eₘ/E₀ = (ka/π + 2m)²</code>。</p>
    <p lang="en"><strong>Model:</strong> inside the first BZ, free-electron branches obey <code>Eₘ/E₀ = (ka/π + 2m)²</code>.</p>
    <p><strong>验收：</strong>zone edge 处 m=0 与 m=−1 简并；把 k 增加一个 reciprocal vector 只重标记 branch。</p>
    <p lang="en"><strong>Acceptance:</strong> the m=0 and m=−1 branches are degenerate at the zone edge, and adding a reciprocal vector only relabels the branch.</p>
    <p><strong>边界：</strong>模型没有 periodic potential、gap opening、spin、SOC、electron interaction、basis orbitals 或真实 material parameters。</p>
    <p lang="en"><strong>Boundary:</strong> there is no periodic-potential gap, spin, SOC, electron interaction, basis orbital, or material parameter.</p>
  </div>
</figure>

<script>
  import { foldedFreeElectronBand, sampleFoldedBands } from '../lib/chapter04Models.mjs';

  document.querySelectorAll('[data-ch04-folding]').forEach((root) => {
    const kInput = root.querySelector('[data-ch04-k]');
    const bandInput = root.querySelector('[data-ch04-band]');
    const kOutput = root.querySelector('[data-ch04-k-output]');
    const bandOutput = root.querySelector('[data-ch04-band-output]');
    const cursor = root.querySelector('[data-ch04-fold-cursor]');
    const energyReadout = root.querySelector('[data-ch04-fold-energy]');
    const unfoldedReadout = root.querySelector('[data-ch04-fold-unfolded]');
    const periodicityReadout = root.querySelector('[data-ch04-fold-periodicity]');
    const paths = Array.from(root.querySelectorAll('[data-ch04-fold-band]'));
    const points = Array.from(root.querySelectorAll('[data-ch04-fold-point]'));
    if (!(kInput instanceof HTMLInputElement) || !(bandInput instanceof HTMLInputElement)) return;
    if (!(cursor instanceof SVGLineElement)) return;

    const xMap = (reducedK) => 85 + (reducedK + 1) / 2 * 665;
    const yMap = (energy) => 350 - Math.min(9, energy) / 9 * 300;
    const samples = sampleFoldedBands({ count: 161, minimumBand: -2, maximumBand: 2 });

    paths.forEach((path) => {
      if (!(path instanceof SVGPathElement)) return;
      const bandIndex = Number(path.getAttribute('data-ch04-fold-band'));
      const d = samples.map((sample, index) => {
        const band = sample.bands.find((item) => item.bandIndex === bandIndex);
        return `${index === 0 ? 'M' : 'L'} ${xMap(sample.reducedK).toFixed(2)} ${yMap(band?.energy ?? 9).toFixed(2)}`;
      }).join(' ');
      path.setAttribute('d', d);
    });

    const update = () => {
      const reducedK = Number(kInput.value);
      const bandIndex = Number(bandInput.value);
      const selected = foldedFreeElectronBand({ reducedK, bandIndex });
      const x = xMap(reducedK);
      cursor.setAttribute('x1', String(x));
      cursor.setAttribute('x2', String(x));
      points.forEach((point) => {
        if (!(point instanceof SVGCircleElement)) return;
        const pointBand = Number(point.getAttribute('data-ch04-fold-point'));
        const value = foldedFreeElectronBand({ reducedK, bandIndex: pointBand });
        point.setAttribute('cx', String(x));
        point.setAttribute('cy', String(yMap(value.energy)));
        point.classList.toggle('ch04-folding__selected', pointBand === bandIndex);
      });
      paths.forEach((path) => {
        path.classList.toggle('ch04-folding__selected-band', Number(path.getAttribute('data-ch04-fold-band')) === bandIndex);
      });
      if (kOutput instanceof HTMLOutputElement) kOutput.value = reducedK.toFixed(2);
      if (bandOutput instanceof HTMLOutputElement) bandOutput.value = String(bandIndex);
      if (energyReadout instanceof HTMLElement) energyReadout.textContent = `m = ${bandIndex}: E/E₀ = ${selected.energy.toFixed(3)}`;
      if (unfoldedReadout instanceof HTMLElement) unfoldedReadout.textContent = `unfolded reduced wavevector = ${selected.unfoldedReducedK.toFixed(3)}`;
      if (periodicityReadout instanceof HTMLElement) {
        const shifted = foldedFreeElectronBand({ reducedK: reducedK + 2, bandIndex });
        const relabelled = foldedFreeElectronBand({ reducedK, bandIndex: bandIndex + 1 });
        periodicityReadout.textContent = `E_m(k+G) = ${shifted.energy.toFixed(3)}; E_(m+1)(k) = ${relabelled.energy.toFixed(3)}`;
      }
    };

    kInput.addEventListener('input', update);
    bandInput.addEventListener('input', update);
    update();
  });
</script>
