---
interface Props {
  title: string;
  assumptions?: string[];
}

const { title, assumptions = [] } = Astro.props;
---

<section class="derivation-block" data-content-layer="supplemental-derivation">
  <div class="derivation-block__header">
    <strong>{title}</strong>
  </div>
  {assumptions.length > 0 && (
    <details>
      <summary>推导前提</summary>
      <ul>
        {assumptions.map((assumption) => <li>{assumption}</li>)}
      </ul>
    </details>
  )}
  <slot />
</section>
