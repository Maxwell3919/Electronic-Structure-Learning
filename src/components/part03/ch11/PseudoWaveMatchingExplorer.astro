---
import {
  reducedAllElectron,
  reducedPseudo,
  normInside,
} from '../../../data/part03/ch11TeachingModels.mjs';

const defaultRc = 1.8;
const rMax = 6;
const points = Array.from({ length: 501 }, (_, index) => {
  const r = rMax * index / 500;
  return {
    r,
    ae: reducedAllElectron(r),
    pseudo: reducedPseudo(r, defaultRc, true),
  };
});
const maxAbs = Math.max(...points.flatMap((point) => [Math.abs(point.ae), Math.abs(point.pseudo)])) * 1.15;
const x = (r) => 58 + r / rMax * 678;
const y = (value) => 160 - value / maxAbs * 125;
const pathFor = (key) => points.map((point, index) => `${index === 0 ? 'M' : 'L'} ${x(point.r).toFixed(2)} ${y(point[key]).toFixed(2)}`).join(' ');
const aePath = pathFor('ae');
const pseudoPath = pathFor('pseudo');
const defaultAENorm = normInside(reducedAllElectron, defaultRc);
const defaultPSNorm = normInside((r) => reducedPseudo(r, defaultRc, true), defaultRc);
---

<figure class="chapter-visual pseudo-wave-matching" data-pseudo-wave-matching>
  <figcaption>
    <strong>原创教学模型：核外匹配与芯内范数 | Original teaching model: exterior matching and interior norm</strong>
    <span>实线含一个芯区节点，虚线在 $r_c$ 内由光滑函数替代，并在 $r_c$ 处匹配函数值和一阶导数。</span>
    <span lang="en">The solid curve contains a core-region node. Inside $r_c$ the dashed curve is replaced by a smooth function that matches the value and first derivative at $r_c$.</span>
  </figcaption>

  <div class="chapter-visual__controls">
    <label>
      <span>芯半径 | Core radius $r_c$: <output data-rc-output>1.8</output> Bohr</span>
      <input data-rc type="range" min="1.2" max="2.6" step="0.1" value="1.8" aria-label="Pseudo-wavefunction core radius in Bohr" />
    </label>
    <label>
      <span>范数条件 | Norm condition</span>
      <select data-norm-mode aria-label="Pseudo-wavefunction norm condition">
        <option value="on" selected>enforce interior norm</option>
        <option value="off">match boundary only</option>
      </select>
    </label>
  </div>

  <svg viewBox="0 0 760 330" role="img" aria-labelledby="pseudo-wave-title pseudo-wave-desc">
    <title id="pseudo-wave-title">All-electron-like and smooth pseudo radial functions</title>
    <desc id="pseudo-wave-desc">A node-containing analytic radial function and a smooth replacement that equals it outside the adjustable core radius.</desc>
    <line class="plot-axis" x1="58" y1="160" x2="736" y2="160" />
    <line class="plot-axis" x1="58" y1="25" x2="58" y2="295" />
    <line class="plot-guide" data-core-line x1={x(defaultRc)} y1="25" x2={x(defaultRc)} y2="295" />
    <path class="pseudo-wave-matching__ae" data-ae-curve d={aePath} />
    <path class="pseudo-wave-matching__ps" data-ps-curve d={pseudoPath} />
    <text data-core-label x={x(defaultRc) + 5} y="43">r_c</text>
    <text x="397" y="322" text-anchor="middle">r (Bohr)</text>
    <text x="17" y="160" transform="rotate(-90 17 160)" text-anchor="middle">reduced radial function</text>
  </svg>

  <p class="chapter-visual__readout" aria-live="polite">
    <span>芯内 AE 范数：<strong data-ae-norm>{defaultAENorm.toFixed(6)}</strong></span>
    <span>芯内 PS 范数：<strong data-ps-norm>{defaultPSNorm.toFixed(6)}</strong></span>
    <span>差值：<strong data-norm-difference>{(defaultPSNorm - defaultAENorm).toExponential(2)}</strong></span>
    <span>核外最大差：<strong data-exterior-difference>0.00e+0</strong></span>
  </p>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>$u_{AE}=r(1-0.65r)e^{-0.55r}$。赝函数在芯区使用 Hermite 匹配，并可加入在 $r=0$、$r=r_c$ 及其边界斜率上不改变匹配的局域修正。</p>
    <p lang="en"><strong>Model:</strong> $u_{AE}=r(1-0.65r)e^{-0.55r}$. A Hermite replacement is used in the core, with an optional localized correction that preserves the origin, the value at $r_c$, and the boundary slope.</p>
    <p><strong>验收：</strong>核外差值应为机器精度；开启范数条件时，两条芯内累计范数的差应小于 $10^{-8}$。</p>
    <p lang="en"><strong>Acceptance:</strong> the exterior difference must be at machine precision; with norm enforcement enabled, the interior norms must differ by less than $10^{-8}$.</p>
    <p><strong>边界：</strong>这不是原子方程反演所得的真实赝势，也不检验本征值、相移或 transferability。</p>
    <p lang="en"><strong>Boundary:</strong> this is not a real pseudopotential obtained by radial inversion and does not test eigenvalues, phase shifts, or transferability.</p>
  </div>

  <noscript>
    <p>无 JavaScript 时显示默认 $r_c=1.8$ Bohr 的解析曲线和范数读数；控件不会更新。</p>
  </noscript>
</figure>

<script>
  const reducedAllElectron = (r) => r * (1 - 0.65 * r) * Math.exp(-0.55 * r);
  const reducedAllElectronDerivative = (r) => {
    const f = 1 - 0.65 * r;
    return Math.exp(-0.55 * r) * (f - 0.65 * r - 0.55 * r * f);
  };
  const hermiteBase = (r, rc) => {
    if (r >= rc) return reducedAllElectron(r);
    const x = r / rc;
    const uc = reducedAllElectron(rc);
    const duc = reducedAllElectronDerivative(rc);
    const h10 = x ** 3 - 2 * x ** 2 + x;
    const h01 = -2 * x ** 3 + 3 * x ** 2;
    const h11 = x ** 3 - x ** 2;
    return h10 * rc + h01 * uc + h11 * rc * duc;
  };
  const correctionShape = (r, rc) => {
    if (r >= rc) return 0;
    const x = r / rc;
    return x ** 2 * (1 - x) ** 2;
  };
  const integrate = (fn, upper, steps = 3000) => {
    const h = upper / steps;
    let sum = 0.5 * (fn(0) + fn(upper));
    for (let index = 1; index < steps; index += 1) sum += fn(index * h);
    return sum * h;
  };
  const normInside = (fn, rc) => integrate((r) => fn(r) ** 2, rc);
  const correctionCoefficient = (rc) => {
    const target = normInside(reducedAllElectron, rc);
    const baseNorm = normInside((r) => hermiteBase(r, rc), rc);
    const cross = 2 * integrate((r) => hermiteBase(r, rc) * correctionShape(r, rc), rc);
    const square = normInside((r) => correctionShape(r, rc), rc);
    const discriminant = cross ** 2 - 4 * square * (baseNorm - target);
    const rootA = (-cross + Math.sqrt(Math.max(0, discriminant))) / (2 * square);
    const rootB = (-cross - Math.sqrt(Math.max(0, discriminant))) / (2 * square);
    return Math.abs(rootA) <= Math.abs(rootB) ? rootA : rootB;
  };
  const reducedPseudo = (r, rc, conserveNorm) => {
    if (r >= rc) return reducedAllElectron(r);
    return hermiteBase(r, rc) + (conserveNorm ? correctionCoefficient(rc) : 0) * correctionShape(r, rc);
  };

  document.querySelectorAll('[data-pseudo-wave-matching]').forEach((root) => {
    const rcInput = root.querySelector('[data-rc]');
    const normMode = root.querySelector('[data-norm-mode]');
    const update = () => {
      const rc = Number(rcInput.value);
      const conserveNorm = normMode.value === 'on';
      const rMax = 6;
      const count = 700;
      const points = Array.from({ length: count + 1 }, (_, index) => {
        const r = rMax * index / count;
        return { r, ae: reducedAllElectron(r), ps: reducedPseudo(r, rc, conserveNorm) };
      });
      const maxAbs = Math.max(...points.flatMap((point) => [Math.abs(point.ae), Math.abs(point.ps)])) * 1.15;
      const x = (r) => 58 + r / rMax * 678;
      const y = (value) => 160 - value / maxAbs * 125;
      const path = (key) => points.map((point, index) => `${index === 0 ? 'M' : 'L'} ${x(point.r).toFixed(2)} ${y(point[key]).toFixed(2)}`).join(' ');
      root.querySelector('[data-ae-curve]').setAttribute('d', path('ae'));
      root.querySelector('[data-ps-curve]').setAttribute('d', path('ps'));
      const coreX = x(rc);
      const coreLine = root.querySelector('[data-core-line]');
      coreLine.setAttribute('x1', String(coreX));
      coreLine.setAttribute('x2', String(coreX));
      root.querySelector('[data-core-label]').setAttribute('x', String(coreX + 5));
      root.querySelector('[data-rc-output]').textContent = rc.toFixed(1);
      const aeNorm = normInside(reducedAllElectron, rc);
      const psNorm = normInside((r) => reducedPseudo(r, rc, conserveNorm), rc);
      const exteriorDifference = Math.max(...points.filter((point) => point.r >= rc).map((point) => Math.abs(point.ae - point.ps)));
      root.querySelector('[data-ae-norm]').textContent = aeNorm.toFixed(6);
      root.querySelector('[data-ps-norm]').textContent = psNorm.toFixed(6);
      root.querySelector('[data-norm-difference]').textContent = (psNorm - aeNorm).toExponential(2);
      root.querySelector('[data-exterior-difference]').textContent = exteriorDifference.toExponential(2);
    };
    rcInput.addEventListener('input', update);
    normMode.addEventListener('change', update);
    update();
  });
</script>

<style>
  .pseudo-wave-matching select { min-height: 2.25rem; }
  .pseudo-wave-matching svg { width: 100%; min-height: 17rem; margin-top: 1rem; }
  .pseudo-wave-matching svg text { fill: currentColor; font-size: 13px; }
  .pseudo-wave-matching__ae { fill: none; stroke: var(--sl-color-accent-high); stroke-width: 3; }
  .pseudo-wave-matching__ps { fill: none; stroke: currentColor; stroke-width: 2.5; stroke-dasharray: 8 5; }
</style>