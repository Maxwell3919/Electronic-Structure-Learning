---
interface Props {
  labelZh: string;
  labelEn: string;
}

const { labelZh, labelEn } = Astro.props;
---

<div
  class="soc-math-scroll"
  data-soc-math-scroll
  role="region"
  tabindex="0"
  aria-label={`${labelZh} / ${labelEn}`}
>
  <slot />
</div>

<style>
  .soc-math-scroll {
    display: block;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-inline: contain;
    -webkit-overflow-scrolling: touch;
  }

  .soc-math-scroll :global(.katex-display) {
    width: max-content;
    min-width: 100%;
    margin-block: 1em;
  }
</style>
