<figure class="chapter-visual ch04-dos" data-ch04-dos>
  <figcaption>
    <strong>原创交互模型：抛物带 DOS 的维度标度</strong>
    <span lang="en">Original interactive model: dimensional scaling of a parabolic-band DOS</span>
  </figcaption>

  <div class="chapter-visual__controls">
    <label>
      <span>空间维度 d | Dimension</span>
      <input type="range" min="1" max="3" step="1" value="2" data-ch04-dos-dimension />
      <output data-ch04-dos-dimension-output>2D</output>
    </label>
    <label>
      <span>数值 regularization η | Numerical regularization</span>
      <input type="range" min="0.02" max="0.20" step="0.01" value="0.05" data-ch04-dos-eta />
      <output data-ch04-dos-eta-output>0.05</output>
    </label>
  </div>

  <svg viewBox="0 0 820 390" role="img" aria-labelledby="ch04-dos-title ch04-dos-desc">
    <title id="ch04-dos-title">Parabolic density of states in one, two, and three dimensions</title>
    <desc id="ch04-dos-desc">The active curve follows a regularized form proportional to energy above the band edge raised to dimension over two minus one.</desc>
    <line x1="85" y1="325" x2="750" y2="325" class="plot-axis" />
    <line x1="85" y1="45" x2="85" y2="325" class="plot-axis" />
    <line x1="85" y1="45" x2="85" y2="325" class="plot-guide" />
    <text x="742" y="356">E−E₀</text>
    <text x="24" y="52">ρ(E)</text>
    <path d="M 88 55 C 110 115 150 195 250 245 C 390 300 570 314 750 318" class="plot-curve ch04-dos__reference" data-ch04-dos-reference="1" />
    <path d="M 85 205 L 750 205" class="plot-curve ch04-dos__reference" data-ch04-dos-reference="2" />
    <path d="M 85 325 C 220 300 430 220 750 70" class="plot-curve ch04-dos__reference" data-ch04-dos-reference="3" />
    <path d="M 85 205 L 750 205" class="plot-curve ch04-dos__active" data-ch04-dos-active />
    <text x="620" y="85" data-ch04-dos-label>2D: constant step</text>
  </svg>

  <div class="chapter-visual__readout" aria-live="polite" aria-atomic="true" data-ch04-live-contract="bilingual-atomic">
    <strong data-ch04-dos-law>ρ₂D(E) ∝ (E−E₀)⁰</strong>
    <span data-ch04-dos-edge>带边行为：有限常数台阶</span>
    <span lang="en" data-ch04-dos-edge-en>Band-edge behaviour: finite constant step</span>
    <span data-ch04-dos-note>η = 0.05 只对绘图曲线作数值正则化，不是材料寿命。</span>
    <span lang="en" data-ch04-dos-note-en>η = 0.05 only regularizes the plotted curve; it is not a material lifetime.</span>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>isotropic parabolic band 的形状为 <code>ρd(E) ∝ (E−E₀)^(d/2−1) Θ(E−E₀)</code>。</p>
    <p lang="en"><strong>Model:</strong> an isotropic parabolic band has <code>ρd(E) ∝ (E−E₀)^(d/2−1) Θ(E−E₀)</code>.</p>
    <p><strong>验收：</strong>1D 为 inverse-square-root edge、2D 为 constant step、3D 为 square-root onset。</p>
    <p lang="en"><strong>Acceptance:</strong> the edge is inverse-square-root in 1D, constant in 2D, and square-root in 3D.</p>
    <p><strong>边界：</strong>η 仅防止图形发散；模型不含 anisotropic mass、valley/spin degeneracy、nonparabolicity、finite temperature 或 lifetime self-energy。</p>
    <p lang="en"><strong>Boundary:</strong> eta only regularizes the drawing. Anisotropic masses, degeneracies, nonparabolicity, temperature, and lifetime self-energies are omitted.</p>
  </div>
</figure>

<script>
  import { sampleParabolicDOS } from '../lib/chapter04Models.mjs';

  document.querySelectorAll('[data-ch04-dos]').forEach((root) => {
    const dimensionInput = root.querySelector('[data-ch04-dos-dimension]');
    const etaInput = root.querySelector('[data-ch04-dos-eta]');
    const dimensionOutput = root.querySelector('[data-ch04-dos-dimension-output]');
    const etaOutput = root.querySelector('[data-ch04-dos-eta-output]');
    const activePath = root.querySelector('[data-ch04-dos-active]');
    const label = root.querySelector('[data-ch04-dos-label]');
    const law = root.querySelector('[data-ch04-dos-law]');
    const edge = root.querySelector('[data-ch04-dos-edge]');
    const edgeEn = root.querySelector('[data-ch04-dos-edge-en]');
    const note = root.querySelector('[data-ch04-dos-note]');
    const noteEn = root.querySelector('[data-ch04-dos-note-en]');
    const references = Array.from(root.querySelectorAll('[data-ch04-dos-reference]'));
    if (!(dimensionInput instanceof HTMLInputElement) || !(etaInput instanceof HTMLInputElement)) return;
    if (!(activePath instanceof SVGPathElement)) return;

    const xMap = (energy) => 85 + energy / 4 * 665;
    const yMap = (density, maximum) => 325 - Math.min(maximum, density) / maximum * 270;
    const descriptors = {
      1: {
        law: 'ρ₁D(E) ∝ (E−E₀)⁻¹ᐟ²',
        edgeZh: '带边行为：反平方根发散',
        edgeEn: 'Band-edge behaviour: inverse-square-root divergence',
        label: '1D: inverse-square-root edge',
      },
      2: {
        law: 'ρ₂D(E) ∝ (E−E₀)⁰',
        edgeZh: '带边行为：有限常数台阶',
        edgeEn: 'Band-edge behaviour: finite constant step',
        label: '2D: constant step',
      },
      3: {
        law: 'ρ₃D(E) ∝ (E−E₀)¹ᐟ²',
        edgeZh: '带边行为：平方根开启',
        edgeEn: 'Band-edge behaviour: square-root onset',
        label: '3D: square-root onset',
      },
    };

    const update = () => {
      const dimension = Number(dimensionInput.value);
      const eta = Number(etaInput.value);
      const samples = sampleParabolicDOS({ dimension, count: 181, eta });
      const maximum = Math.max(...samples.map((point) => point.density), 1);
      const d = samples.map((point, index) => `${index === 0 ? 'M' : 'L'} ${xMap(point.energy).toFixed(2)} ${yMap(point.density, maximum).toFixed(2)}`).join(' ');
      activePath.setAttribute('d', d);
      references.forEach((path) => {
        path.classList.toggle('ch04-dos__reference--active', Number(path.getAttribute('data-ch04-dos-reference')) === dimension);
      });
      if (dimensionOutput instanceof HTMLOutputElement) dimensionOutput.value = `${dimension}D`;
      if (etaOutput instanceof HTMLOutputElement) etaOutput.value = eta.toFixed(2);
      const descriptor = descriptors[dimension];
      if (law instanceof HTMLElement) law.textContent = descriptor.law;
      if (edge instanceof HTMLElement) edge.textContent = descriptor.edgeZh;
      if (edgeEn instanceof HTMLElement) edgeEn.textContent = descriptor.edgeEn;
      if (label instanceof SVGTextElement) label.textContent = descriptor.label;
      if (note instanceof HTMLElement) note.textContent = `η = ${eta.toFixed(2)} 只对绘图曲线作数值正则化，不是材料寿命。`;
      if (noteEn instanceof HTMLElement) noteEn.textContent = `η = ${eta.toFixed(2)} only regularizes the plotted curve; it is not a material lifetime.`;
    };

    dimensionInput.addEventListener('input', update);
    etaInput.addEventListener('input', update);
    update();
  });
</script>
