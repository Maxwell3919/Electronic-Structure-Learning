---
const milestones = [
  { year: 1896, zh: 'Zeeman 观察到磁场导致谱线分裂，Lorentz 用带电粒子运动解释。', en: 'Zeeman observed magnetic-field splitting of spectral lines; Lorentz interpreted it using moving charged particles.' },
  { year: 1897, zh: 'Thomson 的气体放电实验确立电子是带负电、质量很小的粒子。', en: 'Thomson’s gas-discharge experiments established the electron as a light, negatively charged particle.' },
  { year: 1911, zh: 'Rutherford 散射实验支持原子正电荷集中在小而重的原子核中。', en: 'Rutherford scattering supported a small, massive nucleus containing the positive charge.' },
  { year: 1913, zh: 'Bohr 用离散允许能级解释原子稳定性与光谱，模型本身随后被量子力学取代。', en: 'Bohr used discrete allowed levels to address atomic stability and spectra; quantum mechanics later replaced the model itself.' },
  { year: 1925, zh: 'Pauli 不相容原理和矩阵力学建立了多电子量子描述的关键约束。', en: 'The Pauli exclusion principle and matrix mechanics supplied key constraints for quantum descriptions of many electrons.' },
  { year: 1926, zh: 'Schrödinger 波动方程、Fermi–Dirac 统计以及交换反对称性的表述迅速成形。', en: 'The Schrödinger wave equation, Fermi–Dirac statistics, and exchange antisymmetry took their modern form.' },
  { year: 1928, zh: 'Bloch 阐明周期势中的电子态，为晶体能带理论奠定基础。', en: 'Bloch clarified electronic states in a periodic potential, establishing the basis of crystal band theory.' },
  { year: 1930, zh: 'Hartree–Fock 与两电子精确计算推动自洽场、反对称化和关联处理。', en: 'Hartree–Fock and accurate two-electron calculations advanced self-consistency, antisymmetrization, and correlation methods.' },
  { year: 1934, zh: 'Wigner–Seitz 与 Slater 对简单金属进行定量能量和能带计算。', en: 'Wigner–Seitz and Slater carried out quantitative energy and band calculations for simple metals.' },
  { year: 1964, zh: 'Hohenberg–Kohn 定理把基态问题表述为密度泛函理论。', en: 'The Hohenberg–Kohn theorem formulated the ground-state problem in terms of density functionals.' },
  { year: 1965, zh: 'Kohn–Sham 构造辅助独立粒子体系，使密度泛函理论成为可计算框架。', en: 'Kohn and Sham introduced an auxiliary independent-particle system, turning DFT into a practical computational framework.' },
];
---

<figure class="chapter-visual chapter-timeline" data-quantum-timeline>
  <figcaption>
    <strong>原创教学图：量子理论到可计算电子结构的时间线</strong>
    <span lang="en">Original teaching diagram: from quantum theory to computable electronic structure</span>
  </figcaption>

  <div class="chapter-visual__controls">
    <label>
      <span>显示截至年份 | Show events through</span>
      <input type="range" min="1896" max="1965" step="1" value="1935" data-timeline-year />
    </label>
    <output data-timeline-output>1935</output>
  </div>

  <ol class="chapter-timeline__list">
    {milestones.map((item) => (
      <li data-year={item.year}>
        <time datetime={String(item.year)}>{item.year}</time>
        <div>
          <p>{item.zh}</p>
          <p lang="en">{item.en}</p>
        </div>
      </li>
    ))}
  </ol>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>按年份组织的原创历史关系图；年份和人物关系以 Martin Chapter 1 的叙述为主要定位。</p>
    <p lang="en"><strong>Model:</strong> an original chronological map; dates and relationships are located primarily from Martin Chapter 1.</p>
    <p><strong>验收：</strong>滑块设为 1928 时，1964 与 1965 两项应隐藏；设为 1965 时全部显示。</p>
    <p lang="en"><strong>Acceptance:</strong> at 1928, the 1964 and 1965 entries are hidden; at 1965, every entry is visible.</p>
    <p><strong>边界：</strong>该图只显示本章主线节点，不能代替完整科学史，也不表示发现按单一路径线性发生。</p>
    <p lang="en"><strong>Boundary:</strong> this selective timeline is not a complete history and does not imply a single linear path of discovery.</p>
  </div>
</figure>

<script>
  document.querySelectorAll('[data-quantum-timeline]').forEach((root) => {
    const slider = root.querySelector('[data-timeline-year]');
    const output = root.querySelector('[data-timeline-output]');
    const items = root.querySelectorAll('[data-year]');
    if (!(slider instanceof HTMLInputElement) || !(output instanceof HTMLOutputElement)) return;

    const update = () => {
      const year = Number(slider.value);
      output.value = String(year);
      items.forEach((item) => {
        if (!(item instanceof HTMLElement)) return;
        item.hidden = Number(item.dataset.year) > year;
      });
    };

    slider.addEventListener('input', update);
    update();
  });
</script>
