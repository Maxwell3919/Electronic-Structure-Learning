---
import { kohnShamEnergyFromEigenvalueSum } from '../../../data/part02/ch07TeachingModels.mjs';

const initial = kohnShamEnergyFromEigenvalueSum({
  eigenvalueSum: -12,
  hartreeEnergy: 4,
  exchangeCorrelationEnergy: -2.2,
  exchangeCorrelationPotentialIntegral: -3,
  ionIonEnergy: 1.5,
});
---

<figure class="chapter-visual ks-energy" data-ks-energy>
  <figcaption>
    <strong>原创交互模型：本征值和中的双计数修正</strong>
    <span lang="en">Original interactive model: double-counting corrections to the eigenvalue sum</span>
  </figcaption>

  <div class="chapter-visual__controls">
    <label>
      <span>本征值和 Σfᵢεᵢ | Eigenvalue sum</span>
      <input type="range" min="-20" max="-4" step="0.1" value="-12" data-kse-es />
      <output data-kse-es-output>-12.0</output>
    </label>
    <label>
      <span>Hartree 能 EH | Hartree energy</span>
      <input type="range" min="0" max="8" step="0.1" value="4" data-kse-eh />
      <output data-kse-eh-output>4.0</output>
    </label>
    <label>
      <span>交换—关联能 Exc | Exchange–correlation energy</span>
      <input type="range" min="-6" max="0" step="0.1" value="-2.2" data-kse-exc />
      <output data-kse-exc-output>-2.2</output>
    </label>
    <label>
      <span>∫vxc n | Exchange–correlation potential integral</span>
      <input type="range" min="-7" max="1" step="0.1" value="-3" data-kse-vxc />
      <output data-kse-vxc-output>-3.0</output>
    </label>
  </div>

  <svg viewBox="0 0 760 310" role="img" aria-labelledby="kse-title kse-desc">
    <title id="kse-title">Algebraic Kohn–Sham eigenvalue-sum energy correction</title>
    <desc id="kse-desc">Bars show the eigenvalue sum, subtraction of the Hartree double count, the exchange–correlation correction, ion–ion energy, and the resulting total energy in model units.</desc>
    <line x1="60" y1="155" x2="730" y2="155" class="plot-axis" />
    <g data-kse-bars>
      <rect x="90" y="155" width="80" height="105" class="kse-bar kse-bar--negative" />
      <rect x="220" y="155" width="80" height="35" class="kse-bar kse-bar--negative" />
      <rect x="350" y="140" width="80" height="15" class="kse-bar kse-bar--positive" />
      <rect x="480" y="130" width="80" height="25" class="kse-bar kse-bar--positive" />
      <rect x="610" y="155" width="80" height="120" class="kse-bar kse-bar--total" />
    </g>
    <g class="kse-labels">
      <text x="130" y="292" text-anchor="middle">Σfᵢεᵢ</text>
      <text x="260" y="292" text-anchor="middle">−EH</text>
      <text x="390" y="292" text-anchor="middle">Exc−∫vxc n</text>
      <text x="520" y="292" text-anchor="middle">EII</text>
      <text x="650" y="292" text-anchor="middle">Etotal</text>
    </g>
  </svg>

  <div class="chapter-visual__readout" aria-live="polite">
    <span data-kse-hartree>Hartree correction = {initial.hartreeCorrection.toFixed(3)}</span>
    <span data-kse-xc>XC correction = {initial.exchangeCorrelationCorrection.toFixed(3)}</span>
    <strong data-kse-total>Total energy = {initial.totalEnergy.toFixed(3)} model units</strong>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>直接实现恒等式 Etotal = Σfᵢεᵢ − EH + Exc − ∫vxc n + EII。默认 EII = 1.5 模型能量单位；四个滑块控制其余输入。</p>
    <p lang="en"><strong>Model:</strong> the component implements Etotal = Σfᵢεᵢ − EH + Exc − ∫vxc n + EII directly. EII is fixed at 1.5 model energy units; four sliders control the remaining inputs.</p>
    <p><strong>验收：</strong>Hartree 修正必须等于 −EH；交换—关联修正必须等于 Exc − ∫vxc n；总能必须等于五项代数和。改变任意输入后读数和柱形图同步更新。</p>
    <p lang="en"><strong>Acceptance:</strong> the Hartree correction equals −EH, the exchange–correlation correction equals Exc − ∫vxc n, and the total equals the algebraic sum of all five terms. Readouts and bars update together.</p>
    <p><strong>边界：</strong>输入不是从自洽轨道计算得到，能量单位也不是 eV 或 Hartree。模型只验证双计数代数，不表示真实材料的能量分解或误差大小。</p>
    <p lang="en"><strong>Boundary:</strong> inputs are not generated from self-consistent orbitals and the units are neither eV nor Hartree. The model validates only the double-counting algebra, not a material energy decomposition or error estimate.</p>
  </div>
</figure>

<script>
  import { kohnShamEnergyFromEigenvalueSum } from '../../../data/part02/ch07TeachingModels.mjs';

  document.querySelectorAll('[data-ks-energy]').forEach((root) => {
    const es = root.querySelector('[data-kse-es]');
    const eh = root.querySelector('[data-kse-eh]');
    const exc = root.querySelector('[data-kse-exc]');
    const vxc = root.querySelector('[data-kse-vxc]');
    const outputs = {
      es: root.querySelector('[data-kse-es-output]'),
      eh: root.querySelector('[data-kse-eh-output]'),
      exc: root.querySelector('[data-kse-exc-output]'),
      vxc: root.querySelector('[data-kse-vxc-output]'),
      hartree: root.querySelector('[data-kse-hartree]'),
      xc: root.querySelector('[data-kse-xc]'),
      total: root.querySelector('[data-kse-total]'),
    };
    const bars = Array.from(root.querySelectorAll('[data-kse-bars] rect'));

    if (!(es instanceof HTMLInputElement) || !(eh instanceof HTMLInputElement)) return;
    if (!(exc instanceof HTMLInputElement) || !(vxc instanceof HTMLInputElement)) return;

    const setOutput = (element, value) => {
      if (element instanceof HTMLOutputElement) element.value = value;
      else if (element instanceof HTMLElement) element.textContent = value;
    };

    const barGeometry = (value) => {
      const scale = 7.2;
      const height = Math.min(130, Math.abs(value) * scale);
      return value >= 0 ? { y: 155 - height, height } : { y: 155, height };
    };

    const update = () => {
      const values = {
        eigenvalueSum: Number(es.value),
        hartreeEnergy: Number(eh.value),
        exchangeCorrelationEnergy: Number(exc.value),
        exchangeCorrelationPotentialIntegral: Number(vxc.value),
        ionIonEnergy: 1.5,
      };
      const result = kohnShamEnergyFromEigenvalueSum(values);
      setOutput(outputs.es, values.eigenvalueSum.toFixed(1));
      setOutput(outputs.eh, values.hartreeEnergy.toFixed(1));
      setOutput(outputs.exc, values.exchangeCorrelationEnergy.toFixed(1));
      setOutput(outputs.vxc, values.exchangeCorrelationPotentialIntegral.toFixed(1));
      setOutput(outputs.hartree, `Hartree correction = ${result.hartreeCorrection.toFixed(3)}`);
      setOutput(outputs.xc, `XC correction = ${result.exchangeCorrelationCorrection.toFixed(3)}`);
      setOutput(outputs.total, `Total energy = ${result.totalEnergy.toFixed(3)} model units`);

      const barValues = [
        result.eigenvalueSum,
        result.hartreeCorrection,
        result.exchangeCorrelationCorrection,
        result.ionIonEnergy,
        result.totalEnergy,
      ];
      bars.forEach((bar, index) => {
        if (!(bar instanceof SVGRectElement)) return;
        const geometry = barGeometry(barValues[index]);
        bar.setAttribute('y', geometry.y.toFixed(2));
        bar.setAttribute('height', geometry.height.toFixed(2));
      });
    };

    [es, eh, exc, vxc].forEach((control) => control.addEventListener('input', update));
    update();
  });
</script>

<style>
  .ks-energy svg { width: 100%; max-height: 23rem; }
  .ks-energy text { fill: currentColor; font-size: 14px; }
  .kse-bar { opacity: 0.82; }
  .kse-bar--negative { fill: var(--sl-color-text-accent); }
  .kse-bar--positive { fill: var(--sl-color-accent-high); }
  .kse-bar--total { fill: var(--sl-color-gray-3); stroke: currentColor; stroke-width: 1.5; }
</style>
