---
import { withBasePath } from '../../data/site/schema.mjs';

interface Entry { id: string; nameZh: string; nameEn: string; route?: string; responsibility?: string; resourceState?: string; }
interface Props { entries: Entry[]; emptyText?: string; }
const { entries, emptyText = '专项调研尚未完成；不以未经核验的条目填充。' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
{entries.length === 0 ? <p>{emptyText}</p> : <div class="atlas-catalog">
  {entries.map((entry) => <section id={entry.id.replace(/^[^:]+:/, '')} class="atlas-catalog__entry">
    <h2><a href={entry.route ? withBasePath(entry.route, base) : undefined}>{entry.nameZh} <span lang="en">{entry.nameEn}</span></a></h2>
    {entry.responsibility && <p>{entry.responsibility}</p>}
    {entry.resourceState === 'planned' && <p><small>资源状态：planned；等待逐条来源、推荐理由与许可核验。</small></p>}
  </section>)}
</div>}
<style>
  .atlas-catalog { display: grid; gap: 1rem; }
  .atlas-catalog__entry { border-block-start: 1px solid var(--sl-color-gray-5); padding-block-start: .7rem; }
  .atlas-catalog__entry h2 { margin-block: 0 .35rem; font-size: 1.2rem; }
  .atlas-catalog__entry h2 span { color: var(--sl-color-gray-2); font-size: .82em; font-weight: 500; }
</style>
