<figure class="chapter-visual ch03-avoided" data-ch03-avoided>
  <figcaption>
    <strong>原创交互模型：两能级 Born–Oppenheimer 避免交叉</strong>
    <span lang="en">Original interactive model: a two-level Born–Oppenheimer avoided crossing</span>
  </figcaption>

  <div class="chapter-visual__controls">
    <label>
      <span>慢坐标 R | Slow coordinate</span>
      <input type="range" min="-3" max="3" step="0.05" value="-1.2" data-ch03-position />
      <output data-ch03-position-output>-1.20</output>
    </label>
    <label>
      <span>电子态耦合 g | Electronic coupling</span>
      <input type="range" min="0" max="1.5" step="0.05" value="0.50" data-ch03-coupling />
      <output data-ch03-coupling-output>0.50</output>
    </label>
  </div>

  <svg viewBox="0 0 720 360" role="img" aria-labelledby="ch03-avoided-title ch03-avoided-desc" data-ch03-avoided-svg>
    <title id="ch03-avoided-title">Two coupled electronic energy surfaces</title>
    <desc id="ch03-avoided-desc">Two diabatic straight lines cross while coupled adiabatic surfaces repel, with markers at the selected nuclear coordinate.</desc>
    <line x1="70" y1="300" x2="660" y2="300" class="plot-axis" />
    <line x1="365" y1="35" x2="365" y2="315" class="plot-guide" />
    <text x="650" y="330">R</text>
    <text x="28" y="45">E</text>
    <path d="M 70 280 L 660 70" class="ch03-avoided__diabatic" />
    <path d="M 70 70 L 660 280" class="ch03-avoided__diabatic" />
    <path d="M 70 295 C 250 270 305 205 365 190 C 425 205 480 270 660 295" class="plot-curve" data-ch03-lower-curve />
    <path d="M 70 55 C 250 80 305 145 365 160 C 425 145 480 80 660 55" class="plot-curve ch03-avoided__upper" data-ch03-upper-curve />
    <line x1="247" y1="55" x2="247" y2="295" class="ch03-avoided__cursor" data-ch03-cursor />
    <circle cx="247" cy="253" r="7" data-ch03-lower-point />
    <circle cx="247" cy="97" r="7" data-ch03-upper-point />
  </svg>

  <div class="chapter-visual__readout" aria-live="polite" aria-atomic="true" data-ch03-avoided-status>
    <strong data-ch03-energies>E− = −1.30; E+ = 1.30; gap = 2.60</strong>
    <span data-ch03-force data-ch03-force-zh>低能绝热面力 = −0.92</span>
    <span lang="en" data-ch03-force-en>Lower-surface force = −0.92</span>
    <span data-ch03-weights data-ch03-weights-zh>低能态权重：|1⟩ 96.2%，|2⟩ 3.8%</span>
    <span lang="en" data-ch03-weights-en>Lower-state weights: |1⟩ 96.2%, |2⟩ 3.8%</span>
  </div>

  <div class="ch03-avoided__weights" aria-hidden="true">
    <span data-ch03-weight-one style="width: 96.2%">|1⟩</span>
    <span data-ch03-weight-two style="width: 3.8%">|2⟩</span>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong>无量纲二能级 Hamiltonian H(R) = [[R,g],[g,−R]]，绝热能量为 E±=±√(R²+g²)。</p>
    <p lang="en"><strong>Model:</strong> dimensionless two-level Hamiltonian H(R) = [[R,g],[g,−R]], with adiabatic energies E±=±√(R²+g²).</p>
    <p><strong>验收：</strong>R=0 时 gap=2g；g=0 时恢复真正交叉；远离交叉时低能态趋向单一 diabatic state。</p>
    <p lang="en"><strong>Acceptance:</strong> at R=0 the gap is 2g; at g=0 the crossing is exact; far from the crossing the lower state approaches one diabatic state.</p>
    <p><strong>边界：</strong>R 不是实际键长，g 不是材料耦合；模型不含核动能、Berry phase、多维锥形交叉、耗散或真实非绝热跃迁率。</p>
    <p lang="en"><strong>Boundary:</strong> R is not a real bond length and g is not material data. Nuclear kinetic energy, Berry phases, multidimensional conical intersections, dissipation, and transition rates are omitted.</p>
  </div>
</figure>

<script>
  import { twoLevelAdiabatic } from '../lib/chapter03Models.mjs';

  document.querySelectorAll('[data-ch03-avoided]').forEach((root) => {
    const positionInput = root.querySelector('[data-ch03-position]');
    const couplingInput = root.querySelector('[data-ch03-coupling]');
    const positionOutput = root.querySelector('[data-ch03-position-output]');
    const couplingOutput = root.querySelector('[data-ch03-coupling-output]');
    const lowerCurve = root.querySelector('[data-ch03-lower-curve]');
    const upperCurve = root.querySelector('[data-ch03-upper-curve]');
    const cursor = root.querySelector('[data-ch03-cursor]');
    const lowerPoint = root.querySelector('[data-ch03-lower-point]');
    const upperPoint = root.querySelector('[data-ch03-upper-point]');
    const energies = root.querySelector('[data-ch03-energies]');
    const forceZh = root.querySelector('[data-ch03-force-zh]');
    const forceEn = root.querySelector('[data-ch03-force-en]');
    const weightsZh = root.querySelector('[data-ch03-weights-zh]');
    const weightsEn = root.querySelector('[data-ch03-weights-en]');
    const weightOne = root.querySelector('[data-ch03-weight-one]');
    const weightTwo = root.querySelector('[data-ch03-weight-two]');
    if (!(positionInput instanceof HTMLInputElement) || !(couplingInput instanceof HTMLInputElement)) return;
    if (!(lowerCurve instanceof SVGPathElement) || !(upperCurve instanceof SVGPathElement)) return;
    if (!(cursor instanceof SVGLineElement) || !(lowerPoint instanceof SVGCircleElement) || !(upperPoint instanceof SVGCircleElement)) return;

    const xMap = (position) => 70 + (position + 3) / 6 * 590;
    const yMap = (energy) => 175 - energy / 3.4 * 125;

    const update = () => {
      const position = Number(positionInput.value);
      const coupling = Number(couplingInput.value);
      const selected = twoLevelAdiabatic(position, coupling);
      const samples = Array.from({ length: 121 }, (_, index) => {
        const coordinate = -3 + 6 * index / 120;
        return twoLevelAdiabatic(coordinate, coupling);
      });
      lowerCurve.setAttribute('d', samples.map((point, index) => `${index === 0 ? 'M' : 'L'} ${xMap(point.position).toFixed(2)} ${yMap(point.lowerEnergy).toFixed(2)}`).join(' '));
      upperCurve.setAttribute('d', samples.map((point, index) => `${index === 0 ? 'M' : 'L'} ${xMap(point.position).toFixed(2)} ${yMap(point.upperEnergy).toFixed(2)}`).join(' '));

      const x = xMap(position);
      cursor.setAttribute('x1', String(x));
      cursor.setAttribute('x2', String(x));
      lowerPoint.setAttribute('cx', String(x));
      lowerPoint.setAttribute('cy', String(yMap(selected.lowerEnergy)));
      upperPoint.setAttribute('cx', String(x));
      upperPoint.setAttribute('cy', String(yMap(selected.upperEnergy)));

      if (positionOutput instanceof HTMLOutputElement) positionOutput.value = position.toFixed(2);
      if (couplingOutput instanceof HTMLOutputElement) couplingOutput.value = coupling.toFixed(2);
      if (energies instanceof HTMLElement) energies.textContent = `E− = ${selected.lowerEnergy.toFixed(3)}; E+ = ${selected.upperEnergy.toFixed(3)}; gap = ${selected.gap.toFixed(3)}`;
      if (forceZh instanceof HTMLElement) forceZh.textContent = `低能绝热面力 = ${selected.lowerForce.toFixed(3)}`;
      if (forceEn instanceof HTMLElement) forceEn.textContent = `Lower-surface force = ${selected.lowerForce.toFixed(3)}`;
      const one = 100 * selected.lowerState1Weight;
      const two = 100 * selected.lowerState2Weight;
      if (weightsZh instanceof HTMLElement) weightsZh.textContent = `低能态权重：|1⟩ ${one.toFixed(1)}%，|2⟩ ${two.toFixed(1)}%`;
      if (weightsEn instanceof HTMLElement) weightsEn.textContent = `Lower-state weights: |1⟩ ${one.toFixed(1)}%, |2⟩ ${two.toFixed(1)}%`;
      if (weightOne instanceof HTMLElement) {
        weightOne.style.width = `${one}%`;
        weightOne.textContent = one >= 8 ? '|1⟩' : '';
      }
      if (weightTwo instanceof HTMLElement) {
        weightTwo.style.width = `${two}%`;
        weightTwo.textContent = two >= 8 ? '|2⟩' : '';
      }
    };

    positionInput.addEventListener('input', update);
    couplingInput.addEventListener('input', update);
    update();
  });
</script>
