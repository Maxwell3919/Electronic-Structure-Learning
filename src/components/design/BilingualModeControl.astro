<div class="esl-bilingual-control" data-bilingual-control aria-label="双语阅读模式 | Bilingual reading mode">
  <button class="esl-mode-button" type="button" data-bilingual-mode="parallel" aria-pressed="true">中英对照</button>
  <button class="esl-mode-button" type="button" data-bilingual-mode="zh" aria-pressed="false">中文优先</button>
  <button class="esl-mode-button" type="button" data-bilingual-mode="en" aria-pressed="false" lang="en">English</button>
</div>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const allowed = new Set(['parallel', 'zh', 'en']);
    let saved = 'parallel';
    try {
      const candidate = localStorage.getItem('esl-bilingual-mode');
      if (allowed.has(candidate)) saved = candidate;
    } catch {}
    root.dataset.eslBilingual = saved;

    const controls = [...document.querySelectorAll('[data-bilingual-control]')];
    controls.forEach((control, index) => {
      control.dataset.active = index === 0 ? 'true' : 'false';
      control.querySelectorAll('[data-bilingual-mode]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.bilingualMode === saved));
        if (button.dataset.bound === 'true') return;
        button.dataset.bound = 'true';
        button.addEventListener('click', () => {
          const mode = button.dataset.bilingualMode;
          if (!allowed.has(mode)) return;
          root.dataset.eslBilingual = mode;
          try { localStorage.setItem('esl-bilingual-mode', mode); } catch {}
          document.querySelectorAll('[data-bilingual-mode]').forEach((item) => {
            item.setAttribute('aria-pressed', String(item.dataset.bilingualMode === mode));
          });
        });
      });
    });
  })();
</script>
