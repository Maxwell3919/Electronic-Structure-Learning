---
interface Props {
  eyebrow?: string;
  titleZh: string;
  titleEn: string;
  descriptionZh: string;
  descriptionEn?: string;
  pageType?: 'home' | 'learning' | 'theory' | 'lab' | 'case' | 'reference';
}

const {
  eyebrow = 'Editorial Quantum Atlas',
  titleZh,
  titleEn,
  descriptionZh,
  descriptionEn,
  pageType = 'theory',
} = Astro.props;
---

<header class="esl-editorial-hero" data-page-type={pageType}>
  <div class="esl-editorial-hero__copy">
    <p class="esl-eyebrow">{eyebrow}</p>
    <h1>{titleZh}</h1>
    <p class="esl-title-en" lang="en">{titleEn}</p>
    <p class="esl-editorial-hero__lede">{descriptionZh}</p>
    {descriptionEn && <p class="esl-secondary" lang="en">{descriptionEn}</p>}
    <slot />
  </div>
  <svg class="esl-quantum-motif" data-motion="running" viewBox="0 0 560 420" role="img" aria-label="艺术化晶格、波函数与能带线条；不是材料计算数据">
    <title>原创量子科学意象</title>
    <g class="motif-grid">
      {Array.from({ length: 6 }, (_, row) =>
        Array.from({ length: 6 }, (_, column) => (
          <circle cx={90 + column * 72 + (row % 2) * 18} cy={48 + row * 66} r="3.5" />
        )),
      )}
    </g>
    <path class="motif-wave" d="M34 220 C90 130 142 310 202 220 S318 130 382 220 S480 300 540 206" />
    <path class="motif-band" d="M28 338 C120 276 174 288 252 324 S406 360 532 278" />
    <path class="motif-band" d="M30 370 C124 332 194 348 270 374 S420 390 530 332" opacity="0.5" />
  </svg>
</header>
