---
interface Props { eyebrow?: string; title: string; summary?: string; }
const { eyebrow = 'Reading', title, summary } = Astro.props;
---
<header class="esl-reading-header esl-reading-column">
  <p class="esl-eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  {summary && <p class="esl-reading-header__summary">{summary}</p>}
  <slot />
</header>
