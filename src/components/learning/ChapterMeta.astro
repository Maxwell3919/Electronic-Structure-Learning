---
interface Props {
  sourcePage: number;
  status?: '未开始' | '进行中' | '已完成';
  evidence?: string;
  visualization?: string;
}

const {
  sourcePage,
  status = '未开始',
  evidence = '仅建立章节骨架',
  visualization = '待设计',
} = Astro.props;
---

<dl class="chapter-meta" aria-label="章节元数据">
  <div>
    <dt>教材起始页</dt>
    <dd>{sourcePage}</dd>
  </div>
  <div>
    <dt>学习状态</dt>
    <dd>{status}</dd>
  </div>
  <div>
    <dt>当前证据范围</dt>
    <dd>{evidence}</dd>
  </div>
  <div>
    <dt>可视化</dt>
    <dd>{visualization}</dd>
  </div>
</dl>
