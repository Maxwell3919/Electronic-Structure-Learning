---
import ContentStatusBadge from '../site/ContentStatusBadge.astro';
import DependencyEdge from './DependencyEdge.astro';
import { withBasePath } from '../../data/site/schema.mjs';
const { unit, semantic, previous = null, paths = [], labs = [], cases = [], literatureCount = 0 } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<article class="esl-unit-tile" data-atlas-unit data-kind={unit.kind} data-structural-state={unit.status?.structuralState}>
  <p class="esl-eyebrow">{unit.kind === 'appendix' ? `Appendix ${unit.id}` : `Chapter ${unit.id}`}</p>
  <h3><a href={withBasePath(unit.route, base)}>{unit.title}</a></h3>
  <p>{semantic?.sourceTitleZh}</p>
  <div class="esl-unit-tile__status">
    <ContentStatusBadge value={unit.status.structuralState} dimension="structural" />
    <ContentStatusBadge value={unit.status.technicalState} dimension="technical" />
    <ContentStatusBadge value={unit.status.scientificReviewState} dimension="scientific-review" />
  </div>
  <DependencyEdge previous={previous} />
  <dl>
    <dt>学习路线</dt><dd>{paths.length ? paths.join('；') : '未登记'}</dd>
    <dt>Lab / Case</dt><dd>{labs.length + cases.length}</dd>
    <dt>文献层</dt><dd>{literatureCount ? `${literatureCount} 条` : '未登记'}</dd>
  </dl>
</article>
