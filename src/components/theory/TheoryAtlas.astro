---
import martin from '../../data/martin/index.mjs';
import sourceSemanticStatus from '../../data/site/sourceSemanticStatus.mjs';
import learningPaths from '../../data/site/learningPaths.mjs';
import labs from '../../data/site/labs.mjs';
import cases from '../../data/site/cases.mjs';
import literature from '../../data/literature/registry.mjs';
import { martinUnits } from '../../lib/unitCatalog.mjs';
import TopicFilter from './TopicFilter.astro';
import TheoryLegend from './TheoryLegend.astro';
import PartBand from './PartBand.astro';

const semanticsById = new Map(sourceSemanticStatus.map((item) => [item.unitId, item]));
const pathNamesByRoute = new Map();
for (const path of learningPaths) for (const milestone of path.milestones) {
  const route = milestone.href.endsWith('/') ? milestone.href : `${milestone.href}/`;
  pathNamesByRoute.set(route, [...(pathNamesByRoute.get(route) ?? []), path.titleZh]);
}
const collect = (items, field) => {
  const map = new Map();
  for (const item of items) for (const route of item[field] ?? []) map.set(route, [...(map.get(route) ?? []), item.id]);
  return map;
};
const labsByRoute = collect(labs, 'relatedTheory');
const casesByRoute = collect(cases, 'theoryLinks');
const literatureByUnit = new Map();
for (const entry of literature) for (const id of entry.relatedUnits) literatureByUnit.set(id, (literatureByUnit.get(id) ?? 0) + 1);
---
<section class="esl-theory-atlas esl-full-region" data-theory-atlas>
  <TopicFilter />
  <TheoryLegend />
  {martin.parts.map((part) => <PartBand
    part={part}
    units={martinUnits.filter((unit) => unit.part.number === part.number)}
    semanticsById={semanticsById}
    pathNamesByRoute={pathNamesByRoute}
    labsByRoute={labsByRoute}
    casesByRoute={casesByRoute}
    literatureByUnit={literatureByUnit}
  />)}
</section>
