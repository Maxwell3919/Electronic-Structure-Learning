<div class="esl-atlas-filter print:hidden" data-atlas-filter data-active="false" role="group" aria-label="图谱筛选 | Atlas filter">
  <button type="button" data-filter="all" aria-pressed="true">全部</button>
  <button type="button" data-filter="chapter" aria-pressed="false">Chapters</button>
  <button type="button" data-filter="appendix" aria-pressed="false">Appendices</button>
  <button type="button" data-filter="outline" aria-pressed="false">Outline</button>
</div>
<script is:inline>
  (() => {
    const control = document.querySelector('[data-atlas-filter]');
    if (!control) return;
    control.dataset.active = 'true';
    control.querySelectorAll('[data-filter]').forEach((button) => button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      document.querySelectorAll('[data-atlas-unit]').forEach((unit) => {
        unit.hidden = filter !== 'all' && unit.dataset.kind !== filter && unit.dataset.structuralState !== filter;
      });
      control.querySelectorAll('[data-filter]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    }));
  })();
</script>
