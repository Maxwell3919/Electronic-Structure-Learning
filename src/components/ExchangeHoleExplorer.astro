<figure class="chapter-visual ch05-hole" data-ch05-hole>
  <figcaption>
    <strong>原创交互模型：Fermi-sphere density matrix 与 exchange hole</strong>
    <span lang="en">Original interactive model: Fermi-sphere density matrix and exchange hole</span>
  </figcaption>

  <div class="chapter-visual__controls">
    <label>
      <span>scaled separation y = kF r</span>
      <input type="range" min="0" max="18" step="0.05" value="3.00" data-ch05-hole-y />
      <output data-ch05-hole-y-output>3.00</output>
    </label>
    <label>
      <span>plot range ymax</span>
      <input type="range" min="8" max="30" step="1" value="20" data-ch05-hole-range />
      <output data-ch05-hole-range-output>20</output>
    </label>
  </div>

  <svg viewBox="0 0 860 420" role="img" aria-labelledby="ch05-hole-title ch05-hole-desc">
    <title id="ch05-hole-title">Density-matrix kernel and same-spin exchange hole</title>
    <desc id="ch05-hole-desc">The density-matrix kernel oscillates about zero while the exchange-hole function remains negative and approaches zero.</desc>
    <line x1="85" y1="205" x2="790" y2="205" class="plot-axis" />
    <line x1="85" y1="45" x2="85" y2="365" class="plot-axis" />
    <text x="780" y="395">y = kF r</text>
    <text x="24" y="55">F(y), −F²</text>
    <path d="M 85 55 C 180 75 250 190 330 215 C 430 240 560 198 790 205" class="plot-curve ch05-hole__kernel" data-ch05-hole-kernel />
    <path d="M 85 355 C 180 320 250 230 330 212 C 430 205 560 205 790 205" class="plot-curve ch05-hole__exchange" data-ch05-hole-exchange />
    <line x1="202.5" y1="45" x2="202.5" y2="365" class="ch05-hole__cursor" data-ch05-hole-cursor />
    <circle cx="202.5" cy="198" r="7" data-ch05-hole-kernel-point />
    <circle cx="202.5" cy="210" r="7" data-ch05-hole-exchange-point />
    <text x="590" y="80">F(y)</text>
    <text x="590" y="330">−F(y)²</text>
  </svg>

  <div class="chapter-visual__readout" aria-live="polite">
    <strong data-ch05-hole-kernel-readout>F(3.00) = 0.3457</strong>
    <span data-ch05-hole-pair>g↑↑ = 0.8805; exchange hole = −0.1195</span>
    <span data-ch05-hole-sum-rule>radial charge: (2/3π)∫y²[−F²]dy = −1</span>
  </div>

  <div class="chapter-visual__contract">
    <p><strong>模型：</strong><code>F(y)=3(sin y−y cos y)/y³</code>，<code>g↑↑=1−F²</code>，same-spin hole 为 <code>−F²</code> in dimensionless form。</p>
    <p lang="en"><strong>Model:</strong> the kernel is the zero-temperature Fourier transform of a filled three-dimensional Fermi sphere.</p>
    <p><strong>验收：</strong><code>F(0)=1</code>、<code>g↑↑(0)=0</code>、hole always nonpositive，并满足 one-electron normalization。</p>
    <p lang="en"><strong>Acceptance:</strong> the origin, Pauli contact, sign, decay, and exchange-hole charge are checked independently.</p>
    <p><strong>边界：</strong>模型只有 exchange；无 opposite-spin Coulomb cusp、correlation hole、finite temperature、disorder 或 crystal anisotropy。</p>
    <p lang="en"><strong>Boundary:</strong> opposite-spin cusps, correlation, temperature, disorder, and crystal anisotropy are absent.</p>
  </div>
</figure>

<script>
  import { densityMatrixKernel, exchangeHoleDimensionless, sameSpinPairDistribution, sampleExchangeHole } from '../lib/chapter05Models.mjs';

  document.querySelectorAll('[data-ch05-hole]').forEach((root) => {
    const yInput = root.querySelector('[data-ch05-hole-y]');
    const rangeInput = root.querySelector('[data-ch05-hole-range]');
    const yOutput = root.querySelector('[data-ch05-hole-y-output]');
    const rangeOutput = root.querySelector('[data-ch05-hole-range-output]');
    const kernelPath = root.querySelector('[data-ch05-hole-kernel]');
    const exchangePath = root.querySelector('[data-ch05-hole-exchange]');
    const cursor = root.querySelector('[data-ch05-hole-cursor]');
    const kernelPoint = root.querySelector('[data-ch05-hole-kernel-point]');
    const exchangePoint = root.querySelector('[data-ch05-hole-exchange-point]');
    const kernelReadout = root.querySelector('[data-ch05-hole-kernel-readout]');
    const pairReadout = root.querySelector('[data-ch05-hole-pair]');
    if (!(yInput instanceof HTMLInputElement) || !(rangeInput instanceof HTMLInputElement)) return;
    if (!(kernelPath instanceof SVGPathElement) || !(exchangePath instanceof SVGPathElement)) return;
    if (!(cursor instanceof SVGLineElement) || !(kernelPoint instanceof SVGCircleElement) || !(exchangePoint instanceof SVGCircleElement)) return;

    const xMap = (y, maximumY) => 85 + y / maximumY * 705;
    const yMap = (value) => 205 - value * 150;

    const update = () => {
      const selectedY = Number(yInput.value);
      const maximumY = Number(rangeInput.value);
      const samples = sampleExchangeHole({ maximumY, count: 501 });
      kernelPath.setAttribute('d', samples.map((point, index) => `${index === 0 ? 'M' : 'L'} ${xMap(point.y, maximumY).toFixed(2)} ${yMap(point.kernel).toFixed(2)}`).join(' '));
      exchangePath.setAttribute('d', samples.map((point, index) => `${index === 0 ? 'M' : 'L'} ${xMap(point.y, maximumY).toFixed(2)} ${yMap(point.hole).toFixed(2)}`).join(' '));
      const visibleY = Math.min(selectedY, maximumY);
      const kernel = densityMatrixKernel(visibleY);
      const hole = exchangeHoleDimensionless(visibleY);
      const pair = sameSpinPairDistribution(visibleY);
      const x = xMap(visibleY, maximumY);
      cursor.setAttribute('x1', String(x));
      cursor.setAttribute('x2', String(x));
      kernelPoint.setAttribute('cx', String(x));
      kernelPoint.setAttribute('cy', String(yMap(kernel)));
      exchangePoint.setAttribute('cx', String(x));
      exchangePoint.setAttribute('cy', String(yMap(hole)));
      if (yOutput instanceof HTMLOutputElement) yOutput.value = selectedY.toFixed(2);
      if (rangeOutput instanceof HTMLOutputElement) rangeOutput.value = String(maximumY);
      if (kernelReadout instanceof HTMLElement) kernelReadout.textContent = `F(${visibleY.toFixed(2)}) = ${kernel.toFixed(4)}`;
      if (pairReadout instanceof HTMLElement) pairReadout.textContent = `g↑↑ = ${pair.toFixed(4)}; exchange hole = ${hole.toFixed(4)}`;
    };

    yInput.addEventListener('input', update);
    rangeInput.addEventListener('input', update);
    update();
  });
</script>
