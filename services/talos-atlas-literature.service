[Unit]
Description=Electronic Structure Atlas literature runtime (Talos loopback)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/talos/work/Electronic-Structure-Learning
Environment=ATLAS_LITERATURE_ROOT=/home/talos/work/Research-Workflow-Records
Environment=ATLAS_LITERATURE_PORT=8103
ExecStart=/home/talos/.nvm/versions/node/v25.8.2/bin/node /home/talos/work/Electronic-Structure-Learning/services/literature-runtime-server.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/home/talos/work/Electronic-Structure-Learning /home/talos/work/Research-Workflow-Records

[Install]
WantedBy=default.target
